use core::tensor::*
use core::math::{Float32, Nat}

emath custom <NormalizedProjection<B: Nat, T: Nat, D: Nat, O: Nat>> as tensor_program:
    inputs:
        x: Tensor<Float32, [B, T, D]>
        weight: Matrix<Float32, D, O>
        bias: Vector<Float32, O>

    outputs:
        y: Tensor<Float32, [B, T, O]>

    definitions:
        projected = einsum("btd,do->bto", x, weight) + bias
        norm[b, t] = sqrt(sum j in 0..O: projected[b, t, j]^2 + 1e-12f32)
        y[b, t, j] = projected[b, t, j] / norm[b, t]

    invariants:
        forall b in 0..B, t in 0..T:
            abs(sum j in 0..O: y[b, t, j]^2 - 1) <= 1e-5

    requests:
        evaluate <y>:
            produce rust.library

        differentiate <y>:
            wrt [x, weight, bias]
            strategy reverse

        optimize <y>:
            objective minimize allocations
            preserve semantics

    strategies:
        prefer [frankenjax::tensor_compile, standard::tensor_cpu]
        fallback interpreter

    compile:
        target rust
        layout row_major
        unresolved hybrid
