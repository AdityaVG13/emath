# dynamic-mass-spring: Phase 3 acceptance demo model (mass-spring).
#
# Lowering: crates/emath-adapter-rumoca lowers the equivalent structural
# model into a causal DAE plan (matching + tearing provenance) and executes
# a deterministic forward-Euler simulation through the runtime Outcome/
# Budget contract. The kind `dynamic-model` is documented by the custom-kind
# schema contract (`language/reference/custom-kinds-schema-and-lowering.md`); full-text
# parsing arrives with the lossless parser, until then
# the structural model is the producer API.
emath dynamic_model MassSpring:
    kinds:
        continuous time

    parameters:
        m: Float64          # kg
        c: Float64          # kg/s
        k: Float64          # kg/s^2

    state:
        x: Float64          # m
        v: Float64          # m/s

    initial:
        x = 1
        v = 0

    equations:
        der(x) = v
        m * der(v) = -c * v - k * x

    accepts:
        answer: structural-plan + simulation-trajectory
