# explicit-mass-spring: A2-admitted continuous model.
#
# Explicit form of the mass-spring ODE. The recorded mass-matrix spelling
# `m * der(v) = -c * v - k * x` is also admitted when `m` is a named scalar.
emath model MassSpring:
    inputs:
        m: Float64
        c: Float64
        k: Float64
    state:
        x: Float64
        v: Float64
    equations:
        der(x) = v
        der(v) = (-c * v - k * x) / m
