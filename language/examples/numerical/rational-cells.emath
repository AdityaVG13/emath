# Exact-rational cells: Rat is an exact
# i128/i128 rational, gcd-reduced with a positive denominator at every
# step -- never a rounded f64. The active authored authorities are
# std.capability.exact.rat, std.capability.exact.rat-add, and
# std.capability.exact.rat-normalize.
emath function probe:
    inputs:
        n: Int
    outputs:
        half: Rat
        reduced: Rat
        precise: Rat
    definitions:
        half = rat_add(rat(n, 3), rat(1, 6))
        reduced = rat_norm(rat(6, 4))
        precise = rat(1, 1000000000000000007)
    goals:
        evaluate <half>
        evaluate <reduced>
        evaluate <precise>
