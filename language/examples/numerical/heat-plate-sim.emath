# heat-plate-sim: 2D heat equation as a continuous model.
#
# The plate temperature u(r,c) evolves by du/dt = alpha * laplacian_2d(u, dx)
# with the 5-point stencil and clamped (insulated) edges. With Clamp
# boundaries the plate is insulated (no heat flux out), so the total heat
# sum(u) is conserved and an initial hot spot diffuses to its four
# neighbors. Phase 1 fixes dx = 1.0 (a literal constant); variable dx is
# not yet supported.
#
# Simulate with `emath simulate` (RK4). The explicit step is stable when
# dt <= dx^2 / (4 * alpha); dt = 0.01 is well within for alpha = 1.0,
# dx = 1.0. See tests/emath-sema/tests/model_ode.rs for the conservation
# and diffusion assertions.

emath model HeatPlate:
    inputs:
        alpha: Float64
    state:
        u: Matrix[3, 3]
    equations:
        der(u) = alpha * laplacian_2d(u, 1.0)
