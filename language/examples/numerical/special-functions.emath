# The authored special-function capsule keeps mathematical names and error
# policy outside Rust kernels. The live strict-f64 route exposes both the
# central value and its declared error bound; elliptic_pi remains refused.
emath function SpecialFunctionValues:
    inputs:
        n: Float64
    outputs:
        gamma_five: Float64
        beta_two_three: Float64
        gamma_bound: Float64

    definitions:
        gamma_five = gamma(n)
        beta_two_three = beta(2, 3)
        gamma_bound = gamma_error_bound(n)

    tests:
        example <known_values>:
            expect gamma_five == 24
            expect beta_two_three == 0.08333333333333333
            expect gamma_bound > 0
