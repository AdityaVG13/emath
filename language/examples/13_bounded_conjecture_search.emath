emath conjecture_search CounterexampleSearch<N: Nat>:
    generics:
        N: Nat

    inputs:
        bound: Positive<Nat>

    outputs:
        result: SearchResult<Witness>

    relations:
        conjecture = forall object in objects_up_to(bound): property(object)
        counterexample(witness) = object_valid(witness) and not property(witness)

    goals:
        search <witness>:
            where counterexample(witness)
            budget iterations = 10_000_000
            produce continuation

        verify <witness>:
            require deterministic-checker

    compile:
        target rust
        profile executable
        unresolved continuation
