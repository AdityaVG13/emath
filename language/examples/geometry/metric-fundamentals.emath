# Metric geometry fundamentals — runnable cross-section of
# `std.geometry.metric`: the squared-L2/L2 distance functions over
# Vector[3], the Cauchy-Schwarz inequality, and the metric axioms as
# executable witnesses.  ZERO CORE DELTA: ordinary user functions over
# the `norm`/`dot` builtins and the generic arithmetic surface.
# Exact-first: all pinned witnesses use integer-valued coordinates,
# so every difference, sum, and squared length is exactly-representable
# in strict f64; the only irrational pins are single correctly-rounded
# literals verified independently (sqrt(29), sqrt(14), sqrt(53)), and
# the scale-homogeneity partner holds exactly (sqrt(116) == 2 *
# sqrt(29) bit-for-bit in IEEE arithmetic).
# NAMED FENCE: L1/Manhattan and L-infinity/Chebyshev need componentwise
# `abs`/`max`.  Those calls ADMIT end-to-end in the strict-f64
# execution subset since emath-s9w1m + fpl60 (probed 2026-09-01 on
# language/examples/intro/clamp-distance-builtins.emath); the Lp
# instances are specified in the cell contract and enter with a cell
# revision, not an emitter change.
# Test shape: each test-bearing declaration observes exactly one
# evaluate target; inequalities are pinned as exact signed slacks
# (negative = strict, zero = equality case), never booleans.
package std.geometry

emath function l2_3:
    inputs:
        p: Vector[Float64]
        q: Vector[Float64]
    outputs:
        d: Float64
    definitions:
        d = norm([p[0] - q[0], p[1] - q[1], p[2] - q[2]])
    goals:
        evaluate <d>:
            produce rust.library

emath function l2_squared_3:
    inputs:
        p: Vector[Float64]
        q: Vector[Float64]
    outputs:
        d: Float64
    definitions:
        dx = p[0] - q[0]
        dy = p[1] - q[1]
        dz = p[2] - q[2]
        d = dx * dx + dy * dy + dz * dz
    goals:
        evaluate <d>:
            produce rust.library

emath function metric_distances_witness:
    inputs:
        px: Float64
    outputs:
        packed: Vector[Float64]
    definitions:
        p = [px, 2.0, 3.0]
        q = [4.0, 6.0, 1.0]
        packed = [l2_3(p, q), l2_squared_3(p, q), dot(p, q), l2_3(p, p)]
    goals:
        evaluate <packed>:
            produce rust.library
    tests:
        example <exact_distance_witness>:
            given px = 1.0
            expect packed == [5.385164807134504, 29.0, 19.0, 0.0]

emath function metric_triangle_witness:
    inputs:
        s: Vector[Float64]
    outputs:
        packed: Vector[Float64]
    definitions:
        p = [1.0, 2.0, 3.0]
        slack_l2 = l2_3(p, [0.0, 0.0, 0.0]) - (l2_3(p, [4.0, 6.0, 1.0]) + l2_3([4.0, 6.0, 1.0], [0.0, 0.0, 0.0]))
        eq_l2 = l2_3(s, [2.0, 2.0, 2.0]) - (l2_3(s, [1.0, 1.0, 1.0]) + l2_3([1.0, 1.0, 1.0], [2.0, 2.0, 2.0]))
        packed = [slack_l2, eq_l2]
    goals:
        evaluate <packed>:
            produce rust.library
    tests:
        example <triangle_inequality_slacks>:
            given s = [0.0, 0.0, 0.0]
            expect packed == [-8.923617309641081, 0.0]

emath function metric_cauchy_schwarz_witness:
    inputs:
        s: Float64
    outputs:
        packed: Vector[Float64]
    definitions:
        p_a = [1.0, 2.0, 3.0]
        p_b = [4.0, 6.0, 1.0]
        p_c = [1.0, 2.0, 3.0]
        p_d = [s, 2.0 * s, 3.0 * s]
        slack = dot(p_a, p_a) * dot(p_b, p_b) - dot(p_a, p_b) * dot(p_a, p_b)
        eq_slack = dot(p_c, p_c) * dot(p_d, p_d) - dot(p_c, p_d) * dot(p_c, p_d)
        packed = [slack, eq_slack]
    goals:
        evaluate <packed>:
            produce rust.library
    tests:
        example <cauchy_schwarz_slack_and_equality>:
            given s = 0.0
            expect packed == [381.0, 0.0]

emath function metric_homogeneity_witness:
    inputs:
        scale: Float64
    outputs:
        packed: Vector[Float64]
    definitions:
        p = [1.0, 2.0, 3.0]
        q = [4.0, 6.0, 1.0]
        sp_pt = [scale * p[0], scale * p[1], scale * p[2]]
        sq_pt = [scale * q[0], scale * q[1], scale * q[2]]
        sp_norm = norm([sp_pt[0] - sq_pt[0], sp_pt[1] - sq_pt[1], sp_pt[2] - sq_pt[2]])
        hom_diff = sp_norm - scale * l2_3(p, q)
        d_l2 = l2_3(p, p)
        d_sq = l2_squared_3(p, p)
        packed = [hom_diff, d_l2, d_sq]
    goals:
        evaluate <packed>:
            produce rust.library
    tests:
        example <homogeneity_and_identity>:
            given scale = 2.0
            expect packed == [0.0, 0.0, 0.0]
