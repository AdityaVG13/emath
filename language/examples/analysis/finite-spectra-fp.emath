# Exact matrix spectra over a finite field (discrete spectral theory).
#
# Cell contract: language/stdlib/cells/analysis/std-analysis-finite-spectra.md
#
# Carrier: integer entries of a square matrix, interpreted in F_p.
# Everything here is EXACT integer arithmetic reduced mod p -- no
# floats, no tolerances, no silent generalization beyond 2x2.
#
# Demo 1: A = [[2,1],[3,4]] over F_5.
#   tr = 6 == 1 (mod 5), det = 2*4 - 1*3 = 5 == 0 (mod 5)
#   chi(t) = t^2 - 6t + 5;  chi(0)=5==0, chi(1)=0  ->  spec = {0, 1}
#   (chi(2)=-3==2, chi(3)=-4==1, chi(4)=-3==2 mod 5: no other roots)
#   Eigenvector for lambda=1: v=(1,4); (A - 1*I) = [[1,1],[3,3]];
#   (A-I)v = (1+4, 3+12) = (5, 15) == (0,0) mod 5.
#   Invariants: tr == 0+1 == 1, det == 0*1 == 0 (mod 5). Both hold.
#
# Demo 2: swap matrix S = [[0,1],[1,0]] over F_5.
#   chi(t) = t^2 - 1 -> eigenvalues t with t^2 == 1 (mod 5): t = 1, 4.
#   Eigenvector for lambda=4 (i.e. -1): v=(1,4); S v = (4,1) == 4*(1,4) mod 5.
#
# Phase-1 test shape: each declaration carries ONE evaluate goal, and
# its test asserts only that goal; the numeric outputs stay visible in
# `emath eval` receipts but are folded into the aggregate Bool here.
emath function spectrum_fp5:
    inputs:
        p: Int
    outputs:
        tr: Int
        det: Int
        r0: Int
        r1: Int
        all_ok: Bool
    definitions:
        a00 = 2
        a01 = 1
        a10 = 3
        a11 = 4
        tr = int_rem(a00 + a11, p)
        det = int_rem(a00 * a11 - a01 * a10, p)
        # eigenvalue test: chi(lambda) == lambda^2 - tr*lambda + det == 0 (mod p)
        is_eigen0 = congruence(0 * 0 - tr * 0 + det, 0, p)
        is_eigen1 = congruence(1 * 1 - tr * 1 + det, 0, p)
        trace_invariant = congruence(tr, int_rem(0 + 1, p), p)
        det_invariant = congruence(det, int_rem(0 * 1, p), p)
        # eigenvector certificate for lambda = 1, v = (1, 4):
        # r = (A - I) v reduced mod p must be exactly zero
        r0 = int_rem((a00 - 1) * 1 + a01 * 4, p)
        r1 = int_rem(a10 * 1 + (a11 - 1) * 4, p)
        eigvec_ok = congruence(r0, 0, p) and congruence(r1, 0, p)
        all_ok = (is_eigen0 and is_eigen1 and trace_invariant
                  and det_invariant and eigvec_ok)
    goals:
        evaluate <all_ok>:
            produce rust.library
    tests:
        example <f5>:
            given p = 5
            expect all_ok == true

    compile:
        target rust
        profile library
        numeric strict-f64

emath function swap_spectrum_fp5:
    # S = [[0,1],[1,0]]: chi(t) = t^2 - 1 over F_p.
    # p = 5: eigenvalues 1 and -1 == 4; eigenvector of 4 is (1, 4).
    inputs:
        p: Int
    outputs:
        w0: Int
        w1: Int
        all_ok: Bool
    definitions:
        lam_plus = congruence(1 * 1 - 1, 0, p)
        lam_minus = congruence(4 * 4 - 1, 0, p)
        # certificate: S*(1,4) = (4,1) and 4*(1,4) = (4,16); equal mod p
        w0 = int_rem(0 * 1 + 1 * 4, p)
        w1 = int_rem(1 * 1 + 0 * 4, p)
        s0 = int_rem(4 * 1, p)
        s1 = int_rem(4 * 4, p)
        swap_ev_ok = congruence(w0, s0, p) and congruence(w1, s1, p)
        all_ok = lam_plus and lam_minus and swap_ev_ok
    goals:
        evaluate <all_ok>:
            produce rust.library
    tests:
        example <f5>:
            given p = 5
            expect all_ok == true

    compile:
        target rust
        profile library
        numeric strict-f64
