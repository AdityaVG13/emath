# Exact 4x4 block-triangular spectra over F_7.
#
# Cell contract: language/stdlib/cells/analysis/std-analysis-finite-spectra4.md
#
# A = [[2, 1, 5, 0], [1, 2, 0, 5], [0, 0, 3, 1], [0, 0, 0, 4]] over F_7
# = [[B, C], [0, D]] with B = [[2,1],[1,2]], D = [[3,1],[0,4]].
#
# Invariants (integer forms, reduced mod 7):
#   tr = 2+2+3+4 = 11 == 4
#   M2 = six principal 2x2 minors:
#        {01}: 2*2-1*1 = 3;  {02}: 2*3-5*0 = 6;  {03}: 2*4-0*0 = 8
#        {12}: 2*3-0*0 = 6;  {13}: 2*4-5*0 = 8;  {23}: 3*4-1*0 = 12
#        M2 = 43 == 1
#   M3 = four principal 3x3 determinants (Sarrus each):
#        drop 0: [[2,0,5],[0,3,1],[0,0,4]] = 24
#        drop 1: [[2,5,0],[0,3,1],[0,0,4]] = 24
#        drop 2: [[2,1,0],[1,2,5],[0,0,4]] = 12
#        drop 3: [[2,1,5],[1,2,0],[0,0,3]] = 9
#        M3 = 69 == 6
#   det = 2*24 - 1*12 + 5*0 - 0 = 36 == 1
#         (minor(0,2) = det[[1,2,5],[0,0,1],[0,0,4]] = 0 exactly)
#   chi(t) = t^4 - 11 t^3 + 43 t^2 - 69 t + 36
#          == t^4 + 3 t^3 + t^2 + t + 1 (mod 7)
#
# Root sweep over F_7 (lambda^4 + 3 lambda^3 + lambda^2 + lambda + 1):
#   0: 1;  1: 7==0 YES;  2: 47==5;  3: 175==0 YES;  4: 469==0 YES;
#   5: 1031==2;  6: 1987==6   ->  spec = {1, 3, 3, 4}
# Vieta: sum 11==4=tr; pairwise 1*3+1*3+1*4+3*3+3*4+3*4 = 3+3+4+9+12+12
#   = 43 == 1 = M2; triples 1*3*3+1*3*4+1*3*4+3*3*4 = 9+12+12+36 = 69
#   == 6 = M3; product 36 == 1 = det. All four hold exactly.
#
# Block factorization law: chi_B(t) = t^2-4t+3, chi_D(t) = t^2-7t+12;
#   chi_B * chi_D = t^4 - 11 t^3 + 43 t^2 - 69 t + 36 = chi_A(t).
#
# Eigenvector for lambda = 1: v = (1, 6, 0, 0);
#   A v = (2+6, 1+12, 0, 0) = (8, 13, 0, 0) == (1, 6, 0, 0) = 1 * v.
#
# Phase-1 test shape: ONE evaluate goal per declaration; tests assert
# only that goal.
emath function spectra4_fp7:
    inputs:
        p: Int
    outputs:
        tr: Int
        m2: Int
        m3: Int
        det: Int
        all_ok: Bool
    definitions:
        tr = int_rem(2 + 2 + 3 + 4, p)
        m2 = int_rem(3 + 6 + 8 + 6 + 8 + 12, p)
        m3 = int_rem(24 + 24 + 12 + 9, p)
        det = int_rem(2 * 24 - 1 * 12 + 5 * 0 - 0 * 12, p)
        # chi(lambda) = lambda^4 + 3 lambda^3 + lambda^2 + lambda + 1
        chi0 = int_rem(0 + 0 + 0 + 0 + 1, p)
        chi1 = int_rem(1 + 3 + 1 + 1 + 1, p)
        chi2 = int_rem(16 + 24 + 4 + 2 + 1, p)
        chi3 = int_rem(81 + 81 + 9 + 3 + 1, p)
        chi4 = int_rem(256 + 192 + 16 + 4 + 1, p)
        chi5 = int_rem(625 + 375 + 25 + 5 + 1, p)
        chi6 = int_rem(1296 + 648 + 36 + 6 + 1, p)
        spec = (congruence(chi1, 0, p) and congruence(chi3, 0, p)
                and congruence(chi4, 0, p))
        nonspec = (congruence(chi0, 1, p) and congruence(chi2, 5, p)
                   and congruence(chi5, 2, p) and congruence(chi6, 6, p))
        # block factorization: (t^2-4t+3)(t^2-7t+12) coefficients
        # t^3: -11; t^2: 28+15 = 43; t: -48-21 = -69; const: 36
        factor = (congruence(-tr, -11, p) and congruence(m2, 43, p)
                  and congruence(-m3, -69, p) and congruence(det, 36, p))
        vieta = (congruence(tr, 4, p) and congruence(m2, 1, p)
                 and congruence(m3, 6, p) and congruence(det, 1, p))
        all_ok = (spec and nonspec and factor and vieta
                  and congruence(tr, 4, p) and congruence(m2, 1, p)
                  and congruence(m3, 6, p) and congruence(det, 1, p))
    goals:
        evaluate <all_ok>:
            produce rust.library
    tests:
        example <f7>:
            given p = 7
            expect all_ok == true

    compile:
        target rust
        profile library
        numeric strict-f64

emath function spectra4_eigvec_fp7:
    # Eigenvector certificate for lambda = 1, v = (1, 6, 0, 0).
    inputs:
        p: Int
    outputs:
        av0: Int
        av1: Int
        av2: Int
        av3: Int
        eig_ok: Bool
    definitions:
        av0 = int_rem(2 * 1 + 1 * 6 + 5 * 0 + 0 * 0, p)
        av1 = int_rem(1 * 1 + 2 * 6 + 0 * 0 + 5 * 0, p)
        av2 = int_rem(0 * 1 + 0 * 6 + 3 * 0 + 1 * 0, p)
        av3 = int_rem(0 * 1 + 0 * 6 + 0 * 0 + 4 * 0, p)
        eig_ok = (congruence(av0, 1 * 1, p) and congruence(av1, 1 * 6, p)
                  and congruence(av2, 0, p) and congruence(av3, 0, p))
    goals:
        evaluate <eig_ok>:
            produce rust.library
    tests:
        example <f7>:
            given p = 7
            expect eig_ok == true

    compile:
        target rust
        profile library
        numeric strict-f64
