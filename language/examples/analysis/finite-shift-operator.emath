# Exact finite shift operator: spectra of the cyclic shift over F_p.
#
# Cell contract: language/stdlib/cells/analysis/std-analysis-finite-shift.md
#
# Operator: S = [[0,1,0],[0,0,1],[1,0,0]] on F_p^3 (indices mod 3).
#   S(x0,x1,x2) = (x1,x2,x0);  S^3 = I (order exactly 3).
#   charpoly: t^3 - 1 (permutation matrix).
# Demo field F_7 (3 | 6): cube roots of unity are {1, 2, 4} because
#   1^3=1, 2^3=8==1, 4^3=64==1 (mod 7) and 3,5,6 are not roots:
#   3^3=27==6, 5^3=125==6, 6^3=216==6 (mod 7).
# Eigenvector for lambda = 2: v = (1, 2, 4) (the Fourier mode g^j with
#   g=2): S v = (2, 4, 1) == 2 * (1, 2, 4) (mod 7).
#
# Phase-1 test shape: ONE evaluate goal per declaration; the aggregate
# Bool carries the assertions.
emath function shift3_spectrum_fp7:
    inputs:
        p: Int
    outputs:
        s0: Int
        s1: Int
        s2: Int
        all_ok: Bool
    definitions:
        # cube roots of unity in F_p, checked exactly
        r1 = congruence(pow_mod(1, 3, p), 1, p)
        r2 = congruence(pow_mod(2, 3, p), 1, p)
        r4 = congruence(pow_mod(4, 3, p), 1, p)
        n3 = congruence(pow_mod(3, 3, p), 6, p)
        n5 = congruence(pow_mod(5, 3, p), 6, p)
        n6 = congruence(pow_mod(6, 3, p), 6, p)
        # eigenvector certificate for lambda = 2, v = (1, 2, 4):
        # S v = (x1, x2, x0) = (2, 4, 1) and lambda v = (2, 4, 8)
        s0 = int_rem(0 * 1 + 1 * 2 + 0 * 4, p)
        s1 = int_rem(0 * 1 + 0 * 2 + 1 * 4, p)
        s2 = int_rem(1 * 1 + 0 * 2 + 0 * 4, p)
        m0 = int_rem(2 * 1, p)
        m1 = int_rem(2 * 2, p)
        m2 = int_rem(2 * 4, p)
        eig_ok = (congruence(s0, m0, p) and congruence(s1, m1, p)
                  and congruence(s2, m2, p))
        all_ok = (r1 and r2 and r4 and n3 and n5 and n6 and eig_ok)
    goals:
        evaluate <all_ok>:
            produce rust.library
    tests:
        example <f7>:
            given p = 7
            expect all_ok == true

    compile:
        target rust
        profile library
        numeric strict-f64
