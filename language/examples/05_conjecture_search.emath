use core::logic::*
use core::integer::*

emath conjecture_search FiniteCounterexampleSearch<Limit: Nat>:
    generics:
        Limit: Nat

    types:
        record Witness:
            a: Nat
            b: Nat
            c: Nat

    relations:
        predicate <candidate>(w: Witness):
            1 <= w.a <= Limit
            1 <= w.b <= Limit
            1 <= w.c <= Limit

        predicate <counterexample>(w: Witness):
            candidate(w)
            and w.a^2 + w.b^2 == w.c^2
            and gcd(w.a, w.b, w.c) == 1

    outputs:
        witness: Option<Witness>

    requests:
        search <witness>:
            find first w where counterexample(w)
            produce rust.binary
            continuation enabled

        verify <witness>:
            if Some(w): require exact-check
            if None: require exhaustive-domain-certificate

    strategies:
        prefer [modular_pruning, parallel_bounded_search]
        fallback exhaustive
