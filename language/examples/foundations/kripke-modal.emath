# Kripke frames and modal logic — finite relational model checking.
# (Wave-16 foundations lane: modal logic, Tier A constraint/search
# foundations angle.)
#
# A finite Kripke frame is a finite set of worlds W with an accessibility
# relation R, and a valuation V says where the atom p holds. Both are
# CAPABILITY DATA here: the frame is the function `edge_at` (1 when
# world a sees world b), the valuation is `p_at` (1 at worlds 2 and 3).
# The modalities are the relational folds over the enumerated world range:
#   □p at w  =  ∀ s: (¬R(w,s) ∨ p(s))      (empty R(w) ⇒ vacuously true)
#   ◇p at w  =  ∃ s: R(w,s) ∧ p(s)
# □◇p at a world is the nested fold. The duality law ¬◇p ≡ □¬p is
# computed over ALL worlds as a metamorphic check. Every verdict is a
# completed finite scan; the certificate is the enumeration itself.
# Not a proof assistant — only exhaustive finite scans with counts.
#
# Frame: worlds 0..3; edges 0→1, 1→2, 1→3, 2→0 (world 3 is a dead end).
#
# Run:
#   emath check language/examples/foundations/kripke-modal.emath
#   emath test  language/examples/foundations/kripke-modal.emath

use core::notation::logic

# Capability data: the accessibility relation R — 1 when world a sees
# world b (edges 0→1, 1→2, 1→3, 2→0; world 3 is a dead end). The pair
# code (a*4)+b packs the frame into a flat match over the 4x4 grid.
emath function edge_at:
    inputs:
        a: Int
        b: Int
    outputs:
        e: Int

    definitions:
        e = match ((a * 4) + b) { 1 => 1, 6 => 1, 7 => 1, 8 => 1, other => 0 }

# Capability data: the valuation V — p true at worlds 2 and 3.
emath function p_at:
    inputs:
        i: Int
    outputs:
        val: Int

    definitions:
        val = if ((i == 2) or (i == 3)): 1 else: 0

# Capability data: □p at world w — every world j with an edge from w
# satisfies p. Vacuous on dead-end worlds (empty R(w) → the empty ∀ fold
# is true): the documented fold identity, not a special case. The body is
# total for every enumerated cell, so the eager fold never faults.
emath function kripke_box_p:
    inputs:
        w: Int
    outputs:
        holds: Int

    definitions:
        holds = if (forall j in 0..4: ((edge_at(w, j) == 0) or (p_at(j) == 1))): 1 else: 0

# Capability data: ◇p at world w — some R-successor of w satisfies p.
emath function kripke_dia_p:
    inputs:
        w: Int
    outputs:
        holds: Int

    definitions:
        holds = if (exists j in 0..4: ((edge_at(w, j) == 1) and (p_at(j) == 1))): 1 else: 0

# Capability data: □¬p at world w — every successor REFUTES p (the
# duality-law counterpart of ◇p).
emath function kripke_box_not_p:
    inputs:
        w: Int
    outputs:
        holds: Int

    definitions:
        holds = if (forall j in 0..4: ((edge_at(w, j) == 0) or (p_at(j) == 0))): 1 else: 0

# Capability data: □◇p at world w — every successor s of w can reach a
# p-world (nested box-diamond over the same relation data).
emath function kripke_box_dia_p:
    inputs:
        w: Int
    outputs:
        holds: Int

    definitions:
        holds = if (forall j in 0..4: ((edge_at(w, j) == 0) or (kripke_dia_p(j) == 1))): 1 else: 0

emath function kripke_box_at_zero_demo:
    definitions:
        # □p at 0 is false: the sole successor 1 does not satisfy p.
        box_at_zero = kripke_box_p(0)

    tests:
        example <box_fails>:
            expect box_at_zero == 0

emath function kripke_dia_at_zero_demo:
    definitions:
        # ◇p at 0 is false: world 0 sees only world 1, and p is false there.
        dia_at_zero = kripke_dia_p(0)

    tests:
        example <dia_fails>:
            expect dia_at_zero == 0

emath function kripke_vacuous_box_demo:
    definitions:
        # Dead-end world: □p at world 3 is vacuously true (empty ∀ fold),
        # the documented fold identity — not a special case.
        vacuous_box_at_three = kripke_box_p(3)

    tests:
        example <vacuous_box>:
            expect vacuous_box_at_three == 1

emath function kripke_box_dia_zero_demo:
    definitions:
        # □◇p at 0: the only successor of 0 is world 1, and ◇p at 1 holds
        # (1 → 2, p true at 2) — so □◇p holds at world 0.
        box_dia_at_zero = kripke_box_dia_p(0)

    tests:
        example <box_dia>:
            expect box_dia_at_zero == 1

emath function kripke_duality_law:
    definitions:
        # Modal duality over the whole frame: for EVERY world,
        # dia(i) == 0 (¬◇p as an Int verdict) agrees with box_not_p(i) —
        # the sum of agreements equals the world count 4. Both sides are
        # total folds over the same relation.
        worlds_agree = sum i in 0..4: if ((kripke_dia_p(i) == 0) == (kripke_box_not_p(i) == 1)): 1 else: 0

    tests:
        example <duality_law>:
            expect worlds_agree == 4
