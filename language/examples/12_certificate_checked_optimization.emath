emath optimization CapacityPlan<N: Nat>:
    inputs:
        demand: Vector<NonNegative<Real>, N>
        cost: Vector<NonNegative<Real>, N>
        capacity: Vector<NonNegative<Real>, N>

    outputs:
        allocation: Vector<NonNegative<Real>, N>
        total_cost: Real

    constraints:
        forall i in 0..N: allocation[i] <= capacity[i]
        sum i in 0..N: allocation[i] >= sum i in 0..N: demand[i]

    objectives:
        minimize sum i in 0..N: cost[i] * allocation[i]

    requests:
        optimize <objectives>:
            subject_to constraints
            require certificate primal_dual
            require evidence >= E3

    strategies:
        allow providers matching LinearOptimizer
        fallback diagnostic
