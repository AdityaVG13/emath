use core::graph::*
use core::math::*
use core::units::{Token, Byte, Duration}

emath custom <CompressionPlanner<ArtifactCount: Nat>> as policy_system:
    types:
        record Artifact:
            id: ArtifactId
            raw_tokens: Token
            encoded_bytes: Byte
            reconstruction_tokens: Token
            reconstruction_latency: Duration
            reuse_probability: Probability
            dependency_ids: Sequence<ArtifactId>

        record Plan:
            selected: Set<ArtifactId>
            model_visible_tokens: Token
            expected_reconstruction_tokens: Token
            expected_latency: Duration
            certificate: RecoveryCertificate

    inputs:
        artifacts: Array<Artifact, ArtifactCount>
        request: RequestProfile
        token_budget: Token
        latency_budget: Duration

    outputs:
        plan: Plan

    functions:
        fn expected_cost(a: Artifact) -> Token:
            a.reuse_probability * a.reconstruction_tokens
            + (1 - a.reuse_probability) * a.raw_tokens

    constraints:
        plan.model_visible_tokens <= token_budget
        plan.expected_latency <= latency_budget
        dependency_closed(plan.selected, artifacts)
        recoverable(plan.selected, request)

    objectives:
        lexicographic:
            minimize plan.model_visible_tokens
            minimize plan.expected_reconstruction_tokens
            minimize plan.expected_latency
            maximize recovery_margin(plan)

    requests:
        optimize <plan>:
            produce rust.library
            require feasible-certificate
            continuation enabled

        verify <plan.certificate>:
            require checked-certificate

        benchmark <plan>:
            against host::baseline_planner
            measure [input_tokens, output_tokens, cache_hits, latency, recovery_failures]

    strategies:
        prefer [graphzero::dependency_planner, frankenscipy::mixed_integer, standard::branch_and_bound]
        fallback exploration

    compile:
        target rust
        unresolved hybrid
