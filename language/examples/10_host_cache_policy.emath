use core::units::*
use host::cache_core

emath policy AdaptiveCachePolicy:
    inputs:
        reuse_probability: Probability
        reconstruction_cost: Duration
        age: Duration
        bytes: Information

    outputs:
        score: Float64

    state:
        alpha: NonNegative<Float64>
        gamma: NonNegative<Per<Duration>>

    constructors:
        public fn new(alpha: Float64, gamma: Per<Duration>) -> Result<Self, ConfigError>:
            require alpha >= 0
            require gamma >= 0 / s

            Self:
                alpha = alpha
                gamma = gamma

    definitions:
        score = reuse_probability^state.alpha
            * (reconstruction_cost / 1 ms)
            * exp(-(state.gamma * age))
            / (1 + bytes / 1 MiB)

    requests:
        evaluate <score>:
            produce rust.library
        differentiate <score>:
            wrt [state.alpha, state.gamma]

    host:
        rust:
            implement cache_core::Policy for Self:
                method score = score

    benchmarks:
        benchmark <replay>:
            compare Self against cache_core::LruPolicy
            measure [hit_rate, p99_latency, memory, token_cost]
            fallback cache_core::LruPolicy
