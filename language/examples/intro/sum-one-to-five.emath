# Finite sum. `1..6` is half-open, so this is 1+2+3+4+5.
# `sum([1, 2, 3, 4, 5])` is the same fold over a known vector.
emath function SumOneToFive:
    outputs:
        total: Float64
        folded: Float64
    definitions:
        total = sum i in 1..6: i
        folded = sum([1, 2, 3, 4, 5])
    tests:
        example <fifteen>:
            expect total == 15 and folded == 15
