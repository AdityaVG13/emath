# Inclusive range 1..=n keeps the upper bound. product i in 1..=5: i
# folds 1*2*3*4*5 = 120. With Int output, the fold uses exact i64
# arithmetic — no floating-point rounding.
emath function Factorial:
    outputs:
        fac: Int

    definitions:
        fac = product i in 1..=5: i

    tests:
        example <five>:
            expect fac == 120
