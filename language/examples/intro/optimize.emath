# Optimization by Newton's method on the gradient.
# `minimize(expr) wrt var` / `maximize(expr) wrt var` return a point
# where ∇f ≈ 0 (a stationary point of the right curvature). Each step:
#   x_new = x_old - H^{-1} ∇f
# with ∇f from dual-number autodiff and H from a forward-difference of
# that gradient. Exhausting iterations, a vanished Hessian, or a
# stationary point of the wrong kind (a min when maximize was asked)
# is a refusal, not a silent non-optimum.
# Minimizing (x-3)^2 from x=0 reaches x=3 with gradient ~0.
# Maximizing -(x-2)^2 from x=0 reaches x=2 with gradient ~0.
emath function OptimizeDemo:
    inputs:
        x: Float64

    outputs:
        min_x: Float64
        max_x: Float64

    definitions:
        loss = (x - 3) * (x - 3)
        score = -(x - 2) * (x - 2)
        min_x = minimize(loss) wrt x
        max_x = maximize(score) wrt x

    goals:
        evaluate <min_x>:
            produce rust.library

    tests:
        example <from_zero>:
            given x = 0
            expect abs(min_x - 3) < 1e-6
            expect abs(max_x - 2) < 1e-6
