# Field<p> / GF<p> arithmetic and the universal exact-Euclidean remainder.#
# `Field<p>` / `GF<p>` are exact-integer prime-field types: the modulus is
# a type-level prime integer literal; values are exact i64 (a float
# definition in a `Field` output refuses `E-TYPE-012`). The active authored
# operation authorities are std.capability.exact.int-rem,
# std.capability.exact.field-inverse, std.capability.exact.pow-mod, and
# std.capability.exact.sqrt-mod. Field arithmetic is expressed as
# CAPABILITY-CELL DATA over the universal
# `int_rem` primitive (`int_rem(a, m)` = `a.rem_euclid(m)` on i64) and the
# exact modular inverse `field_inv(a, p)`. There is NO field-named parser
# branch or EmirOp in the compiler — the `field7_add` / `field7_mul` /
# `field7_inv` names below are user declarations composing generic ops.
#
# `field7_ops` composes the four component functions on a sample pair:
#   emath check language/examples/intro/field-mod-arithmetic.emath
#   emath eval  language/examples/intro/field-mod-arithmetic.emath \
#       --function field7_ops --set a=3 --set b=4
# Each `outputs:` value is a `Field<7>` element (exact, in 0..=6). The
# `field7_add` / `field7_mul` / `field7_inv`/`field7_rem` declarations take
# `Int` inputs and are the same capability-data forms proven by the
# Field-arithmetic test suites.

emath function field7_ops:
    inputs:
        a: Int
        b: Int
    outputs:
        add: Field<7>
        mul: Field<7>
        inv: Field<7>
        rem: Field<7>

    definitions:
        # With a=3, b=4: 3 + 4 = 7 ≡ 0 (mod 7); 3 * 4 = 12 ≡ 5;
        # 3^-1 ≡ 5; -1 mod 7 = 6. The definitions compose the four
        # component functions declared below, so the showcase runs
        # user-declared capability data end to end.
        add = field7_add(a, b)
        mul = field7_mul(a, b)
        inv = field7_inv(a)
        rem = field7_rem(-1, 7)

# Capability data: field7_add(a, b) = (a + b) mod 7.
emath function field7_add:
    inputs:
        a: Int
        b: Int
    outputs:
        c: Field<7>
    definitions:
        c = int_rem(a + b, 7)

# Capability data: field7_mul(a, b) = (a * b) mod 7.
emath function field7_mul:
    inputs:
        a: Int
        b: Int
    outputs:
        c: Field<7>
    definitions:
        c = int_rem(a * b, 7)

# Capability data: field7_inv(a) = a^-1 mod 7 (exact modular inverse).
emath function field7_inv:
    inputs:
        a: Int
    outputs:
        c: Field<7>
    definitions:
        c = field_inv(a, 7)

# int_rem sign law through the primitive directly.
emath function field7_rem:
    inputs:
        a: Int
        m: Int
    outputs:
        c: Int
    definitions:
        c = int_rem(a, m)

# Capability data: field7_pow(b, e) = b^e mod 7 via the universal
# pow_mod primitive (square-and-multiply over i128 intermediates; i64
# operands never overflow). E.g. 3^5 = 243 ≡ 5 (mod 7).
emath function field7_pow:
    inputs:
        b: Int
        e: Int
    outputs:
        c: Field<7>
    definitions:
        c = pow_mod(b, e, 7)

# Capability data: field7_sqrt(a) = sqrt(a) mod 7 via the Tonelli-Shanks
# sqrt_mod primitive (3² = 9 ≡ 2, so sqrt(2) = 3 in F₇; non-residues
# refuse typed instead of fabricating a root).
emath function field7_sqrt:
    inputs:
        a: Int
    outputs:
        c: Field<7>
    definitions:
        c = sqrt_mod(a, 7)

# Multi-binder fold over an n×m grid: the double sum desugars to nested
# single-binder folds (leftmost outermost), enumerating n·m cells — the
# shape the 9-deep MCA probe chains needed.
emath function field7_grid:
    inputs:
        n: Int
        m: Int
    outputs:
        c: Int
    definitions:
        c = sum i in 0..n, j in 0..m: 1
