# einsum: Einstein summation contraction (B08).
# `einsum("subscripts", A, B, ...)` is the honest canonical form.
# The subscript string defines input indices, arrow, and output indices.
# Contracted (summed) indices appear in inputs but not in the output.

emath function matmul(A: Matrix<Float64, 2, 2>, B: Matrix<Float64, 2, 2>) -> Matrix<Float64, 2, 2>:
    definitions:
        # Matrix multiply: C[i,j] = sum_k A[i,k] * B[k,j]
        C = einsum("ik,kj->ij", A, B)

emath function dot(a: Vector<Float64, 3>, b: Vector<Float64, 3>) -> Float64:
    definitions:
        # Dot product: sum_i a[i] * b[i]
        result = einsum("i,i->", a, b)

emath function transpose(M: Matrix<Float64, 2, 3>) -> Matrix<Float64, 3, 2>:
    definitions:
        # Transpose: swap axes
        Mt = einsum("ij->ji", M)
