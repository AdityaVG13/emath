# Fully implicit DAE: causalized residuals with an `algebraic:` section.
# REFUSED at `emath check` with E-KIND-017: residual unknowns are admitted
# and the runner Newton-solves them (`emath simulate` works), but Phase 1
# `rust.library` codegen for the coupled solve is not implemented, so the
# declaration refuses as a buildable crate instead of failing untyped.
# Same RC circuit as algebraic-dae.emath: q(t) = C*V*(1 - exp(-t/(R*C))),
# but the resistor law is written as a residual instead of a definition:
#   V - R*I - q/C == 0
# and the rate `der(q) = I` is solved along with it.
emath model CausalizedRC:
    inputs:
        V: Float64
        R: Float64
        C: Float64

    algebraic:
        I: Float64

    state:
        q: Float64

    equations:
        V - R * I - q / C == 0
        der(q) = I
