# Fully implicit DAE: causalized residuals with an `algebraic:` section.
# The residual unknowns are admitted, Newton-solved at each simulation
# step, and -- since rust.library codegen now contains the same causalized
# Newton solve -- the declaration builds a crate whose `step_euler` /
# `step_rk4` methods integrate it. After each step the algebraic current
# is re-solved at the new charge so V - R*I - q/C stays ~0 (a successful
# step does not return a point off the constraint).
# Same RC circuit as algebraic-dae.emath: q(t) = C*V*(1 - exp(-t/(R*C))),
# but the resistor law is written as a residual instead of a definition:
#   V - R*I - q/C == 0
# and the rate `der(q) = I` is solved along with it.
emath model CausalizedRC:
    inputs:
        V: Float64
        R: Float64
        C: Float64

    algebraic:
        I: Float64

    state:
        q: Float64

    equations:
        V - R * I - q / C == 0
        der(q) = I

    outputs:
        tau: Float64

    definitions:
        tau = R * C

    goals:
        evaluate <tau>:
            produce rust.library

    tests:
        example <tau_is_rc>:
            given I = 0.0
            given q = 0.0
            given V = 1.0
            given R = 2.0
            given C = 3.0
            expect tau == 6.0
