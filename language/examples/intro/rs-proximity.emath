(* Reed-Solomon proximity testing — computational exploration
   RS(n, k) over GF(p): minimum distance d = n - k + 1 (Singleton bound).
   A word w is δ-close to the code if it differs from some codeword
   in at most δ*n positions. This example tests the basic machinery. *)

emath function rs_proximity_test:
  (* RS(7, 3) over GF(7): f(x) = 1 + 2x + 3x^2
     Flip 2 positions of the codeword and measure distance. *)
  outputs:
    codeword: Vector[7]
    noisy: Vector[7]
    distance: Int
    is_close: Bool
  definitions:
    coeffs = [1, 2, 3]
    p = 7
    n = 7
    codeword = rs_encode(coeffs, n, p)
    (* Flip positions 1 and 3: [1,0,3,4,1,2,2] *)
    noisy = [1, 0, 3, 4, 1, 2, 2]
    distance = hamming_distance(codeword, noisy)
    (* δ = 2/7 ≈ 0.286 — within correction radius (d-1)/2 = 2 *)
    is_close = distance <= 2
  tests:
    expect distance == 2
    expect is_close == true

emath function rs_min_distance_check:
  (* Verify Singleton bound: two distinct degree-2 polys over GF(7)
     produce codewords that differ on >= n - k + 1 = 5 positions. *)
  outputs:
    dist: Int
    singleton_bound: Int
  definitions:
    f1 = [1, 2, 3]
    f2 = [2, 3, 1]
    p = 7
    n = 7
    cw1 = rs_encode(f1, n, p)
    cw2 = rs_encode(f2, n, p)
    dist = hamming_distance(cw1, cw2)
    singleton_bound = n - 3 + 1
  tests:
    expect singleton_bound == 5
    expect dist >= singleton_bound
