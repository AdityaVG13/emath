# Constrained optimization with a constraints: section.
# Minimize x^2 + y^2 subject to x + y >= 1.  The compiler
# automatically adds penalty terms to the objective, so the
# gradient descent optimizer respects the constraint.
# The unconstrained minimum is (0,0), but the constraint
# pushes the solution toward x + y = 1.
emath function ConstrainedOpt:
    inputs:
        x: Float64
        y: Float64

    outputs:
        opt_x: Float64

    constraints:
        x + y >= 1

    definitions:
        objective = x * x + y * y
        opt_x = minimize(objective) wrt x, y

    goals:
        evaluate <opt_x>:
            produce rust.library

    tests:
        example <demo>:
            given x = 0
            given y = 0
            expect abs(opt_x - 0.5) < 0.3
