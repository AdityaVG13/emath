# Constrained optimization with a constraints: section.
# Minimize x^2 + y^2 subject to x + y >= 1. The compiler adds a
# quadratic exterior penalty w * max(0, 1 - x - y)^2 with w = 1000
# to the objective; Newton then drives ∇L to 0. That equilibrium is
# x = y = w/(1+2w) ≈ 0.49975, so x + y ≈ 0.9995: the inequality is
# approached, not a hard feasible-set projection. The unconstrained
# minimum (0,0) is not returned.
emath function ConstrainedOpt:
    inputs:
        x: Float64
        y: Float64

    outputs:
        opt_x: Float64
        opt_y: Float64

    constraints:
        x + y >= 1

    definitions:
        objective = x * x + y * y
        opt_x = minimize(objective) wrt x, y
        opt_y = minimize(objective) wrt y, x

    goals:
        evaluate <opt_x>:
            produce rust.library

    tests:
        example <demo>:
            given x = 0
            given y = 0
            expect abs(opt_x - 0.5) < 0.01
            expect abs(opt_y - 0.5) < 0.01
            expect opt_x + opt_y >= 0.999
