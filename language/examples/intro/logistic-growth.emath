# Logistic growth model (population dynamics).
#   der(p) = r * p * (1 - p / K)
# where r is the growth rate and K is the carrying capacity.
# The population starts at p0 and approaches K asymptotically.
emath model LogisticGrowth:
    inputs:
        p0: Float64
        r: Float64
        K: Float64

    state:
        p: Float64

    equations:
        der(p) = r * p * (1 - p / K)
