# Complex number ergonomics (B14).
# `Complex` is an admitted numeric type. Complex literals use the `Ni`
# suffix (e.g., `2i`, `3.5i`) which desugars to `N * i` where `i` is
# the imaginary unit (a named constant resolved by sema).

emath model ComplexDemo:
    inputs:
        # Complex type admission
        z: Complex

        # Vector of complex numbers (gates quantum mechanics, signals)
        psi: Vector<Complex, [2]>

    definitions:
        # Complex literals: `2i` desugars to `2 * i`
        imag = 2i
        imag_float = 3.5i

        # Complex expression: `1 + 2i` parses as `1 + (2 * i)`
        w = 1 + 2i
