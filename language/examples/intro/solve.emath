# Root-finding with Newton's method.
# `solve(expr) wrt var` finds the value of input `var` that drives
# `expr` (the residual) to zero.  Each Newton step uses forward-mode
# autodiff to compute both f(x) and f'(x) in a single dual-number pass:
#   x_new = x_old - f(x) / f'(x)
# x^2 - 4 = 0 has two roots, ±2. Newton follows the basin of the
# initial guess: from x=1 this is +2, from x=-1 this is -2. A returned
# root is accepted only when |residual| is below tolerance (~1e-12).
emath function SolveRoot:
    inputs:
        x: Float64

    outputs:
        root: Float64

    definitions:
        residual = x * x - 4
        root = solve(residual) wrt x

    goals:
        evaluate <root>:
            produce rust.library

    tests:
        example <from_one>:
            given x = 1
            expect abs(root - 2) < 1e-9
            expect abs(root * root - 4) < 1e-12

        example <from_neg_one>:
            given x = -1
            expect abs(root + 2) < 1e-9
            expect abs(root * root - 4) < 1e-12
