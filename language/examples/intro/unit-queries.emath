# unit of / dimension of compile-time queries (04 section 1.4).
# Scientists sanity-check derivations by asking "what are the units?"
# emath makes this a compile-time first-class query.

emath function energy_check(m: Float64, c: Float64) -> Float64:
    definitions:
        # Compile-time unit query (parses today; evaluation pending)
        energy_units = unit of (m * c^2)
        energy_dim = dimension of (m * c^2)

emath model Rocket:
    inputs:
        thrust: Float64 in N

    goals:
        # Dimensional require statement
        require dimension of thrust == Force
