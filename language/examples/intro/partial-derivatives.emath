# Partial/total derivatives with held-fixed sets (04 section 2.2).
# `partial(T)` / `∂(T)` is partial; `total(T)` / `d(T)` is total.
# `holding` is part of the term's identity: different holding sets
# produce different terms.

emath function thermodynamics(T: Float64, p: Float64, V: Float64) -> Float64:
    definitions:
        # Partial derivative with explicit held-fixed set
        dH_dT = partial(H) wrt T holding p

        # Same expression, different held-fixed set — distinct term
        dH_dT_V = partial(H) wrt T holding V

        # Unicode form: ∂ is an alias for partial
        dS_dT = ∂(S) wrt T holding p

        # Total/material derivative
        dx_dt = total(x) wrt t

        # ASCII alternative for total: d(...)
        dv_dt = d(v) wrt t

        # Existing derivative keyword still works
        dy_dx = derivative(y) wrt x
