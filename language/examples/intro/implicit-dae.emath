# Implicit DAE: algebraic variable found via Newton's method at each step.
# The current I is not defined explicitly — it's the value that satisfies
# Kirchhoff's voltage law: V - R*I - q/C = 0.  The `solve` op uses
# Newton's method (with forward-mode autodiff for the derivative) to find
# I at each time step.  I is declared as an input (initial guess).
# Analytical: q(t) = C*V*(1 - exp(-t/(R*C))).
emath model ImplicitCircuit:
    inputs:
        V: Float64
        R: Float64
        C: Float64
        I: Float64

    state:
        q: Float64

    equations:
        I_solved = solve(V - R * I - q / C) wrt I
        der(q) = I_solved
