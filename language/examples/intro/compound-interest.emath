# Continuous compound interest: A = P * e^(r*t)
# With P=1000, r=0.05, t=10, the final amount is ~1648.72.
emath function CompoundInterest:
    inputs:
        principal: Float64
        rate: Float64
        time: Float64

    outputs:
        amount: Float64

    definitions:
        amount = principal * exp(rate * time)

    tests:
        example <savings>:
            given principal = 1000
            given rate = 0.05
            given time = 10
            expect abs(amount - 1648.7212707001282) < 0.01
