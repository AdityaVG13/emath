# Stage-2 big-integer modular arithmetic at the Curve25519 prime
# (emath-t63iz). The modulus p = 2^255 - 19 is far beyond the i64 Int
# range, so the modulus literal lowers to `ConstBigInt` and the six
# modular builtins dispatch to the big lane — exact arithmetic over
# |F| < 2^256, never an f64 approximation. Small operands stay on the
# i64 lane and promote exactly (the exact-Euclidean kernel), so the
# mixed-width calls below are the width-boundary proofs.
#
# Hand-checkable identities (derived independently of the code):
#   euler_symbol:  2^((p-1)/2) mod p = p-1 — 2 is a quadratic
#                  non-residue mod p by the supplementary law (p ≡ 5
#                  mod 8), so Euler's symbol is p-1, not 1.
#   half_inv:      inv(2, p) = (p+1)/2 — because 2·(p+1)/2 = p+1 ≡ 1.
#   residue_root:  sqrt_mod(4, p) = 2 (4 = 2²; the tie-break is
#                  min(2, p-2) = 2).
#   signed_rem:    int_rem(-5, p) = p-5 — the exact-Euclidean sign law
#                  across the width boundary.
#   codeword:      rs_encode of f(t) = 1 + 2t at x = 0,1,2 is 1, 3, 5.
#
# Commands:
#   emath eval language/examples/research/mersenne-field-p25519.emath \
#       --function euler_symbol --set a=2 --json
#   emath eval language/examples/research/mersenne-field-p25519.emath \
#       --function half_inv --set two=2 --json
#   emath eval language/examples/research/mersenne-field-p25519.emath \
#       --function residue_root --set four=4 --json
#   emath eval language/examples/research/mersenne-field-p25519.emath \
#       --function signed_rem --set k=-5 --json
#   emath eval language/examples/research/mersenne-field-p25519.emath \
#       --function codeword --set n=3 --json
#
# Cross-engine check (the compiled probe must match the interpreter
# byte-for-byte; the big kernels ride the SOURCE embed into the
# generated crate):
#   emath build language/examples/research/mersenne-field-p25519.emath \
#       --bin euler_symbol --out target/emath
#   target/emath-cargo/probe-*-release/euler_symbol --set a=2

emath function euler_symbol:
    inputs:
        a: Int
    outputs:
        e: BigInt
    definitions:
        e = pow_mod(a, 28948022309329048855892746252171976963317496166410141009864396001978282409974, 57896044618658097711785492504343953926634992332820282019728792003956564819949)

emath function half_inv:
    inputs:
        two: Int
    outputs:
        inv: BigInt
    definitions:
        inv = mod_inv(two, 57896044618658097711785492504343953926634992332820282019728792003956564819949)

emath function residue_root:
    inputs:
        four: Int
    outputs:
        root: BigInt
    definitions:
        root = sqrt_mod(four, 57896044618658097711785492504343953926634992332820282019728792003956564819949)

emath function signed_rem:
    inputs:
        k: Int
    outputs:
        r: BigInt
    definitions:
        r = int_rem(k, 57896044618658097711785492504343953926634992332820282019728792003956564819949)

emath function codeword:
    inputs:
        n: Int
    outputs:
        c: Vector<BigInt>
    definitions:
        c = rs_encode([1.0, 2.0], n, 57896044618658097711785492504343953926634992332820282019728792003956564819949)
