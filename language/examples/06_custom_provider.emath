use core::tensor::{Vector}
use core::math::{Float32, Probability, Nat}

emath interface SemanticSimilarity<D: Nat>:
    extern operator similarity(
        left: Vector<Float32, D>,
        right: Vector<Float32, D>,
    ) -> Probability

    laws:
        symmetric:
            forall a, b: similarity(a, b) == similarity(b, a)

        bounded:
            forall a, b: 0 <= similarity(a, b) <= 1

    provider:
        component "zerostack:semantic/similarity@1"
        rust trait semantic::SimilarityProvider<D>

    fallback:
        implementation <cosine>:
            normalize(dot(left, right))

emath function SimilarityGate<D: Nat>:
    inputs:
        provider: SemanticSimilarity<D>
        left: Vector<Float32, D>
        right: Vector<Float32, D>
        threshold: Probability

    outputs:
        admit: Bool

    definitions:
        admit = provider.similarity(left, right) >= threshold

    requests:
        evaluate <admit>:
            produce rust.library
