emath policy AffineScorer:
    inputs:
        x: Float64

    outputs:
        score: Float64

    state:
        scale: Float64
        bias: Float64

    constructors:
        public fn new(scale: Float64, bias: Float64) -> Result<Self, ConfigError>:
            require scale >= 0
            require is_finite(scale)
            require is_finite(bias)

            Self:
                scale = scale
                bias = bias

    definitions:
        score = state.scale * x + state.bias

    goals:
        evaluate <score>:
            produce rust.library

    exports:
        public constructor new
        public function score

    compile:
        target rust
        profile library
        numeric strict-f64
        safety forbid-unsafe
