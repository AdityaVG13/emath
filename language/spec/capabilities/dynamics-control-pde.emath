# Dynamics/control/PDE cutover. Only direct calls representable by the current
# immutable Value -> Value native ABI are capsule-active. Worldful simulation,
# callback-driven solves, and unsupported tensor/compound carriers are honest
# candidate holes and retain legacy dual-run authority.

emath feature TransferEvaluation:
    schema: "emath.feature-capsule"
    feature_id: "std.capability.control.transfer-eval"
    semantic_hash: "sha256:c3e9d053d49f19ebda7c586294523d693b3655745ed42724518efe2bab434c75"
    class: "capability"
    maturity: "stable"
    summary: "Evaluate an ascending-coefficient polynomial ratio away from poles"
    source: "language.reference.standard-library.control"
    surface: "transfer_eval(numerator, denominator, point)"
    semantics: "kernel=checked-polynomial-ratio;arity=3;inputs=Vector<Float64>,Vector<Float64>,Float64;output=Float64;diagnostic=E-CONTROL-001|E-CONTROL-002"
    exactness: "deterministic strict-f64 Horner ratio or typed pole refusal"
    effects: "pure"
    worlds: "std.world.dynamics.control"
    providers: "n/a(local-reference | checked ratio kernel)"
    artifacts: "value,diagnostic"
    reference: "authored"
    conformance: "positive:transfer-fixture;negative:pole-hit;mutation:coefficient-order"
    migration: "legacy-active-dual-run -> capsule-active;authority-receipt:control-cutover;rollback:scoped"
    authority_target: "capsule-active"
    presentation: "aliases=transfer_eval"
    agent: "owners=language/spec/capabilities/dynamics-control-pde.emath;hazards=pole,coefficient-order;checks=dynamics_capsule_cutover"
    projection: "semantics -> provided"
    projection: "reference -> generated"

