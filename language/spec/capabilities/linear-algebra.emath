    providers: "n/a(local-reference | generic dense-carrier kernel)"
    artifacts: "source,value,diagnostic"
    reference: "authored"
    conformance: "positive:vector_norm;negative:vector_norm_wrong_carrier;mutation:l1-instead-of-l2"
    migration: "legacy-active-dual-run -> capsule-active;authority-receipt:linear-capsule-cutover;rollback:scoped"
