# Honest family residue. These surfaces compute through legacy typed EMIR today,
# but their rank-polymorphic or variadic contracts cannot yet be represented by
# the fixed-arity native capability ABI without narrowing existing behavior.
emath feature TensorIndexing:
    schema: "emath.feature-capsule"
    feature_id: "std.capability.tensor.index"
    semantic_hash: "sha256:7a0db538840077948660cc8470329440db86883791e154d990437d1417156ce9"
    class: "capability"
    maturity: "proposed"
    summary: "Rank-polymorphic checked indexing remains a declared cutover hole"
    source: "language.reference.types.vectors-matrices"
    surface: "value[index, ...]"
    semantics: "hole(rank-polymorphic-arity | vector, matrix, and tensor indexing remain legacy-active)"
    exactness: "integer-valued in-bounds coordinates only"
    effects: "pure"
    worlds: "std.world.float64"
    providers: "n/a(no-fixed-signature-adapter | rank-polymorphic indexing has no fixed kernel signature)"
    artifacts: "source,diagnostic"
    reference: "authored"
    conformance: "positive:legacy-indexing;negative:bounds-and-fractional-index;mutation:n/a(hole)"
    migration: "legacy-active -> capsule-candidate;hole(rank-polymorphic-arity)"
    authority_target: "capsule-candidate"
    presentation: "aliases=none"
    agent: "owners=language/spec/capabilities/linear-algebra.emath;hazards=rank,bounds,layout;edits=capsule;checks=linear_capsule_cutover"
    projection: "runtime_adapter -> hole(rank-polymorphic-arity | vector, matrix, and tensor indexing require dependent rank contracts)"

