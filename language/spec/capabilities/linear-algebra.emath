    schema: "emath.feature-capsule"
    feature_id: "std.capability.linear.vector-norm"
    semantic_hash: "sha256:f52587c8393baad762c2d1538460e02149eee5cbc9839d3a3c273e8b19324370"
    class: "capability"
    maturity: "stable"
    summary: "Euclidean norm of a Float64 vector"
    source: "language.examples.linear-algebra.eigen-svd"
