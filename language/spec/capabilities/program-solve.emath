    class: "capability"
    maturity: "stable"
    summary: "Reverse-mode adjoint gradient of an authored Float64 program via a Wengert tape"
    source: "language.reference.expressions-equations-state-and-events"
    surface: "gradient(program, environment, var_indices)"
    semantics: "kernel=program-reverse-gradient;arity=3;inputs=Program,Vector<Float64>,Vector<Float64>;output=Vector<Float64>;diagnostic=E-TYPE-012"
    exactness: "deterministic strict-f64 Wengert-tape adjoints seeded 1.0 at the result; whole finite slot encodings, state-free programs, scalar results only; ops without an adjoint rule refuse typed"
    effects: "pure"
    worlds: "std.world.calculus"
    providers: "n/a(local-reference | program-carrier adjoint kernel)"
    artifacts: "value,diagnostic"
    reference: "authored"
    conformance: "positive:adjoint-matches-dual-tangent;negative:empty-or-out-of-range-slots;mutation:dropped-adjoint-seed"
    migration: "legacy-active-dual-run -> capsule-active;authority-receipt:program-calculus;rollback:scoped"
    authority_target: "capsule-active"
    presentation: "aliases=gradient_program"
    agent: "owners=language/spec/capabilities/program-solve.emath;hazards=slot-range,state-carry,non-scalar-result;checks=program_calculus_capsule_cutover"
