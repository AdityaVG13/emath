# Program-carrier calculus cutover. The two pure Value-ABI kernels below are
# the representable slice of the CalculusGoals hole (callable-expression-abi):
# composite Simpson integration and scalar Newton solving of authored
# reference programs over an explicit Float64 environment. Worldful goals
# (cancellation tokens, structured goal results, symbolic differentiation)
# remain the legacy dual-run authority of the solve/integral expression forms.

emath feature SimpsonIntegral:
    schema: "emath.feature-capsule"
    feature_id: "std.capability.calculus.simpson-integral"
    semantic_hash: "sha256:cf2dc5efbd4a1a8dda8d663986ea38e96284943b9fdec0ef49da0e543bc079f7"
    class: "capability"
    maturity: "stable"
    summary: "Composite Simpson integral of an authored Float64 body over an explicit environment"
    source: "language.reference.expressions-equations-state-and-events"
    surface: "integral(program, environment, start, end, steps, loop_var_index)"
    semantics: "kernel=checked-simpson-integral;arity=6;inputs=Program,Vector<Float64>,Float64,Float64,I64,I64;output=Float64;diagnostic=E-TYPE-012"
    exactness: "deterministic strict-f64 composite Simpson with positive even steps and loop-variable binding"
    effects: "pure"
    worlds: "std.world.calculus"
    providers: "n/a(local-reference | program integral kernel)"
    artifacts: "value,diagnostic"
    reference: "authored"
    conformance: "positive:simpson-identity;negative:odd-or-zero-steps;mutation:weight-parity"
    migration: "legacy-active-dual-run -> capsule-active;authority-receipt:program-solve-cutover;rollback:scoped"
    authority_target: "capsule-active"
    presentation: "aliases=integral_program"
    agent: "owners=language/spec/capabilities/program-solve.emath;hazards=step-parity,binding-index,nonfinite-bounds;checks=program_solve_capsule_cutover"
    projection: "semantics -> provided"
    projection: "reference -> generated"

emath feature ProgramForwardDifference:
    schema: "emath.feature-capsule"
    feature_id: "std.capability.calculus.forward-difference"
    semantic_hash: "sha256:2d66f6359265754f8f0db969186c15af3ad9e7c616ba0ea57e7f5480c3c1c118"
    class: "capability"
    maturity: "stable"
    summary: "Forward-mode tangent of an authored Float64 program via dual numbers"
    source: "language.reference.expressions-equations-state-and-events"
    surface: "differentiate(program, environment, var_index)"
    semantics: "kernel=program-forward-difference;arity=3;inputs=Program,Vector<Float64>,I64;output=Float64;diagnostic=E-TYPE-012"
    exactness: "deterministic strict-f64 dual evaluation with tangent seed 1.0 on the slot; state-carrying programs, non-scalar results, and ops without a dual rule refuse typed"
    effects: "pure"
    worlds: "std.world.calculus"
    providers: "n/a(local-reference | program-carrier dual kernel)"
    artifacts: "value,diagnostic"
    reference: "authored"
    conformance: "positive:dual-tangent-matches-closed-form;negative:invalid-slot-or-carrier;mutation:dropped-chain-rule"
    migration: "legacy-active-dual-run -> capsule-active;authority-receipt:program-calculus;rollback:scoped"
    authority_target: "capsule-active"
    presentation: "aliases=differentiate_program"
    agent: "owners=language/spec/capabilities/program-solve.emath;hazards=slot-range,state-carry,non-scalar-result;checks=program_calculus_capsule_cutover"
    edge: "requires_world -> std.world.calculus"
    projection: "semantics -> provided"
    projection: "reference -> generated"

