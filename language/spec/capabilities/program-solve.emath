    feature_id: "std.capability.calculus.scalar-solve"
    semantic_hash: "sha256:ab604a88dfb60a659add2a7cc8acab1391df9f3c43d8a61ed85672df7bad9fe9"
    class: "capability"
    maturity: "stable"
    summary: "Scalar Newton root solve of an authored Float64 body with typed convergence laws"
    source: "language.reference.expressions-equations-state-and-events"
    surface: "solve(program, environment, var_index, tolerance, max_iter)"
    semantics: "kernel=checked-newton-scalar-solve;arity=5;inputs=Program,Vector<Float64>,I64,Float64,I64;output=Float64;diagnostic=E-TYPE-012"
    exactness: "deterministic strict-f64 Newton with forward-difference derivative; converged residual or typed refusal, never a fabricated root"
    effects: "pure"
    worlds: "std.world.calculus"
    providers: "n/a(local-reference | newton solve kernel)"
    artifacts: "value,diagnostic"
    reference: "authored"
    conformance: "positive:newton-basin;negative:zero-budget-vanished-derivative;mutation:tolerance-comparison"
    migration: "legacy-active-dual-run -> capsule-active;authority-receipt:program-solve-cutover;rollback:scoped"
    authority_target: "capsule-active"
    presentation: "aliases=solve_program"
    agent: "owners=language/spec/capabilities/program-solve.emath;hazards=vanishing-derivative,nonfinite-iterate,budget;checks=program_solve_capsule_cutover"
    projection: "semantics -> provided"
    projection: "reference -> generated"
