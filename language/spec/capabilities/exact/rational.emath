# Authored exact-rational authority. The VM owns only carrier representation and
# the domain-neutral ratio kernels named below.
emath feature RationalConstructor:
    schema: "emath.feature-capsule"
    feature_id: "std.capability.exact.rat"
    semantic_hash: "sha256:6c9cd3b3d99351b74b02a5da1c1f7d13cc0fcfde3ebc710882fafcceb4291ce5"
    class: "capability"
    maturity: "stable"
    summary: "Construct a canonical exact rational from two integers"
    source: "language.reference.types.exact-rationals"
    surface: "rat(numerator, denominator)"
    semantics: "kernel=normalize-ratio;arity=2;inputs=Int,Int;output=Rat;diagnostic=E-RAT-001"
    exactness: "exact i128 numerator and positive gcd-reduced i128 denominator, or diagnosed"
    effects: "pure"
    worlds: "std.world.exact.int"
    providers: "n/a(local-reference | generic exact-ratio kernel)"
    artifacts: "source,value,diagnostic"
    reference: "authored"
    conformance: "positive:rat_large_denominator_stays_exact;negative:rat_zero_denominator_refused;mutation:zero-denominator-admitted"
    migration: "legacy-active-dual-run -> capsule-active;authority-receipt:rat-cells;rollback:scoped"
    authority_target: "capsule-active"
    presentation: "aliases=rat"
    agent: "owners=language/spec/capabilities/exact/rational.emath;prerequisites=std.type.int,std.type.rat;hazards=zero-denominator,i128-overflow;edits=capsule,conformance;checks=rat_cells"
    edge: "depends_on -> std.type.int"
    edge: "requires_world -> std.world.exact.int"
    projection: "semantics -> provided"
    projection: "reference -> generated"

emath feature RationalAddition:
    schema: "emath.feature-capsule"
    feature_id: "std.capability.exact.rat-add"
    semantic_hash: "sha256:fe187a43b56d41dd08b71fbc9ebe19c431f04b94e800c480314c08420c0caec3"
    class: "capability"
    maturity: "stable"
    summary: "Add two exact rationals and return canonical form"
    source: "language.reference.types.exact-rationals"
    surface: "rat_add(left, right)"
    semantics: "kernel=add-ratios;arity=2;inputs=Rat,Rat;output=Rat;diagnostic=exact-overflow"
    exactness: "exact gcd-reduced result, or diagnosed i128 overflow"
    effects: "pure"
    worlds: "std.world.exact.int"
    providers: "n/a(local-reference | generic exact-ratio kernel)"
    artifacts: "source,value,diagnostic"
    reference: "authored"
    conformance: "positive:rat_add_exact_halves;negative:rat_add_wrong_carrier;mutation:rounded-half"
    migration: "legacy-active-dual-run -> capsule-active;authority-receipt:rat-cells;rollback:scoped"
    authority_target: "capsule-active"
    presentation: "aliases=rat_add"
    agent: "owners=language/spec/capabilities/exact/rational.emath;prerequisites=std.capability.exact.rat;hazards=cross-product-overflow;edits=capsule,conformance;checks=rat_cells"
    edge: "depends_on -> std.capability.exact.rat"
    edge: "requires_world -> std.world.exact.int"
    projection: "semantics -> provided"
    projection: "reference -> generated"

emath feature RationalNormalize:
    schema: "emath.feature-capsule"
    feature_id: "std.capability.exact.rat-normalize"
    semantic_hash: "sha256:ddef301862239823a8bfa961660ff2f76fcada3123f1df63870a49e24ddce23f"
    class: "capability"
    maturity: "stable"
    summary: "Reassert canonical sign and gcd form for an exact rational"
    source: "language.reference.types.exact-rationals"
    surface: "rat_norm(value)"
    semantics: "kernel=normalize-ratio;arity=1;inputs=Rat;output=Rat;diagnostic=exact-overflow"
    exactness: "exact positive-denominator gcd-reduced result, or diagnosed"
    effects: "pure"
    worlds: "std.world.exact.int"
    providers: "n/a(local-reference | generic exact-ratio kernel)"
    artifacts: "source,value,diagnostic"
    reference: "authored"
    conformance: "positive:rat_norm_gcd_reduces_and_canonicalizes_sign;negative:rat_norm_wrong_carrier;mutation:unreduced-result"
    migration: "legacy-active-dual-run -> capsule-active;authority-receipt:rat-cells;rollback:scoped"
    authority_target: "capsule-active"
    presentation: "aliases=rat_norm"
    agent: "owners=language/spec/capabilities/exact/rational.emath;prerequisites=std.type.rat;hazards=sign-canonicalization;edits=capsule,conformance;checks=rat_cells"
    edge: "depends_on -> std.capability.exact.rat"
    edge: "requires_world -> std.world.exact.int"
    projection: "semantics -> provided"
    projection: "reference -> generated"
