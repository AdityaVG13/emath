# Authored exact-integer, modular, and finite-field authority. Kernel names are
# deliberately domain-neutral machine operations; mathematical names live here.
emath feature Factorial:
    schema: "emath.feature-capsule"
    feature_id: "std.capability.exact.factorial"
    semantic_hash: "sha256:e70e54cc15d3ad1834ed82504d8930eaba970ac00f2a1c24e027ed6f5bb2e473"
    class: "capability"
    maturity: "stable"
    summary: "Checked factorial on the admitted i64 exact-integer lane"
    source: "language.reference.types.modular-arithmetic"
    surface: "factorial(n)"
    semantics: "kernel=bounded-product;arity=1;inputs=Int;output=Int;diagnostic=factorial-domain"
    exactness: "exact for 0 <= n <= 20; otherwise diagnosed"
    effects: "pure"
    worlds: "std.world.exact.int"
    providers: "n/a(local-reference | generic bounded-product kernel)"
    artifacts: "source,value,diagnostic"
    reference: "authored"
    conformance: "positive:factorial_edges;negative:factorial_out_of_i64_range;mutation:zero-identity"
    migration: "legacy-active-dual-run -> capsule-active;authority-receipt:factorial-kernel;rollback:scoped"
    authority_target: "capsule-active"
    presentation: "aliases=factorial,core::math::factorial"
    agent: "owners=language/spec/capabilities/exact/number-theory.emath;prerequisites=std.type.int;hazards=domain,overflow;edits=capsule,conformance;checks=kernels,congruence-wilson"
    edge: "requires_world -> std.world.exact.int"
    projection: "semantics -> provided"
    projection: "reference -> generated"

