# Domain-science authority. Mathematical names, carrier refinements, units,
# shapes, and diagnostics live in these capsules. Rust exposes only the
# domain-neutral numeric operations named by each `kernel` field.

emath feature InnerProduct:
    schema: "emath.feature-capsule"
    feature_id: "std.capability.geometry.inner-product"
    semantic_hash: "sha256:43d60162f3585e93c11fe722f459bc4e81231466e91899c6e7ec6c05e5fd91c0"
    class: "capability"
    maturity: "stable"
    summary: "Inner product of equal-length real coordinate vectors"
    source: "language.reference.geometry.inner-product"
    surface: "inner(left, right)"
    semantics: "kernel=pairwise-sum-products;arity=2;inputs=Vector,Vector;output=Float64;shape=left.length == right.length;units=left.unit * right.unit;diagnostic=E-SHAPE-001"
    exactness: "strict-f64 finite operands and result, or diagnosed"
    effects: "pure"
    worlds: "std.world.real"
    providers: "n/a(local-reference | generic pairwise reduction kernel)"
    artifacts: "source,value,diagnostic"
    reference: "authored"
    conformance: "positive:inner_equal_shape;negative:inner_shape_mismatch;mutation:zip_truncates"
    migration: "legacy-active-dual-run -> capsule-active;authority-receipt:domain-science;rollback:scoped"
    authority_target: "capsule-active"
    presentation: "aliases=inner,dot"
    agent: "owners=language/spec/capabilities/domain-science.emath;prerequisites=std.type.vector;hazards=shape-mismatch,non-finite;edits=capsule,kernel,conformance;checks=domain_science_capsule_cutover"
    projection: "semantics -> provided"
    projection: "reference -> generated"

