# Shipped seed worlds. These names summarize existing execution substrates;
# capability support is bounded by each manifest and never implied by membership.

emath feature ExactArithmeticWorld:
    schema: "emath.feature-capsule"
    feature_id: "std.world.default.exact_arithmetic"
    class: "world"
    semantic_hash: "sha256:8289da43fe79d3a3bb7aa3e644dc2a1da7d2ad750b132724ac4201d823973e0b"
    maturity: "proposed"
    summary: "Exact integers, rationals, and finite-field values."
    source: "worlds-catalog-exact-arithmetic"
    surface: "Int,Rat,GF"
    semantics: "representations=Int|Rat|GF(p);capabilities=arithmetic,comparison,finite-inverse;strategy=reference-vm then optional native specialization;evidence=exact result or typed domain refusal"
    exactness: "exact"
    effects: "pure"
    worlds: "self"
    providers: "reference-vm"
    artifacts: "world-result,value,diagnostic"
    reference: "authored"
    conformance: "positive:add-exact;negative:division-by-zero;mutation:wrong-result"
    migration: "legacy-active -> capsule-candidate"
    authority_target: "capsule-candidate"
    presentation: "exact arithmetic"
    agent: "owners=language/spec/worlds/default-worlds.emath;hazards=catalog-as-support"
    edge: "depends_on -> std.constitution.language"

