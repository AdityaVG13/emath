# Catalog accounting capsules. Every semantic hole blocks live authority.

emath feature GlyphWorld:
    schema: "emath.feature-capsule"
    feature_id: "std.world.wave16_worlds_23.glyph_world"
    class: "world"
    semantic_hash: "sha256:d9d32e321c459dc5311b191d61aba2dd61d0fc6589122c5af996513746cbccd2"
    maturity: "cataloged"
    summary: "Represents source as a sequence of decoded glyphs."
    source: "core-structural-and-semantic-genesis-worlds-glyph-world"
    surface: "n/a(catalog-family | no dedicated syntax)"
    semantics: "hole(feature-semantics | select concrete capability contracts)"
    exactness: "n/a(catalog-family | depends on future capability)"
    effects: "pure catalog data"
    worlds: "n/a(catalog-family | worlds chosen by concrete capability)"
    providers: "n/a(catalog-family | no provider at catalog stage)"
    artifacts: "coverage,gap-radar"
    reference: "authored"
    conformance: "positive:catalog-accounting;negative:false-live;mutation:duplicate-id"
    migration: "n/a(initial-capsule | no prior authority)"
    authority_target: "capsule-candidate"
    presentation: "glyph world"
    agent: "owners=language/spec/worlds/wave16-worlds-23.emath;prerequisites=concrete-capability-selection;hazards=catalog-as-support;edits=capsule,conformance;checks=wave16-catalog-pack"
    edge: "depends_on -> std.constitution.language"
    projection: "semantics -> hole(feature-semantics | catalog only)"

