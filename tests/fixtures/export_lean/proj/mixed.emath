# Int and Rat meeting where Lean needs one type: the branches of an
# `if`, the items of a list, a cons, and a fold's starting value.
use fold.reduce

emath function mixed:
    inputs:
        c: Bool
        n: Int
        p: Rat
    outputs:
        result: Rat
    definitions:
        chosen = if c: n else: p
        items = [n, p]
        more = [n, ..items]
        total = fold(function acc in Rat: function x in Rat: acc + x, 0, more)
        result = chosen + total
    tests:
        example <int_branch>:
            given c = true
            given n = 2
            given p = 1 / 3
            expect result == 19 / 3
        example <rat_branch>:
            given c = false
            given n = 2
            given p = 1 / 3
            expect result == 14 / 3

# Several outputs: emath returns a record, Lean a structure. The Int
# remainder fills a Rat output.
emath function divmod:
    inputs:
        a: Int
        b: Int
    outputs:
        q: Int
        r: Rat
    definitions:
        q = int_quot(a, b)
        r = int_rem(a, b)
    tests:
        example <seven_by_two>:
            given a = 7
            given b = 2
            expect q == 3
            expect r == 1

emath function recombine:
    inputs:
        a: Int
    outputs:
        result: Rat
    definitions:
        d = divmod(a, 3)
        result = d.q * 3 + d.r / 2
    tests:
        example <eleven>:
            given a = 11
            expect result == 10
