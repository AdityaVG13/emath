# Code as a valid requested answer. This file installed no topic identity.
emath query CodeRequest:
    inputs:
        unused: Int
    definitions:
        target = quote(function x in Rat: x * x)
    question:
        target = target
        scope = unused
        assumptions = []
    answer:
        form = code
        accept = unchecked
    tests:
        example <code>:
            given unused = 0
            expect receipt.fulfillment == satisfied
            expect receipt.representation == code

emath query ValueRequest:
    inputs:
        unused: Int
    definitions:
        target = quote(function x in Rat: x * x)
    question:
        target = target
        scope = unused
        assumptions = []
    using:
        method = missing
    answer:
        form = value
        accept = unchecked
    tests:
        example <value>:
            given unused = 0
            expect receipt.fulfillment == unmet
