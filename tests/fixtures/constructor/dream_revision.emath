# A dream that revises its own model from evidence, then judges plans
# under the kept model. Plans are keys 0..99; a plan's score is the
# model's predicted total over cases 0..3 (lower is better). The model
# family: structure 0 is a constant p, 1 is (k - p)^2, 2 is
# (k - p)^2 + case, and 3 predicts -100 everywhere (it would make every
# plan look best). Every batch re-climbs from structure 0 on the
# evidence so far (`search.revision`): held-out cases decide the model,
# never the plan objective.
#
# Without evidence nothing is held out, so structure 0 with p = 0 is
# kept and every plan scores 0: the seed stays the incumbent. Readings
# of (k - 3)^2 + case on plans other than 3 revise the model to
# structure 2 with p = 3, and plan 3 - never observed - becomes the
# incumbent once proposed.
#
# Expected outcome: passes (1 authored test).
# Run: emath test tests/fixtures/constructor/dream_revision.emath

use search.archive
use search.experiments
use search.research
use search.observations
use search.revision

emath function model_predict:
    inputs:
        unused: Int
    outputs:
        result: Int -> Int -> Int -> Int -> Rat
    definitions:
        result = function s in Int: function p in Int: function k in Int: function c in Int: if s == 0: p / 1 else: if s == 1: (k - p) * (k - p) / 1 else: if s == 2: ((k - p) * (k - p) + c) / 1 else: -100 / 1

emath function kept_model:
    inputs:
        ev: sequence(Observation)
    outputs:
        result: ModelFit
    definitions:
        result = rev_climb(ev, 2, model_predict(0), function s in Int: 20, function s in Int: [s - 1, s + 1], function s in Int: s >= 0 and s <= 3, 0, 8)
    tests:
        example <revised_to_the_true_law>:
            given ev = [Observation: {subject: 0, case_id: 0, value: 9 / 1, source: 1}, Observation: {subject: 0, case_id: 1, value: 10 / 1, source: 1}, Observation: {subject: 5, case_id: 2, value: 6 / 1, source: 1}, Observation: {subject: 5, case_id: 3, value: 7 / 1, source: 1}]
            expect result.structure == 2
            expect result.param == 3

emath function plan_score:
    inputs:
        m: ModelFit
        k: Int
    outputs:
        result: Rat
    definitions:
        f = model_predict(0)
        result = f(m.structure, m.param, k, 0) + f(m.structure, m.param, k, 1) + f(m.structure, m.param, k, 2) + f(m.structure, m.param, k, 3)

emath function MakeValueOf:
    inputs:
        unused: Int
    outputs:
        result: Int -> Rat
    definitions:
        result = function k in Int: k / 1

emath function MakeAdmit:
    inputs:
        unused: Int
    outputs:
        result: Int -> Bool
    definitions:
        result = function k in Int: k >= 0 and k <= 99

emath function MakeMoves:
    inputs:
        unused: Int
    outputs:
        result: Int -> sequence(Int)
    definitions:
        result = function k in Int: [k + 1]

emath function MakeFamilyOf:
    inputs:
        unused: Int
    outputs:
        result: Int -> Int
    definitions:
        result = function k in Int: 0

emath function MakeQuota:
    inputs:
        unused: Int
    outputs:
        result: Int -> Int
    definitions:
        result = function f in Int: 1

emath function MakeScore:
    inputs:
        m: ModelFit
    outputs:
        result: Int -> CaseSet -> Rat
    definitions:
        result = function k in Int: function cs in CaseSet: plan_score(m, k)

emath function MakeWitness:
    inputs:
        unused: Int
    outputs:
        result: Int -> CaseSet -> Int
    definitions:
        result = function k in Int: function cs in CaseSet: -1

emath function MakeHardOk:
    inputs:
        unused: Int
    outputs:
        result: Int -> Bool
    definitions:
        result = function k in Int: true

emath function MakeGoalMet:
    inputs:
        unused: Int
    outputs:
        result: Rat -> Bool
    definitions:
        result = function s in Rat: false

emath function MakeBetter:
    inputs:
        unused: Int
    outputs:
        result: Rat -> Rat -> Bool
    definitions:
        result = function a in Rat: function b in Rat: a < b

emath function MakeNextCases:
    inputs:
        unused: Int
    outputs:
        result: Int -> CaseSet -> CaseSet
    definitions:
        result = function k in Int: function cs in CaseSet: cs

emath function SeedRevision:
    inputs:
        unused: Int
    outputs:
        result: LoopState
    definitions:
        result = research_seed(0, MakeValueOf(0), CaseSet: {ids: [0]}, MakeScore(kept_model([])), MakeWitness(0), 1, 0, 1, 1)

emath function StepRevision:
    inputs:
        state: LoopState
        budget: Int
        evidence: sequence(Observation)
    outputs:
        result: LoopState
    definitions:
        score = MakeScore(kept_model(evidence))
        result = research_batch(state, MakeValueOf(0), MakeAdmit(0), MakeMoves(0), MakeFamilyOf(0), MakeQuota(0), score, score, MakeWitness(0), MakeHardOk(0), MakeGoalMet(0), MakeBetter(0), MakeNextCases(0), budget)
