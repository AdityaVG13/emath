# Evaluation-order pins: what runs, in what order, and how deep.
#
# Normative sources:
# - reference/rust-interop-and-generation.md: named definitions evaluate
#   eagerly; only the inline right operand of `and` / `or` is lazy.
# - reference/expressions-equations-state-and-events.md: `and` / `or`
#   short-circuit.
# - reference/evidence-budgets-compile-and-host.md: nested calls are
#   bounded at 10,000 frames (`recursion_depth_exceeded`).
# Only the taken arm of an `if` runs. Every guarded module relies on that
# (search.claim's check_claim gates, index guards in fold and search).
# Each test example is its own evaluation: a shallow row run first must
# not leave answers that let a deep row skip its depth (Nest, NestClosure).
#
# Every observation flows through `result`: an expect that reads an
# intermediate definition evaluates it again, which would mint a fresh
# buffer and hide the write under test.
# Run: emath test tests/fixtures/constructor/evaluation_order.emath

emath function Mark:
    # Writes true at `at` and returns 1, a visible trace that the call ran.
    inputs:
        cells: buffer
        at: Int
    outputs:
        result: Int
    definitions:
        wrote = buffer_set(cells, at, true)
        result = 1

emath function Stamp:
    # Writes `v` into cell 0 and returns it.
    inputs:
        cells: buffer
        v: Int
    outputs:
        result: Int
    definitions:
        wrote = buffer_set(cells, 0, v)
        result = v

emath function UnreadDefinition:
    # A definition nothing reads still runs.
    inputs:
        size: Int
    outputs:
        result: Bool
    definitions:
        cells = buffer(size, false)
        unread = Mark(cells, 0)
        result = cells[0]
    tests:
        example <unread_definition_runs>:
            given size = 1
            expect result == true

emath function UnreadFault:
    # A faulting definition nothing reads faults the whole function.
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        boom = [0][n]
        result = 5
    tests:
        example <unread_fault_faults>:
            given n = 1
            expect diagnostic.code == invalid_index
        example <unread_in_bounds_is_harmless>:
            given n = 0
            expect result == 5

emath function SourceOrder:
    # Independent definitions run in source order: the later write wins.
    inputs:
        size: Int
    outputs:
        result: Int
    definitions:
        cells = buffer(size, 0)
        first = Stamp(cells, 1)
        second = Stamp(cells, 2)
        result = cells[0]
    tests:
        example <later_write_wins>:
            given size = 1
            expect result == 2

emath function BranchInDefinition:
    # Inside a definition, only the taken arm of an `if` runs.
    inputs:
        take_then: Bool
    outputs:
        result: sequence(Bool)
    definitions:
        cells = buffer(2, false)
        chosen = if take_then: Mark(cells, 0) else: Mark(cells, 1)
        result = [cells[0], cells[1]]
    tests:
        example <then_arm_alone_runs>:
            given take_then = true
            expect result == [true, false]
        example <else_arm_alone_runs>:
            given take_then = false
            expect result == [false, true]

emath function GuardInDefinition:
    # A faulting untaken arm inside a definition is harmless.
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        safe = if n < 1: [7][n] else: 0
        result = safe + 1
    tests:
        example <untaken_fault_is_skipped>:
            given n = 5
            expect result == 1
        example <taken_arm_still_reads>:
            given n = 0
            expect result == 8

emath function GuardInResult:
    # The same law where the `if` is the function's result (tail position).
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = if n < 1: [7][n] else: 0
    tests:
        example <untaken_tail_fault_is_skipped>:
            given n = 5
            expect result == 0
        example <taken_tail_arm_reads>:
            given n = 0
            expect result == 7

emath function ShortCircuit:
    # `and` and `or` skip the right operand when the left decides.
    inputs:
        n: Int
    outputs:
        result: sequence(Bool)
    definitions:
        skip_and = n < 0 and [0][n] == 0
        skip_or = n > 0 or [0][n] == 0
        result = [skip_and, skip_or]
    tests:
        example <decided_left_skips_right>:
            given n = 5
            expect result == [false, true]

emath function RightOperandRuns:
    # When the left does not decide, the right operand is evaluated.
    inputs:
        n: Int
    outputs:
        result: Bool
    definitions:
        result = n > 0 and [0][n] == 0
    tests:
        example <undecided_left_evaluates_right>:
            given n = 5
            expect diagnostic.code == invalid_index

emath function Nest:
    # Non-tail recursion: every level waits on the next, so each holds a
    # frame. The shallow row runs first on purpose.
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = if n == 0: 0 else: 1 + Nest(n - 1)
    tests:
        example <below_the_depth_cap>:
            given n = 5000
            expect result == 5000
        example <past_the_depth_cap>:
            given n = 12000
            expect diagnostic.code == recursion_depth_exceeded

emath function NestClosure:
    # The same through a recursive closure, whose answers are kept in a
    # different memo than named calls.
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = (recur f in Int -> Int: function m in Int: if m == 0: 0 else: 1 + f(m - 1))(n)
    tests:
        example <closure_below_the_depth_cap>:
            given n = 5000
            expect result == 5000
        example <closure_past_the_depth_cap>:
            given n = 12000
            expect diagnostic.code == recursion_depth_exceeded
