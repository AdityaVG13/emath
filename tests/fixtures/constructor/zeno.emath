# Zeno and infinite evidence. This file installed no topic identity.
emath query Zeno:
    inputs:
        unused: Int
    definitions:
        result = 0
    question:
        target = result
        scope = unused
        assumptions = []
    using:
        method = missing
    answer:
        form = value
        accept = unchecked
    tests:
        example <unfinished>:
            given unused = 0
            expect receipt.fulfillment == unmet

emath query FinitePrefix:
    inputs:
        unused: Int
    definitions:
        result = 0
    question:
        target = result
        scope = unused
        assumptions = []
    using:
        method = missing
    answer:
        form = value
        accept = unchecked
    tests:
        example <prefix>:
            given unused = 0
            expect receipt.fulfillment == unmet
