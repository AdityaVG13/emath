# Dream target 5 (bead emath-gav6o): the plateau world. A one-case
# world whose every admittable candidate masters (the prediction is
# constant and correct), over an UNBOUNDED admitted domain (k >= 0)
# whose moves always yield a fresh key (k + 1). Nothing can strictly
# improve (every score is 0/1), the audit grows to the full world
# (one case) in the first batch and then never changes, and the
# proposal stream never runs dry - so the only honest close is the
# driver's plateau law: three consecutive batches with no promotion
# and no growth. This fixture is the driver's plateau-counter probe:
# domain exhaustion can never fire here.
#
# Expected outcome: passes (2 authored tests).
# Run: emath test tests/fixtures/constructor/dream_plateau_const.emath

use search.archive
use search.experiments
use search.research

emath function dream_world:
    inputs:
        unused: Int
    outputs:
        result: sequence(Int)
    definitions:
        result = [7]

emath function dream_pred:
    # Every candidate predicts the world exactly: constant 7.
    inputs:
        k: Int
        i: Int
    outputs:
        result: Int
    definitions:
        result = 7

emath function world_at:
    inputs:
        i: Int
    outputs:
        result: Int
    definitions:
        result = dream_world(0)[i]

emath function case_error:
    inputs:
        k: Int
        i: Int
    outputs:
        result: Int
    definitions:
        result = if dream_pred(k, i) == world_at(i): 0 else: 1

emath function errors_at:
    inputs:
        k: Int
        ids: sequence(Int)
        j: Int
    outputs:
        result: Int
    definitions:
        done = j >= length(ids)
        one = if done: 0 else: case_error(k, ids[j])
        result = if done: 0 else: one + errors_at(k, ids, j + 1)

emath function first_wrong:
    inputs:
        k: Int
        ids: sequence(Int)
        j: Int
    outputs:
        result: Int
    definitions:
        done = j >= length(ids)
        c = if done: -1 else: ids[j]
        result = if done: -1 else: if case_error(k, c) == 1: c else: first_wrong(k, ids, j + 1)

emath function full_ids:
    inputs:
        unused: Int
    outputs:
        result: sequence(Int)
    definitions:
        result = [0]

emath function next_missing:
    inputs:
        ids: sequence(Int)
        j: Int
    outputs:
        result: Int
    definitions:
        w = dream_world(0)
        done = j >= length(w)
        result = if done: -1 else: if seq_has(ids, j, 0): next_missing(ids, j + 1) else: j

emath function MakeValueOf:
    inputs:
        unused: Int
    outputs:
        result: Int -> Rat
    definitions:
        result = function k in Int: k / 1

emath function MakeAdmit:
    # Unbounded: the domain never exhausts.
    inputs:
        unused: Int
    outputs:
        result: Int -> Bool
    definitions:
        result = function k in Int: k >= 0

emath function MakeMoves:
    # Always one fresh key upward: the proposal stream never dries.
    inputs:
        unused: Int
    outputs:
        result: Int -> sequence(Int)
    definitions:
        result = function k in Int: [k + 1]

emath function MakeFamilyOf:
    inputs:
        unused: Int
    outputs:
        result: Int -> Int
    definitions:
        result = function k in Int: 0

emath function MakeQuota:
    inputs:
        unused: Int
    outputs:
        result: Int -> Int
    definitions:
        result = function f in Int: 4

emath function MakeScore:
    inputs:
        unused: Int
    outputs:
        result: Int -> CaseSet -> Rat
    definitions:
        result = function k in Int: function cs in CaseSet: errors_at(k, cs.ids, 0) / 1

emath function MakeWitness:
    inputs:
        unused: Int
    outputs:
        result: Int -> CaseSet -> Int
    definitions:
        result = function k in Int: function cs in CaseSet: first_wrong(k, cs.ids, 0)

emath function MakeHardOk:
    inputs:
        unused: Int
    outputs:
        result: Int -> Bool
    definitions:
        result = function k in Int: true

emath function MakeGoalMet:
    inputs:
        unused: Int
    outputs:
        result: Rat -> Bool
    definitions:
        result = function s in Rat: false

emath function MakeBetter:
    # Fewer errors is better, strictly (better(x, y) = x beats y).
    inputs:
        unused: Int
    outputs:
        result: Rat -> Rat -> Bool
    definitions:
        result = function a in Rat: function b in Rat: a < b

emath function MakeNextCases:
    inputs:
        unused: Int
    outputs:
        result: Int -> CaseSet -> CaseSet
    definitions:
        result = function k in Int: function cs in CaseSet: if errors_at(k, cs.ids, 0) == 0 and length(cs.ids) < length(dream_world(0)): CaseSet: {ids: cases_union(cs.ids, [next_missing(cs.ids, 0)])} else: cs

emath function graduate_mark:
    inputs:
        arch: sequence(ResearchCandidate)
        oi: Int
        bound: Rat
    outputs:
        result: sequence(ResearchCandidate)
    definitions:
        done = oi >= length(arch)
        r = if done: arch[0] else: arch[oi]
        graduated = (not done) and r.score > bound
        r2 = if not graduated: r else: ResearchCandidate: {key: r.key, value: r.value, parent: r.parent, move: r.move, family: r.family, target_id: r.target_id, evaluator_id: r.evaluator_id, input_id: r.input_id, tier: r.tier, score: r.score, bound: r.bound, witness: r.witness, counterexample: r.counterexample, refusal: r.refusal, accepted: r.accepted, retained: false}
        arch2 = if graduated: arch_set(arch, oi, r2) else: arch
        result = if done: arch else: graduate_mark(arch2, oi + 1, bound)

emath function graduate:
    inputs:
        state: LoopState
    outputs:
        result: LoopState
    definitions:
        inc_key = state.archive[state.incumbent].key
        bound = errors_at(inc_key, full_ids(0), 0) / 1
        result = LoopState: {archive: graduate_mark(state.archive, 0, bound), incumbent: state.incumbent, case_set: state.case_set, batch: state.batch, used: state.used, verdict: state.verdict, mode: state.mode}

emath function SeedDream:
    inputs:
        unused: Int
    outputs:
        result: LoopState
    definitions:
        result = research_seed(0, MakeValueOf(0), CaseSet: {ids: []}, MakeScore(0), MakeWitness(0), 5, 0, 1, 1)
    tests:
        example <seed_state>:
            given unused = 0
            expect result.archive[0].key == 0
            expect result.used == 1
            expect result.mode == 1

emath function StepDream:
    inputs:
        state: LoopState
        budget: Int
    outputs:
        result: LoopState
    definitions:
        ran = research_batch(state, MakeValueOf(0), MakeAdmit(0), MakeMoves(0), MakeFamilyOf(0), MakeQuota(0), MakeScore(0), MakeScore(0), MakeWitness(0), MakeHardOk(0), MakeGoalMet(0), MakeBetter(0), MakeNextCases(0), budget)
        result = graduate(ran)

emath function RunDream:
    # The walk that never exhausts and never improves: batch 1 grows
    # the audit to the full one-case world; every later batch is a
    # plateau (no promotion, no growth, proposals still flowing).
    inputs:
        unused: Int
    outputs:
        winner: Int
        verdict: Int
        case_count: Int
        errors: Int
    definitions:
        s0 = SeedDream(0)
        s1 = StepDream(s0, 64)
        s2 = StepDream(s1, 64)
        s3 = StepDream(s2, 64)
        s4 = StepDream(s3, 64)
        winner = s4.archive[s4.incumbent].key
        verdict = s4.verdict
        case_count = length(s4.case_set.ids)
        errors = errors_at(winner, full_ids(0), 0)
    tests:
        example <plateau_with_full_audit>:
            given unused = 0
            expect winner == 0
            expect verdict == 3
            expect case_count == 1
            expect errors == 0
