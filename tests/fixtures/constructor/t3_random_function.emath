# T3: Shared random function. This file installed no topic identity.
emath function shared_agree:
    inputs:
        unused: Int
    outputs:
        result: Rat
    definitions:
        result = 1

emath function independent_agree:
    inputs:
        unused: Int
    outputs:
        result: Rat
    definitions:
        a00 = if 0 == 0: 1 else: 0
        a01 = if 0 == 1: 1 else: 0
        a10 = if 1 == 0: 1 else: 0
        a11 = if 1 == 1: 1 else: 0
        result = (a00 + a01 + a10 + a11) / 4
    tests:
        example <half>:
            given unused = 0
            expect result == 1 / 2
