# T6: Represented-real uncertainty. This file installed no topic identity.
emath function equality_undecided:
    inputs:
        unused: Int
    outputs:
        result: Bool
    definitions:
        lo = 0 - 1 / 10
        hi = 1 / 10
        contains_zero = lo <= 0 and 0 <= hi
        result = contains_zero
    tests:
        example <zero_inside>:
            given unused = 0
            expect result == true

emath query Equality:
    inputs:
        unused: Int
    definitions:
        result = 0
    question:
        target = result
        scope = unused
        assumptions = []
    using:
        method = missing
    answer:
        form = value
        accept = unchecked
    tests:
        example <undecided>:
            given unused = 0
            expect receipt.fulfillment == unmet
