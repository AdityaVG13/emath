# Singular target preservation. This file installed no topic identity.
emath function pv_zero:
    inputs:
        unused: Int
    outputs:
        result: Int
    definitions:
        result = 0

emath query OrdinaryIntegral:
    inputs:
        unused: Int
    definitions:
        candidate = 0
    question:
        target = quote(function x in Rat: 1 / x)
        scope = unused
        assumptions = []
    using:
        method = missing
    answer:
        form = value
        accept = unchecked
    tests:
        example <ordinary>:
            given unused = 0
            expect receipt.fulfillment == unmet

emath query PrincipalValue:
    inputs:
        unused: Int
    definitions:
        candidate = 0
    question:
        target = candidate
        scope = unused
        assumptions = []
    using:
        method = pv_zero
    answer:
        form = value
        accept = unchecked
    tests:
        example <pv>:
            given unused = 0
            expect receipt.fulfillment == partial
