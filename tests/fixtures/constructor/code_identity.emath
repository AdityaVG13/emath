# quote.identity: the canonical identity of a code value - an Int that
# is equal for code equal up to renaming of bound names. The emitted
# lane must produce the VM's exact numbers, not just the same
# equalities: identities can be stored and compared across runs.
# Every case substitutes its input into the code, so the build cannot
# fold it to a constant and the compiled identity runs.

emath function template_identity:
    # x * 2 + k
    inputs:
        k: Int
    outputs:
        result: Int
    definitions:
        result = quote.identity(quote.substitute(quote(x * 2 + c), "c", k))

emath function substituted_identity:
    # a substituted Rat value becomes a literal in the code
    inputs:
        r: Rat
    outputs:
        result: Int
    definitions:
        result = quote.identity(quote.substitute(quote(z + 1), "z", r))

emath function size:
    inputs:
        xs: sequence(Rat)
    outputs:
        result: Int
    definitions:
        result = length(xs)

emath function body_identity:
    # an unfolded body: a binder over a sequence domain, used in the body
    inputs:
        k: Int
    outputs:
        result: Int
    definitions:
        named = if k > 0: quote(size) else: quote(body_identity)
        result = quote.identity(quote.body(named).fragment)

emath function inc_a:
    inputs:
        a: Int
    outputs:
        result: Int
    definitions:
        result = a + 1

emath function inc_b:
    inputs:
        b: Int
    outputs:
        result: Int
    definitions:
        result = b + 1

emath function renamed_binders_agree:
    # two bodies that differ only in their input's name
    inputs:
        k: Int
    outputs:
        result: Bool
    definitions:
        left = quote.body(if k > 0: quote(inc_a) else: quote(size)).fragment
        right = quote.body(if k > 0: quote(inc_b) else: quote(size)).fragment
        result = quote.identity(left) == quote.identity(right)
    tests:
        example <alpha_equivalent>:
            given k = 3
            expect result == true

emath function code_equality:
    # `==` on code is quote.identity's relation: equal up to bound names,
    # wherever the code was written, and whether or not it was rebuilt
    inputs:
        k: Int
    outputs:
        result: Bool
    definitions:
        q = quote.substitute(quote(inc_a(s) + c), "c", k)
        same = q == quote.substitute(quote(inc_a(s) + c), "c", k)
        differ = q != quote.substitute(quote(inc_a(s) + c), "c", k + 1)
        rebuilt = quote.make(quote.view(q)) == q
        left = quote.body(if k > 0: quote(inc_a) else: quote(size)).fragment
        right = quote.body(if k > 0: quote(inc_b) else: quote(size)).fragment
        result = same and differ and rebuilt and left == right
    tests:
        example <code_equality>:
            given k = 3
            expect result == true

emath function different_code_differs:
    inputs:
        k: Int
    outputs:
        result: Bool
    definitions:
        result = quote.identity(quote.substitute(quote(x + c), "c", k)) != quote.identity(quote.substitute(quote(x + c), "c", k + 1))
    tests:
        example <distinct>:
            given k = 1
            expect result == true

emath function nesting_differs:
    # the same leaves nested differently: [[1], c] and [[1, c]], f(g(x), c) and f(g(x, c))
    inputs:
        k: Int
    outputs:
        result: Bool
    definitions:
        lists = quote.identity(quote.substitute(quote([[1], c]), "c", k)) != quote.identity(quote.substitute(quote([[1, c]]), "c", k))
        calls = quote.identity(quote.substitute(quote(f(g(x), c)), "c", k)) != quote.identity(quote.substitute(quote(f(g(x, c))), "c", k))
        result = lists and calls
    tests:
        example <nesting>:
            given k = 2
            expect result == true

emath function child_matches_template:
    # a child of a view is a node; its identity is its code's
    inputs:
        k: Int
    outputs:
        result: Bool
    definitions:
        result = quote.identity(quote.view(quote.substitute(quote(x + c), "c", k)).args[0]) == quote.identity(quote(x))
    tests:
        example <child_is_x>:
            given k = 1
            expect result == true

emath function recur_identity:
    # a quoted recursive function with its constant substituted
    inputs:
        k: Int
    outputs:
        result: Int
    definitions:
        result = quote.identity(quote.substitute(quote(recur g in Int -> Int: function n in Int: if n < 1: c else: g(n - 1) + 1), "c", k))

emath function recur_renamed_agree:
    # two recursive functions that differ only in the names they bind
    inputs:
        k: Int
    outputs:
        result: Bool
    definitions:
        left = if k > 0: quote(recur g in Int -> Int: function n in Int: g(n - 1) + 1) else: quote(size)
        right = if k > 0: quote(recur h in Int -> Int: function m in Int: h(m - 1) + 1) else: quote(size)
        result = quote.identity(left) == quote.identity(right)
    tests:
        example <alpha_equivalent_recur>:
            given k = 2
            expect result == true

emath function recur_shadows:
    # the recursive name is bound inside: only the g outside it is replaced
    inputs:
        k: Int
    outputs:
        result: Bool
    definitions:
        q = if k > 0: quote([g, recur g in Int -> Int: function n in Int: g(n - 1) + 1]) else: quote([g, 1])
        expected = if k > 0: quote([h, recur g in Int -> Int: function n in Int: g(n - 1) + 1]) else: quote([h, 1])
        result = quote.identity(quote.substitute(q, "g", quote(h))) == quote.identity(expected)
    tests:
        example <recur_name_bound>:
            given k = 2
            expect result == true

emath function recur_round_trip:
    # a viewed recursive function is a Recur node and makes back to itself
    inputs:
        k: Int
    outputs:
        result: Bool
    definitions:
        q = if k > 0: quote(recur g in Int -> Int: function n in Int: g(n - 1) + 1) else: quote(x + 1)
        v = quote.view(q)
        result = (v.kind == Recur) == (k > 0) and quote.identity(quote.make(v)) == quote.identity(q)
    tests:
        example <recur_view_make>:
            given k = 2
            expect result == true

emath function recur_over_sequence:
    # a sequence bound into a recursive function that calls a module function
    inputs:
        xs: sequence(Rat)
    outputs:
        result: Int
    definitions:
        result = quote.identity(quote.substitute(quote(recur g in Int -> Rat: function d in Int: size(r) + d), "r", xs))

emath function joined_name:
    # a numbered name minted from an input: pi_formula_k
    inputs:
        k: Int
    outputs:
        result: Int
    definitions:
        result = quote.identity(quote.join(quote.join(quote(pi), quote(formula)), k))

emath function joined_tag:
    # a viewed local's name tag joins like a quoted identifier
    inputs:
        k: Int
    outputs:
        result: Bool
    definitions:
        name = quote.view(if k > 0: quote(alpha) else: quote(beta)).name
        result = quote.identity(quote.join(name, quote(x))) == quote.identity(if k > 0: quote(alpha_x) else: quote(beta_x))
    tests:
        example <tag_joins>:
            given k = 1
            expect result == true

emath function index_identity:
    # a function over a window whose body indexes it at an input, rebuilt from the view
    inputs:
        k: Int
    outputs:
        result: Int
    definitions:
        v = quote.view(quote(function h in sequence(Int): h))
        h = quote.make(Local: {name: v.param, token: v.param})
        e = quote.substitute(quote.substitute(quote(xs[ii] * xs[0]), "xs", h), "ii", k)
        result = quote.identity(quote.make(Closure: {param: v.param, domain: v.domain, body: e}))

emath function index_round_trip:
    # an index node viewed, then rebuilt with the next index
    inputs:
        k: Int
    outputs:
        result: Bool
    definitions:
        v = quote.view(quote.substitute(quote(ys[ii]), "ii", k))
        back = quote.make(Index: {container: v.container, index: quote.make(Literal: {value: k + 1})})
        result = v.kind == Index and quote.identity(back) == quote.identity(quote.substitute(quote(ys[ii]), "ii", k + 1)) and quote.identity(v.index) == quote.identity(quote.substitute(quote(ii), "ii", k))
    tests:
        example <next_index>:
            given k = 2
            expect result == true

emath function exact_substitute:
    # a ratio's numerator (an exact integer) substituted into code
    inputs:
        k: Int
    outputs:
        result: Int
    definitions:
        r = (k * 3) / 2
        result = quote.identity(quote.substitute(quote(u * 2), "u", r.numer))
