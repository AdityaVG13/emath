# The honest boundary of named-function arity: a NAMED call with the
# wrong arity refuses `arity` at application time, never a
# zip-truncated binding. (Passing a two-input function where a unary
# closure is declared is refused statically at admission; see the
# `generic-functions-admit` cutover case.)
emath function two_in:
    inputs:
        a: Rat
        b: Rat
    outputs:
        result: Rat
    definitions:
        result = a + b

emath function tail_wrong_arity:
    # A NAMED tail call with the wrong arity must also refuse `arity`
    # — not a zip-truncated binding that faults `unbound` on the
    # missing input.
    inputs:
        unused: Int
    outputs:
        result: Rat
    definitions:
        result = two_in(3 / 1)
    tests:
        example <named_tail_wrong_arity_refuses>:
            given unused = 0
            expect diagnostic.code == arity
