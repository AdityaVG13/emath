# Representation crossings: recursive calls, closures, records, and sequences.
emath function PrependInput:
    inputs:
        head: Int
        tail: sequence(Int)
    outputs:
        result: sequence(Int)
    definitions:
        result = [head, ..tail]

emath function MixedVectorRecord:
    inputs:
        n: Int
    outputs:
        values: sequence(Int)
        marker: Int
    definitions:
        values = [1, int_quot(n, 3)]
        marker = 1

emath function ConsVectorRecord:
    inputs:
        n: Int
    outputs:
        values: sequence(Int)
        marker: Int
    definitions:
        values = [1, ..[int_quot(n, 3)]]
        marker = 1

emath function ApplyVector:
    inputs:
        f: sequence(Int) -> Int
        n: Int
    outputs:
        result: Int
    definitions:
        result = f([int_quot(n, 3), int_rem(n, 3)])

emath function VectorClosure:
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = ApplyVector(function xs in sequence(Int): xs[0] + xs[1], n)

emath function Reset:
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = if n == 0: n else: Reset(0)

emath function WideThenSmall:
    inputs:
        unused: Int
    outputs:
        result: Int
    definitions:
        result = Reset(9223372036854775808)

emath function Pair:
    inputs:
        n: Int
        d: Int
    outputs:
        quotient: Int
        remainder: Int
    definitions:
        quotient = int_quot(n, d)
        remainder = int_rem(n, d)
    tests:
        example <signed_euclidean>:
            given n = -10
            given d = 3
            expect quotient == -4
            expect remainder == 2

emath function Countdown:
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = if n <= 0: 0 else: 1 + Countdown(int_quot(n, 2))
    tests:
        example <recursive_argument>:
            given n = 10
            expect result == 4

emath function ApplyQuotient:
    inputs:
        f: Int -> Int
        n: Int
    outputs:
        result: Int
    definitions:
        result = f(int_quot(n, 3))

emath function ClosureBoundary:
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = ApplyQuotient(function x in Int: x + 1, n)
    tests:
        example <closure_argument>:
            given n = 12
            expect result == 5

emath function HigherOrderClosure:
    inputs:
        f: Int -> Int
    outputs:
        result: Int
    definitions:
        apply = function g in Int -> Int: g(3)
        result = apply(f)
    tests:
        example <converted_closure_ownership>:
            given f = function x in Int: x + 1
            expect result == 4

emath function TinyRatio:
    inputs:
        n: Int
    outputs:
        result: Float64
    definitions:
        result = (1 / int_pow(2, n)) * 1.0f64

emath function VectorRecord:
    inputs:
        n: Int
    outputs:
        values: sequence(Int)
        marker: Int
    definitions:
        values = [int_quot(n, 3), int_rem(n, 3)]
        marker = 1
    tests:
        example <sequence_elements>:
            given n = 10
            expect values == [3, 1]

emath function RatRecord:
    inputs:
        n: Int
    outputs:
        value: Rat
        marker: Int
    definitions:
        value = int_quot(n, 3)
        marker = 1
    tests:
        example <exact_widening>:
            given n = 10
            expect value == 3 / 1

emath function LiteralRatRecord:
    inputs:
        unused: Int
    outputs:
        value: Rat
        marker: Int
    definitions:
        value = 3
        marker = 1

emath function OverflowRecord:
    inputs:
        unused: Int
    outputs:
        value: Int
        marker: Int
    definitions:
        value = int_quot(9223372036854775808, 1)
        marker = 1

emath function ClosureOverflow:
    inputs:
        unused: Int
    outputs:
        result: Int
    definitions:
        f = function x in Int: x
        result = f(int_quot(9223372036854775808, 1))

emath function Forward:
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = n

emath function WideThroughFrame:
    inputs:
        unused: Int
    outputs:
        result: Int
    definitions:
        result = Forward(int_quot(9223372036854775808, 1))
    tests:
        example <preserve_wide_frame>:
            given unused = 0
            expect result == 9223372036854775808

emath function WideTimesFloat:
    # A wide Int widens to Float64 in mixed arithmetic, as in the VM.
    inputs:
        unused: Int
    outputs:
        result: Float64
    definitions:
        result = int_quot(9223372036854775808, 1) * 0.5f64
    tests:
        example <wide_widens>:
            given unused = 0
            expect result == 4611686018427387904.0f64

emath function MixedEquality:
    inputs:
        n: Int
    outputs:
        rat_equal: Bool
        rat_different: Bool
        float_equal: Bool
        float_different: Bool
        float_precision_equal: Bool
        float_precision_greater: Bool
        float_precision_reverse_less: Bool
        float_large_equal: Bool
    definitions:
        f = function x in Int: x == 1 / 1
        g = function x in Int: 1 / 1 != x
        h = function x in Int: x == 1.0f64
        j = function x in Int: 1.0f64 != x
        precise = function x in Int: x == 9007199254740992.0f64
        above = function x in Int: x > 9007199254740992.0f64
        below = function x in Int: 9007199254740992.0f64 < x
        large = function x in Int: (int_pow(2, 200) + x) == 1606938044258990275541962092341162602522202993782792835301376.0f64
        rat_equal = f(n)
        rat_different = g(n)
        float_equal = h(n)
        float_different = j(n)
        float_precision_equal = precise(n)
        float_precision_greater = above(n)
        float_precision_reverse_less = below(n)
        float_large_equal = large(n)
    tests:
        example <equal>:
            given n = 1
            expect rat_equal and not rat_different and float_equal and not float_different
        example <different>:
            given n = 2
            expect not rat_equal and rat_different and not float_equal and float_different
        example <exact_float_boundary>:
            given n = 9007199254740992
            expect float_precision_equal and not float_precision_greater and not float_precision_reverse_less
        example <rounded_float_boundary>:
            given n = 9007199254740993
            expect not float_precision_equal and float_precision_greater and float_precision_reverse_less
        example <large_exact_float>:
            given n = 0
            expect float_large_equal
        example <large_rounded_float>:
            given n = 1
            expect not float_large_equal

emath object CountInput:
    representation:
        n: Int

emath function AlternatingRecurrence:
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = (recur f in Int -> Int: function k in Int: if k == 0: 0 else: k - f(k - 1))(n)
    tests:
        example <right_subtraction>:
            given n = 2
            expect result == 1

emath function ConstantRightSubtraction:
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = (recur f in Int -> Int: function k in Int: if k == 0: 0 else: 2 - f(k - 1))(n)
    tests:
        example <constant_right_subtraction>:
            given n = 2
            expect result == 0
emath function ReversedGuard:
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = (recur f in Int -> Int: function k in Int: if 0 <= k: 9 else: f(k - 1) + 1)(n)
    tests:
        example <guard_orientation>:
            given n = 2
            expect result == 9

emath function DependentBase:
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = (recur f in Int -> Int: function k in Int: if k == 0: k else: f(k - 1) + 1)(n)
    tests:
        example <terminal_base>:
            given n = 2
            expect result == 2

emath function RecordIteration:
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        obj = CountInput: {n: if n < 0: int_pow(2, 63) else: n}
        result = (recur f in Int -> Int: function k in Int: if k == 0: 0 else: f(k - 1) + 1)(obj.n)
    tests:
        example <count>:
            given n = 3
            expect result == 3
        example <empty>:
            given n = 0
            expect result == 0

emath function SquareGap:
    inputs:
        x: Int
    outputs:
        result: Int
    definitions:
        result = x * x - (x - 1) * (x + 1)
    tests:
        example <intermediate_past_i64>:
            given x = 4294967296
            expect result == 1

emath function WideSquare:
    inputs:
        x: Int
    outputs:
        result: Int
    definitions:
        result = x * x
    tests:
        example <result_past_i64>:
            given x = 4294967296
            expect result == 18446744073709551616

emath function PowerOf:
    inputs:
        b: Int
        e: Int
    outputs:
        result: Int
    definitions:
        result = if e == 0: 1 else: b * PowerOf(b, e - 1)

emath function PowerSign:
    inputs:
        e: Int
    outputs:
        result: Int
    definitions:
        result = if PowerOf(2, e) > 0: 1 else: 0
    tests:
        example <callee_past_i64>:
            given e = 70
            expect result == 1

emath function WindowProduct:
    inputs:
        ds: sequence(Int)
        k: Int
        acc: Int
        span: Int
    outputs:
        result: Int
    definitions:
        result = if k == span: acc else: WindowProduct(ds, k + 1, acc * ds[k], span)

emath function WindowGap:
    inputs:
        span: Int
    outputs:
        result: Int
    definitions:
        sevens = [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]
        result = WindowProduct(sevens, 0, 1, span) - 7 * WindowProduct(sevens, 0, 1, span - 1)
    tests:
        example <tail_walk_past_i64>:
            given span = 30
            expect result == 0
