# T13: Engineered queue. This file installed no topic identity.
# Single nonpreemptive server; two jobs arrive at time 0; services 2 and 1;
# lower-ID starts first.

emath function finish:
    inputs:
        arrive: Int
        service: Int
        ready: Int
    outputs:
        done: Int
        next_ready: Int
    definitions:
        start = if arrive > ready: arrive else: ready
        done = start + service
        next_ready = done

emath function completions:
    inputs:
        unused: Int
    outputs:
        c0: Int
        c1: Int
        both_done: Bool
        throughput: Rat
    definitions:
        first = finish(0, 2, 0)
        second = finish(0, 1, first.next_ready)
        c0 = first.done
        c1 = second.done
        both_done = c0 <= 3 and c1 <= 3
        throughput = 2 / 3
    tests:
        example <horizon>:
            given unused = 0
            expect c0 == 2
            expect c1 == 3
            expect both_done == true
            expect throughput == 2 / 3
