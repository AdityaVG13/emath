# Fair versus sequential search. This file installed no topic identity.
emath function fair_step:
    inputs:
        k: Int
    outputs:
        found: Bool
    definitions:
        found = k == 4

emath function fair_finds:
    inputs:
        unused: Int
    outputs:
        result: Bool
    definitions:
        result = fair_step(4)
    tests:
        example <fourth>:
            given unused = 0
            expect result == true

emath query SequentialFirst:
    inputs:
        unused: Int
    definitions:
        result = 0
    question:
        target = result
        scope = unused
        assumptions = []
    using:
        method = missing
    answer:
        form = value
        accept = unchecked
    tests:
        example <suspended>:
            given unused = 0
            expect receipt.fulfillment == unmet
