# Closure memo keys must distinguish structurally different closure
# bodies. Two curried closures whose bodies differ only inside record
# literals apply at identical arguments; the second must see its own
# body, not the first's memoized result. Regression for the `(opaque)`
# body encoding that once collapsed record-bearing bodies. A recursive
# closure also memoizes beside non-scalar values it never reads.

emath object MemoState:
    representation:
        t: Rat
        y: sequence(Rat)

emath function MemoNeg:
    inputs:
        f: Rat -> MemoState -> MemoState
        x: Rat
    outputs:
        result: Rat
    definitions:
        rated = f(0 / 1, MemoState: {t: 0 / 1, y: [x]})
        result = rated.y[0]
    tests:
        example <neg>:
            given f = function t in Rat: function s in MemoState: MemoState: {t: t, y: [0 / 1 - s.y[0]]}
            given x = 1 / 1
            expect result == 0 - 1 / 1

emath function MemoId:
    inputs:
        f: Rat -> MemoState -> MemoState
        x: Rat
    outputs:
        result: Rat
    definitions:
        rated = f(0 / 1, MemoState: {t: 0 / 1, y: [x]})
        result = rated.y[0]
    tests:
        example <id>:
            given f = function t in Rat: function s in MemoState: MemoState: {t: t, y: [s.y[0]]}
            given x = 1 / 1
            expect result == 1 / 1

emath function MemoRecurBesideSequence:
    # A recursive closure memoizes its own calls even when the scope it
    # was made in holds a sequence it never reads. Unmemoized, fib(40)
    # is hundreds of millions of calls, far past the default work.
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        xs = [1, 2, 3]
        fib = recur f in Int -> Int: function k in Int: if k < 2: k else: f(k - 1) + f(k - 2)
        result = fib(n) + length(xs) - 3
    tests:
        example <fib_forty>:
            given n = 40
            expect result == 102334155
