# T19: L1 closed-code evaluation. quote.evaluate is GUARDED for closed
# code (unchanged for closed; open code refuses unbound_code instead of
# silently resolving free names in the ambient environment), alpha-
# equivalent code gets a deterministic canonical identity
# (quote.identity), and the closed_code query method evaluates a quoted
# target with the query inputs as the EXPLICIT input environment.
# Stale-dependency and fuel refusals are engine-seam cases in the
# carrier (constructor_carrier.rs): staleness needs two dependency
# states (capture tree + evaluate tree) and fuel needs a work budget,
# neither expressible in one .emath session.
# Expected outcome POST-L1: 6 tests pass; the two refusal tests FAIL
# with the exact named refusal `quoted code is open; unbound name(s):
# ...` (the refusal-fixture convention: the named failure signature IS
# the assertion). Run: emath test tests/fixtures/constructor/t19_l1_closed_code.emath

emath function ClosedExpr:
    inputs:
        unused: Int
    outputs:
        result: Rat
    definitions:
        result = quote.evaluate(quote(3 / 2 * 3 / 2 + 1 / 6))
    tests:
        example <closed_expression_evaluates>:
            given unused = 0
            expect result == 29 / 12

emath function ClosedFunction:
    inputs:
        unused: Int
    outputs:
        result: Rat
    definitions:
        sq = quote.evaluate(quote(function x in Rat: x * x))
        result = sq(5 / 1)
    tests:
        example <closed_function_applies>:
            given unused = 0
            expect result == 25 / 1

emath function AlphaIdentity:
    inputs:
        unused: Int
    outputs:
        same: Bool
        differs: Bool
    definitions:
        a = quote(function x in Rat: x * x)
        b = quote(function y in Rat: y * y)
        c = quote(function y in Rat: y + y)
        same = quote.identity(a) == quote.identity(b)
        differs = quote.identity(a) == quote.identity(c)
    tests:
        example <alpha_equivalent_share_identity>:
            given unused = 0
            expect same == true
            expect differs == false

emath function OpenRefuses:
    # k is bound in the AMBIENT function scope, not by the code: the
    # guarded evaluator refuses unbound_code (at HEAD this leaks the
    # ambient binding and returns 81).
    inputs:
        unused: Int
    outputs:
        result: Rat
    definitions:
        k = 9 / 1
        result = quote.evaluate(quote(k * k))
    tests:
        example <open_code_refuses>:
            given unused = 0
            expect result == result

emath function HygieneRefuses:
    # Quote made where x = 5, evaluated where x = 7: NO dynamic-scope
    # leak; the free name x is not supplied, so unbound_code (at HEAD
    # this returns 21 from the evaluation-time x).
    inputs:
        unused: Int
    outputs:
        result: Rat
    definitions:
        made = make_code(0)
        x = 7 / 1
        result = quote.evaluate(made)
    tests:
        example <no_dynamic_scope_leak>:
            given unused = 0
            expect result == result

emath function make_code:
    inputs:
        unused: Int
    outputs:
        result: Code
    definitions:
        x = 5 / 1
        result = quote(x * 3)

emath query ClosedCodeValue:
    inputs:
        unused: Int
    definitions:
        target = quote(3 / 2 * 3 / 2 + 1 / 6)
    question:
        target = target
        scope = unused
        assumptions = []
    using:
        method = closed_code
    answer:
        form = value
        accept = unchecked
    tests:
        example <closed_code_value_satisfied>:
            given unused = 0
            expect receipt.fulfillment == satisfied

emath query ClosedCodeApply:
    # The query inputs ARE the explicit input environment: x is bound
    # by the code's own binder; arg is applied through it.
    inputs:
        arg: Rat
    definitions:
        target = quote(function x in Rat: x * x)
    question:
        target = target
        scope = arg
        assumptions = []
    using:
        method = closed_code
    answer:
        form = value
        accept = unchecked
    tests:
        example <closed_code_applies_input>:
            given arg = 5 / 1
            expect receipt.fulfillment == satisfied

emath query TypeMismatch:
    # A closed function code applied to a Bool input: the named
    # refusal is type_mismatch.
    inputs:
        arg: Bool
    definitions:
        target = quote(function x in Rat: x * x)
    question:
        target = target
        scope = arg
        assumptions = []
    using:
        method = closed_code
    answer:
        form = value
        accept = unchecked
    tests:
        example <wrong_input_type_refuses>:
            given arg = true
            expect receipt.fulfillment == unmet

emath query MissingMethodStaysUnmet:
    # t18's contract is preserved: method = missing stays unmet.
    inputs:
        unused: Int
    definitions:
        target = quote(function x in Rat: x * x)
    question:
        target = target
        scope = unused
        assumptions = []
    using:
        method = missing
    answer:
        form = value
        accept = unchecked
    tests:
        example <missing_method_unmet>:
            given unused = 0
            expect receipt.fulfillment == unmet
