# Emission lane: one generic object used at two carriers. Each
# instantiation (Monoid<Int>, Monoid<Float64>) needs its own native
# layout, and a generic function over Monoid<T> reads the fields at the
# carrier its call site binds.

use fold.reduce

emath object Monoid<T>:
    # Identity element and the (curried) operation.
    representation:
        unit: T
        op: T -> T -> T

emath function adding:
    inputs:
        unit: Int
    outputs:
        result: Monoid<Int>
    definitions:
        result = Monoid: {unit: 0, op: function a in Int: function b in Int: a + b}

emath function maxing:
    inputs:
        floor: Float64
    outputs:
        result: Monoid<Float64>
    definitions:
        result = Monoid: {unit: floor, op: function a in Float64: function b in Float64: if a >= b: a else: b}

emath function crush<T>:
    # Combine every element onto the identity, left to right.
    inputs:
        m: Monoid<T>
        xs: sequence(T)
    outputs:
        result: T
    definitions:
        result = fold(function acc in T: function x in T: m.op(acc)(x), m.unit, xs)

emath function total:
    inputs:
        xs: sequence(Int)
    outputs:
        result: Int
    definitions:
        result = crush(adding(0), xs)
    tests:
        example <sums>:
            given xs = [3, 4, 5]
            expect result == 12

emath function peak:
    inputs:
        xs: sequence(Float64)
    outputs:
        result: Float64
    definitions:
        result = crush(maxing(-1.0f64), xs)
    tests:
        example <largest>:
            given xs = [0.5f64, 2.5f64, 1.0f64]
            expect result == 2.5f64
        example <empty_is_floor>:
            given xs = []
            expect result == -1.0f64

emath object VectorMap:
    representation:
        apply: sequence(Int) -> sequence(Int)

emath function powers:
    inputs:
        xs: sequence(Int)
    outputs:
        result: sequence(Int)
    definitions:
        result = map(function x in Int: int_pow(2, x), xs)

emath function mapped_powers:
    inputs:
        xs: sequence(Int)
    outputs:
        result: sequence(Int)
    definitions:
        action = VectorMap: {apply: powers}
        result = action.apply(xs)
    tests:
        example <wide_vector_function_in_a_declared_field>:
            given xs = [3, 4, 5]
            expect result == [8, 16, 32]

emath object CurriedAction:
    representation:
        apply: Int -> Int -> Int

emath function curried_total:
    inputs:
        a: Int
        b: Int
    outputs:
        result: Int
    definitions:
        action = CurriedAction: {apply: function x in Int: function y in Int: int_sum([x, y])}
        result = action.apply(a)(b)
    tests:
        example <nested_function_result_uses_the_declared_field_carrier>:
            given a = 3
            given b = 4
            expect result == 7

emath function rebuilt_curried_total:
    inputs:
        n: Int
    outputs:
        result: Bool
    definitions:
        term = quote.substitute(quote(curried_total(x, 4)), "x", n)
        value = quote.evaluate(quote.make(quote.view(term)))
        result = value == 7
    tests:
        example <rebuilt_scalar_call_retains_its_widened_entry>:
            given n = 3
            expect result == true

emath function wide_transform:
    inputs:
        exponent: Int
    outputs:
        result: Bool
    definitions:
        values = [int_pow(2, exponent)]
        doubled = map(function x in Int: x + x, values)
        squared = map(function x in Int: x * x, doubled)
        result = squared[0] == int_pow(2, 2 * exponent + 2)
    tests:
        example <exact_elements_retain_width_through_local_binders>:
            given exponent = 70
            expect result == true

emath function wide_capture:
    inputs:
        exponent: Int
    outputs:
        result: Bool
    definitions:
        twice = function xs in sequence(Int): map(function x in Int: x + x, xs)
        apply = function xs in sequence(Int): twice(xs)
        values = apply([int_pow(2, exponent)])
        result = values[0] == int_pow(2, exponent + 1)
    tests:
        example <exact_elements_retain_width_through_captured_binders>:
            given exponent = 70
            expect result == true

emath object Values:
    representation:
        terms: sequence(Int)

emath object ScalarCounter:
    representation:
        current: Int

emath function wide_scalar:
    inputs:
        count: Int
    outputs:
        result: Int
    definitions:
        state = fold(function s in ScalarCounter: function n in Int: ScalarCounter: {current: s.current * 2}, ScalarCounter: {current: 1}, range(0, count))
        result = state.current
    tests:
        example <wide_scalar_state>:
            given count = 70
            expect result == 1180591620717411303424

emath function wide_product:
    inputs:
        count: Int
    outputs:
        result: Int
    definitions:
        result = fold(function acc in Int: function n in Int: acc * 2, 1, range(0, count))
    tests:
        example <wide_scalar_accumulator>:
            given count = 70
            expect result == 1180591620717411303424

emath function wide_stored:
    inputs:
        exponent: Int
    outputs:
        result: Bool
    definitions:
        stored = Values: {terms: [int_pow(2, exponent)]}
        squared = map(function x in Int: x * x, stored.terms)
        result = squared[0] == int_pow(2, 2 * exponent)
    tests:
        example <exact_sequence_elements_survive_record_storage>:
            given exponent = 70
            expect result == true
