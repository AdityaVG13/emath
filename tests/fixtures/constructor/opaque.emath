# Opaque transform boundary. This file installed no topic identity.
use calculus.diff

emath function try_diff:
    inputs:
        unused: Int
    outputs:
        result: Code
    definitions:
        result = d_wrt(quote(mysterious(x)), quote(x))

emath query OpaqueTransform:
    inputs:
        unused: Int
    definitions:
        target = quote(mysterious(x))
    question:
        target = target
        scope = unused
        assumptions = []
    using:
        method = missing
    answer:
        form = code
        accept = unchecked
    tests:
        example <code_kept>:
            given unused = 0
            expect receipt.fulfillment == satisfied
            expect receipt.representation == code
