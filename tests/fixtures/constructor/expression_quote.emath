# Expression templates (bead emath-expression-quotes-324y0): the
# quoted program is an EXPRESSION with free names, not a wrapped
# function - no parameter, no closure. quote.substitute closes free
# names by name (the value splices as a literal), quote.evaluate
# computes the closed expression as a scalar. The carrier of each
# free name is a RUNTIME fact: the SAME template substitutes with Int
# values in one test and Rat values in another, so the native lane
# compiles the body over a value union with dynamic scalar kernels
# (the VM's exact carrier rules) instead of a monomorphic factory.
#
# Carrier laws pinned here (normative source: the constructor layer's
# ops.rs binary/neg arms): Int x Int keeps Int for +,-,* when the
# canonical denominator is 1; any Rational operand locks the Rat
# carrier forever (1/4 - 1/4 is Rat 0/1, never Int 0); division NEVER
# collapses to Int (4 / 2 is Rat 2/1). The authored expects pin the
# values; the export checkpoint pins the carriers byte-identically.
#
# Expected outcome: passes (7 authored tests) in the VM lane; the
# native export parity case lives in tests/emath-tui/tests/export_native.rs.
# Run: emath test tests/fixtures/constructor/expression_quote.emath

emath function ExprAdd:
    # The shared template: free names x and c, no parameter.
    inputs:
        unused: Int
    outputs:
        result: Code
    definitions:
        result = quote(x + c)

emath function EvalExprAddInt:
    # Int carriers: 2 + 3 is Int 5 - the integer carrier is preserved
    # (never Rat 5/1) when both operands are Int and the canonical
    # denominator is 1.
    inputs:
        c: Int
        x: Int
    outputs:
        result: Int
    definitions:
        cand0 = quote.substitute(ExprAdd(0), "c", c)
        cand1 = quote.substitute(cand0, "x", x)
        result = quote.evaluate(cand1)
    tests:
        example <int_operands_keep_int>:
            given c = 3
            given x = 2
            expect result == 5

emath function EvalExprAddRat:
    # Rat carriers through the SAME template: the values arrive as
    # rationals, so the union lane must not have committed to Int.
    inputs:
        c: Rat
        x: Rat
    outputs:
        result: Rat
    definitions:
        cand0 = quote.substitute(ExprAdd(0), "c", c)
        cand1 = quote.substitute(cand0, "x", x)
        result = quote.evaluate(cand1)
    tests:
        example <rat_operands_same_template>:
            given c = 3 / 1
            given x = 2 / 1
            expect result == 5 / 1

emath function ExprMixed:
    # A mixed-carrier expression: x * c is Int when both are Int, but
    # the rational constant 1/2 locks the whole result into Rat (any
    # Rat operand locks the carrier - the artifact ABI never
    # collapses).
    inputs:
        unused: Int
    outputs:
        result: Code
    definitions:
        result = quote(x * c + 1 / 2)

emath function EvalExprMixed:
    inputs:
        c: Int
        x: Int
    outputs:
        result: Rat
    definitions:
        cand0 = quote.substitute(ExprMixed(0), "c", c)
        cand1 = quote.substitute(cand0, "x", x)
        result = quote.evaluate(cand1)
    tests:
        example <rational_constant_locks_rat>:
            given c = 3
            given x = 5
            expect result == 31 / 2

emath function ExprDiv:
    # Division NEVER collapses to Int: 4 / 2 is Rat 2/1 (the Int
    # collapse arm matches +,-,* only).
    inputs:
        unused: Int
    outputs:
        result: Code
    definitions:
        result = quote(x / c)

emath function EvalExprDiv:
    inputs:
        c: Int
        x: Int
    outputs:
        result: Rat
    definitions:
        cand0 = quote.substitute(ExprDiv(0), "c", c)
        cand1 = quote.substitute(cand0, "x", x)
        result = quote.evaluate(cand1)
    tests:
        example <division_stays_rational>:
            given c = 2
            given x = 4
            expect result == 2 / 1

emath function ExprBool:
    # A Bool-valued expression template.
    inputs:
        unused: Int
    outputs:
        result: Code
    definitions:
        result = quote(p and q)

emath function EvalExprBool:
    inputs:
        p: Bool
        q: Bool
    outputs:
        result: Bool
    definitions:
        cand0 = quote.substitute(ExprBool(0), "q", q)
        cand1 = quote.substitute(cand0, "p", p)
        result = quote.evaluate(cand1)
    tests:
        example <bool_expression_evaluates>:
            given p = true
            given q = false
            expect result == false

emath function ExprRatCollapse:
    # 1/4 - 1/4 is Rat 0/1, never Int 0: a Rational operand locks the
    # carrier forever (the collapse arm needs BOTH operands Int). The
    # authored expect pins the value; the export checkpoint pins the
    # CARRIER (byte-identical cross-lane).
    inputs:
        unused: Int
    outputs:
        result: Code
    definitions:
        result = quote(a - b)

emath function EvalExprRatCollapse:
    inputs:
        a: Rat
        b: Rat
    outputs:
        result: Rat
    definitions:
        cand0 = quote.substitute(ExprRatCollapse(0), "b", b)
        cand1 = quote.substitute(cand0, "a", a)
        result = quote.evaluate(cand1)
    tests:
        example <rational_zero_never_collapses>:
            given a = 1 / 4
            given b = 1 / 4
            expect result == 0 / 1

# --- The session surface (the export seam) ---
#
# The same search as the program-space dream, but the prediction runs
# through the EXPRESSION template: substitute the constant key AND the
# case input by name, then evaluate the closed expression to a scalar
# directly - no closure, no application step. Every probe exercises
# the dynamic-carrier chain end to end. The world wants i*1 + 1/2;
# only k = 1 masters all five cases.

use search.archive
use search.research

emath function expr_world:
    # w(i) = i + 1/2.
    inputs:
        unused: Int
    outputs:
        result: sequence(Rat)
    definitions:
        result = [1 / 2, 3 / 2, 5 / 2, 7 / 2, 9 / 2]

emath function expr_pred:
    # The expression-lane prediction: key k IS the substituted
    # constant, case input i the substituted x. pred(i) = i*k + 1/2.
    inputs:
        k: Rat
        i: Rat
    outputs:
        result: Rat
    definitions:
        cand0 = quote.substitute(ExprMixed(0), "c", k)
        cand1 = quote.substitute(cand0, "x", i)
        result = quote.evaluate(cand1)

emath function expr_case_error:
    # 1 if key k mispredicts case i, else 0.
    inputs:
        k: Rat
        i: Int
    outputs:
        result: Int
    definitions:
        result = if expr_pred(k, i / 1) == expr_world(0)[i]: 0 else: 1

emath function expr_errors_at:
    # k's error count over the case ids from position j.
    inputs:
        k: Rat
        ids: sequence(Int)
        j: Int
    outputs:
        result: Int
    definitions:
        done = j >= length(ids)
        one = if done: 0 else: expr_case_error(k, ids[j])
        result = if done: 0 else: one + expr_errors_at(k, ids, j + 1)

emath function expr_first_wrong:
    # The smallest case ordinal in ids that k mispredicts (-1 = none).
    inputs:
        k: Rat
        ids: sequence(Int)
        j: Int
    outputs:
        result: Int
    definitions:
        done = j >= length(ids)
        c = if done: -1 else: ids[j]
        result = if done: -1 else: if expr_case_error(k, c) == 1: c else: expr_first_wrong(k, ids, j + 1)

emath function MakeValueOf:
    # The canonical parameter: the key is the constant itself.
    inputs:
        unused: Int
    outputs:
        result: Int -> Rat
    definitions:
        result = function k in Int: k / 1

emath function MakeAdmit:
    # The constant domain: k in 0..6.
    inputs:
        unused: Int
    outputs:
        result: Int -> Bool
    definitions:
        result = function k in Int: k >= 0 and k <= 6

emath function MakeMoves:
    # The ladder: step the constant by one either way; admit gates
    # the domain edges.
    inputs:
        unused: Int
    outputs:
        result: Int -> sequence(Int)
    definitions:
        result = function k in Int: [k - 1, k + 1]

emath function MakeFamilyOf:
    inputs:
        unused: Int
    outputs:
        result: Int -> Int
    definitions:
        result = function k in Int: 0

emath function MakeQuota:
    # Whole-domain capacity: every batch can propose the ladder.
    inputs:
        unused: Int
    outputs:
        result: Int -> Int
    definitions:
        result = function f in Int: 7

emath function MakeScore:
    # The probe and verify tier (one truth): k's error count over the
    # frozen case set, as an exact rational - through the expression
    # lane's only scorer.
    inputs:
        unused: Int
    outputs:
        result: Int -> CaseSet -> Rat
    definitions:
        result = function k in Int: function cs in CaseSet: expr_errors_at(k / 1, cs.ids, 0) / 1

emath function MakeWitness:
    inputs:
        unused: Int
    outputs:
        result: Int -> CaseSet -> Int
    definitions:
        result = function k in Int: function cs in CaseSet: expr_first_wrong(k / 1, cs.ids, 0)

emath function MakeHardOk:
    inputs:
        unused: Int
    outputs:
        result: Int -> Bool
    definitions:
        result = function k in Int: true

emath function MakeGoalMet:
    # Exact mastery of the frozen set closes the run.
    inputs:
        unused: Int
    outputs:
        result: Rat -> Bool
    definitions:
        result = function s in Rat: s == 0 / 1

emath function MakeBetter:
    # Fewer errors is better, strictly (better(x, y) = x beats y).
    inputs:
        unused: Int
    outputs:
        result: Rat -> Rat -> Bool
    definitions:
        result = function a in Rat: function b in Rat: a < b

emath function MakeNextCases:
    # No curriculum: the full world is frozen from the seed.
    inputs:
        unused: Int
    outputs:
        result: Int -> CaseSet -> CaseSet
    definitions:
        result = function k in Int: function cs in CaseSet: cs

emath function SeedExpr:
    # Archive mode, seeded at the trivial constant k = 0 on the full
    # frozen world (pred = 1/2 constant: 4 of 5 cases mispredicted).
    inputs:
        unused: Int
    outputs:
        result: LoopState
    definitions:
        result = research_seed(0, MakeValueOf(0), CaseSet: {ids: [0, 1, 2, 3, 4]}, MakeScore(0), MakeWitness(0), 1, 0, 1, 1)

emath function StepExpr:
    # One batch of the expression-lane target over explicit state: the
    # session surface a loop host steps batch by batch.
    inputs:
        state: LoopState
        budget: Int
    outputs:
        result: LoopState
    definitions:
        result = research_batch(state, MakeValueOf(0), MakeAdmit(0), MakeMoves(0), MakeFamilyOf(0), MakeQuota(0), MakeScore(0), MakeScore(0), MakeWitness(0), MakeHardOk(0), MakeGoalMet(0), MakeBetter(0), MakeNextCases(0), budget)

emath function RunExpr:
    # The straight walk: the seed at k = 0 (score 4), then the ladder
    # proposes k = 1 - pred(i) = i + 1/2 masters the whole world. The
    # run closes goal_attained and stays closed.
    inputs:
        unused: Int
    outputs:
        winner: Int
        verdict: Int
        errors: Int
    definitions:
        s0 = SeedExpr(0)
        s1 = StepExpr(s0, 60)
        s2 = StepExpr(s1, 60)
        winner = s2.archive[s2.incumbent].key
        verdict = s2.verdict
        errors = expr_errors_at(winner / 1, [0, 1, 2, 3, 4], 0)
    tests:
        example <expression_lane_session_master>:
            given unused = 0
            expect winner == 1
            expect verdict == 1
            expect errors == 0
