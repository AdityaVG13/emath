# A function that calls itself from inside a closure it passes to a
# fold (`any(function k in Code: mentions(k, var), kids)`): the shape
# of the search modules' structural walks (certify's `mentions`,
# optimize's `instantiate`). The closure's call is the enclosing
# function's recursion, not a field projection or an unknown name.
use fold.reduce
use exact.integers

emath function leaves:
    # Fibonacci by a tree of calls, each level mapped by a closure
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = if n < 2: 1 else: sum(map(function k in Int: leaves(k), [n - 1, n - 2]))
    tests:
        example <ten>:
            given n = 10
            expect result == 89

emath function mentions:
    # whether a local named like var occurs anywhere in c
    inputs:
        c: Code
        var: Code
    outputs:
        result: Bool
    definitions:
        v = quote.view(c)
        here = if v.kind == Local: v.name == quote.view(var).name else: false
        kids = if v.kind == Call: v.args else: []
        result = here or any(function k in Code: mentions(k, var), kids)

emath function finds_x:
    inputs:
        k: Int
    outputs:
        result: Bool
    definitions:
        result = mentions(quote.substitute(quote(y * (x + c)), "c", k), quote(x))
    tests:
        example <deep_local>:
            given k = 2
            expect result == true

emath function misses_z:
    inputs:
        k: Int
    outputs:
        result: Bool
    definitions:
        result = mentions(quote.substitute(quote(y * (x + c)), "c", k), quote(z))
    tests:
        example <absent>:
            given k = 2
            expect result == false

emath function big_literals:
    # how many literal leaves exceed 2: a viewed literal's value orders
    inputs:
        c: Code
    outputs:
        result: Int
    definitions:
        v = quote.view(c)
        here = if v.kind == Literal: (if v.value > 2: 1 else: 0) else: 0
        kids = if v.kind == Call: v.args else: []
        result = here + sum(map(function k in Code: big_literals(k), kids))

emath function counts_big:
    inputs:
        k: Int
    outputs:
        result: Int
    definitions:
        result = big_literals(quote.substitute(quote(x * c + 1 + 5), "c", k))
    tests:
        example <three_and_five>:
            given k = 3
            expect result == 2

emath function twice:
    inputs:
        d: Int
    outputs:
        result: Int
    definitions:
        result = d * 2

emath function twice_literal:
    # a viewed literal's value passed to an Int input
    inputs:
        k: Int
    outputs:
        result: Int
    definitions:
        result = twice(quote.view(quote.substitute(quote(c), "c", k)).value)
    tests:
        example <four>:
            given k = 4
            expect result == 8

emath function is_x:
    # a list joined from a Code arm and a viewed-child arm, its element
    # handed to a Code closure
    inputs:
        c: Code
    outputs:
        result: Bool
    definitions:
        v = quote.view(c)
        target = if v.kind == Local: [c] else: if v.kind == Call: [v.args[0]] else: []
        same = function f in Code: quote.identity(f) == quote.identity(quote(x))
        result = if length(target) == 1: same(target[0]) else: false

emath function x_first:
    inputs:
        k: Int
    outputs:
        result: Bool
    definitions:
        result = is_x(quote.substitute(quote(x + c), "c", k)) and is_x(if k > 0: quote(x) else: quote(y))
    tests:
        example <both_arms>:
            given k = 1
            expect result == true

emath function call_shapes:
    # a call-shape template (`range` over code, not scalar arithmetic)
    # viewed after substitution, and a substitute into a viewed child
    inputs:
        k: Int
    outputs:
        result: Bool
    definitions:
        bound = quote.view(quote.view(quote.substitute(quote(range(0, x)), "x", k)).args[1]).value
        child = quote.view(quote(y + c)).args[1]
        result = bound == k and quote.evaluate(quote.substitute(child, "c", k + 1)) == k + 1
    tests:
        example <five>:
            given k = 5
            expect result == true

emath function plug:
    # replace every local in c by value, rebuilding the calls
    inputs:
        c: Code
        value: Code
    outputs:
        result: Code
    definitions:
        n = quote.view(c)
        result = if n.kind == Local: value else: if n.kind == Call: quote.make(Call: {callee: n.callee, args: map(function a in Code: plug(a, value), n.args)}) else: c

emath function plugged:
    # x * x + 1 at x = k
    inputs:
        k: Int
    outputs:
        result: Int
    definitions:
        result = quote.evaluate(plug(quote(x * x + 1), quote.substitute(quote(c), "c", k)))
    tests:
        example <three>:
            given k = 3
            expect result == 10

emath function digits:
    # base-3 digits of n, lowest first: the self-call sits inside a literal applied on the spot
    inputs:
        n: Int
    outputs:
        result: sequence(Int)
    definitions:
        result = if n == 0: [] else: (function base in Int: [n - quot_int(n, base) * base, ..digits(quot_int(n, base))])(3)
    tests:
        example <base_three>:
            given n = 11
            expect result == [2, 0, 1]

emath function applied_recur:
    # a recur applied on the spot: its self-calls are its own, not the enclosing function's
    inputs:
        n: Int
        k: Int
    outputs:
        result: Int
    definitions:
        result = (recur f in Int -> Int: function m in Int: if m < 2: m else: f(m - 1) + f(m - 2))(n - k)
    tests:
        example <fib_ten>:
            given n = 12
            given k = 2
            expect result == 55

emath object Pair2:
    # a two-input function carried as a field
    representation:
        apply: Int -> Int -> Int
        cap: Int

emath function pair_apply:
    # a function-typed field bound to a local, then called directly and inside a closure
    inputs:
        blk: Pair2
        a: Int
        b: Int
    outputs:
        result: Int
    definitions:
        h = blk.apply
        result = h(a, b) + sum(map(function i in Int: h(a + i, b), [0, blk.cap]))

emath function paired:
    inputs:
        k: Int
    outputs:
        result: Int
    definitions:
        result = pair_apply(Pair2: {apply: function x in Int: function y in Int: x * 10 + y, cap: 1}, k, k + 1)
    tests:
        example <two>:
            given k = 2
            expect result == 79

emath function one_rewrite:
    inputs:
        t: Code
        r: Int
    outputs:
        result: sequence(Code)
    definitions:
        result = if r > 0: [quote.substitute(t, "c", r)] else: []

emath function collect_rewrites:
    # a fold whose seed is `[]`: its carrier comes from the step closure's sequence(Code) accumulator
    inputs:
        rules: sequence(Int)
        t: Code
    outputs:
        result: sequence(Code)
    definitions:
        result = fold(function acc in sequence(Code): function r in Int: concat(acc, one_rewrite(t, r)), [], rules)

emath function rewrite_total:
    inputs:
        k: Int
    outputs:
        result: Int
    definitions:
        cs = collect_rewrites([k, 0 - k, k + 1], quote(x * c))
        result = length(cs) * 100 + quote.evaluate(quote.substitute(cs[length(cs) - 1], "x", 2))
    tests:
        example <three>:
            given k = 3
            expect result == 208
