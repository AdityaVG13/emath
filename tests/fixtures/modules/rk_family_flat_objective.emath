# The RK-family flat-objective gate.
# Three-stage order-3 explicit family: c = (0, a, 1), a21 = a,
# a32 = (1-a)/(a(2-3a)), a31 = 1 - a32, b2 = 1/(6a(1-a)),
# b3 = (2-3a)/(6(1-a)), b1 = 1 - b2 - b3 (a not in {0, 1, 2/3}).
# The order conditions b^T 1 = 1, b^T c = 1/2, b^T c^2 = 1/3, b^T A c = 1/6
# hold exactly for every member. These same quantities ARE the
# scalar-linear stability polynomial coefficients (z, z^2, z^3): order 3
# fixes every coefficient through degree 3 to the truncated exponential, so
# the linear objective is FLAT across the family. On y' = y^2, y(0) = 1,
# h = 1/10 (exact solution 10/9) the five members a in {1/4, 1/3, 1/2,
# 3/4, 4/5} produce five DIFFERENT exact one-step absolute errors: the
# nonlinear observation is not flat.

emath function RkFamilyFlatObjective:
    inputs:
        a: Rat
    outputs:
        oc_row_sum: Rat
        oc_btc: Rat
        oc_btc2: Rat
        oc_btac: Rat
        one_step_error: Rat
    definitions:
        a21 = a
        a32 = (1 - a) / (a * (2 - 3 * a))
        a31 = 1 - a32
        b2 = 1 / (6 * a * (1 - a))
        b3 = (2 - 3 * a) / (6 * (1 - a))
        b1 = 1 - b2 - b3
        # Order conditions; oc_btc doubles as the z^2 stability coefficient
        # (a31 + a32 = 1 = c3) and oc_btac as the z^3 coefficient
        # (b3 * a32 * a21) - the flatness IS these pinned values.
        oc_row_sum = b1 + b2 + b3
        oc_btc = b2 * a + b3
        oc_btc2 = b2 * a * a + b3
        oc_btac = b3 * a32 * a
        # One explicit step on y' = y^2 from y0 = 1 with h = 1/10.
        h = 1 / 10
        k1 = 1 / 1
        y2arg = 1 + h * a21 * k1
        k2 = y2arg * y2arg
        y3arg = 1 + h * (a31 * k1 + a32 * k2)
        k3 = y3arg * y3arg
        y1 = 1 + h * (b1 * k1 + b2 * k2 + b3 * k3)
        diff = y1 - 10 / 9
        one_step_error = if diff < 0: 0 - diff else: diff
    tests:
        example <flat_conditions_error_a_quarter>:
            given a = 1 / 4
            expect oc_row_sum == 1 / 1
            expect oc_btc == 1 / 2
            expect oc_btc2 == 1 / 3
            expect oc_btac == 1 / 6
            expect one_step_error == 448951 / 14400000000
        example <flat_conditions_error_a_third>:
            given a = 1 / 3
            expect oc_row_sum == 1 / 1
            expect oc_btc == 1 / 2
            expect oc_btc2 == 1 / 3
            expect oc_btac == 1 / 6
            expect one_step_error == 22379 / 810000000
        example <flat_conditions_error_a_half>:
            given a = 1 / 2
            expect oc_row_sum == 1 / 1
            expect oc_btc == 1 / 2
            expect oc_btc2 == 1 / 3
            expect oc_btac == 1 / 6
            expect one_step_error == 13757 / 720000000
        example <flat_conditions_error_a_three_quarters>:
            given a = 3 / 4
            expect oc_row_sum == 1 / 1
            expect oc_btc == 1 / 2
            expect oc_btc2 == 1 / 3
            expect oc_btac == 1 / 6
            expect one_step_error == 69467 / 2880000000
        example <flat_conditions_error_a_four_fifths>:
            given a = 4 / 5
            expect oc_row_sum == 1 / 1
            expect oc_btc == 1 / 2
            expect oc_btc2 == 1 / 3
            expect oc_btac == 1 / 6
            expect one_step_error == 329 / 17578125
