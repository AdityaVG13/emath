# Module acceptance fixture: exhaustive uniqueness of the training
# winner. alpha = 2/15 (n = 16) is the UNIQUE minimizer of the
# certified one-step error over the whole 31-point training grid —
# verified by exhaustive scan, not by local descent.
# Expected outcome: passes (1 authored test).
# Run: emath test tests/fixtures/modules/integrator_contract_unique.emath

use search.order_contract_demo
use search.fitting

emath function UniqueTraining:
    inputs:
        unused: Int
    outputs:
        result: Bool
    definitions:
        enc = exp_enclosure(1 / 1)
        score = function n in Int: grid_score(n, 1 / 1, enc.lo, enc.hi)
        result = verify_exhaustive(domain_list(0, 30), score, 16)
    tests:
        example <two_fifteenths_unique>:
            given unused = 0
            expect result == true
