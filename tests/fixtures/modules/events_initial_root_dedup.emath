# Module acceptance fixture: a root AT the initial time fires exactly
# once. y' = 1 from y = 0 with guard y: the root sits at theta = 0 of
# the first segment; the same-instant refire is suppressed on the next
# segment; the rollout completes with one event.
# Expected outcome: passes (1 authored test).
# Run: emath test tests/fixtures/modules/events_initial_root_dedup.emath

use analysis.evolution.one_step
use analysis.evolution.events

emath function InitialRoot:
    inputs:
        unused: Int
    outputs:
        result: EventRun
    definitions:
        grow = function t in Rat: function s in SimState: SimState: {t: t, y: [1 / 1]}
        result = event_rollout(grow, cash_karp_pair(0), 4, 5, [1 / 4], [1 / 4], 3 / 4, 1 / 4, 3 / 4, 8, 4, [Event: {guard: function t in Rat: function s in SimState: s.y[0], direction: 1, terminal: false, priority: 0, reset: function s in SimState: s}], SimState: {t: 0 / 1, y: [0 / 1]}, 3 / 2)
    tests:
        example <fires_once_at_zero>:
            given unused = 0
            expect result == EventRun: {t: 3 / 2, y: [3 / 2], complete: true, attempts_used: 3, rejections: 0, events_fired: 1, outcome: 0}
