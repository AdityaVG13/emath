# Module acceptance fixture: one loop engine, two unchanged targets.
# The engine is one and the same imported research_batch; only the
# target closures differ between the two functions below.
# (a) The Stage 2 bounded inverse-fitting target: the damped oscillator
# x' = v, v' = -x - c*v observed with forward Euler at truth c = 1/2
# (h = 1/4, 2 steps, initial state (1, 0)), domain c = k/4, k = 0..4.
# The loop in incumbent-only mode is the strict-improvement hillclimb:
# 0 -> 1/4 -> 1/2, one promoted record per batch, ending at exact SSE
# zero (verdict goal_attained) with a parent-linked archive chain -
# the same walk shape as search.fitting's hillclimb_archive chain.
# (b) The Stage 3 finite-counterexample target: a declared 4-state game
# graph (controller 0 -> {1, 3}, adversary 1 -> {2, 0}, goal 2,
# controller dead end 3). The target asks for a state that is WITNESS
# but NOT FORCED - the counterexample to "the controller forces the
# goal from every state". Verification recomputes both sets
# independently (witness_set and attractor_set); state 0 is the first
# verified counterexample in proposal order.
# The two targets are two functions in one file, not one function with
# both def sets: the reference VM deep-clones captured closure
# environments per application, so a single body would nest the fit
# closure tree inside every reach closure clone (minutes of cloning
# instead of seconds). The engine-generality claim is about the loop
# module, which both functions call unchanged. The fitting instance is
# deliberately small (2 steps, 3-record chain) for the same reason;
# the claim is generality, not instance size.
# Expected outcome: passes (2 authored tests).
# Run: emath test tests/fixtures/modules/research_loop_targets.emath

use analysis.evolution.one_step
use analysis.evolution.trajectories
use discrete.reachability
use search.experiments
use search.fitting
use search.research

emath function SameEngineFittingTarget:
    inputs:
        unused: Int
    outputs:
        fit_winner_value: Rat
        fit_verdict: Int
        fit_chain_len: Int
        fit_lineage: Bool
    definitions:
        fam = function c in Rat: function t in Rat: function s in SimState: SimState: {t: t, y: [s.y[1], 0 / 1 - s.y[0] - c * s.y[1]]}
        s0 = SimState: {t: 0 / 1, y: [1 / 1, 0 / 1]}
        data_rows = rollout_trace(fam(1 / 2), euler_tableau(0), 1, 1 / 4, 2, s0)
        fit_score = function k in Int: function cs in CaseSet: sse_eval(fam, 0, k / 4, data_rows, s0, 1 / 4, 2)
        fit_value = function k in Int: k / 4
        fit_admit = function k in Int: k >= 0 and k <= 4
        fit_moves = function k in Int: if k == 0: [1] else: if k == 4: [3] else: [k - 1, k + 1]
        fam_of = function k in Int: 0
        quota = function f in Int: 9
        witness_of = function k in Int: function cs in CaseSet: -1
        hard_ok = function k in Int: true
        goal_zero = function s in Rat: s == 0 / 1
        better_min = function a in Rat: function b in Rat: a < b
        keep_set = function k in Int: function cs in CaseSet: cs
        fs = research_seed(0, fit_value, CaseSet: {ids: []}, fit_score, witness_of, 5, 0, 1, 0)
        f1 = research_batch(fs, fit_value, fit_admit, fit_moves, fam_of, quota, fit_score, fit_score, witness_of, hard_ok, goal_zero, better_min, keep_set, 60)
        f2 = research_batch(f1, fit_value, fit_admit, fit_moves, fam_of, quota, fit_score, fit_score, witness_of, hard_ok, goal_zero, better_min, keep_set, 60)
        fit_winner_value = f2.archive[f2.incumbent].value
        fit_verdict = f2.verdict
        fit_chain_len = length(f2.archive)
        fit_lineage = f2.archive[1].parent == 0 and f2.archive[2].parent == 1
    tests:
        example <fitting_target_walks_to_half>:
            given unused = 0
            expect fit_winner_value == 2 / 4
            expect fit_verdict == 1
            expect fit_chain_len == 3
            expect fit_lineage == true

emath function SameEngineReachTarget:
    inputs:
        unused: Int
    outputs:
        reach_winner: Int
        reach_verdict: Int
        reach_witness_set: sequence(Int)
        reach_forced_set: sequence(Int)
    definitions:
        g = GameGraph: {succs: [[1, 3], [2, 0], [], []], controllers: [0, 3], goals: [2]}
        ws = witness_set(g)
        att = attractor_set(g)
        reach_score = function k in Int: function cs in CaseSet: if seq_has(ws, k, 0) and not seq_has(att, k, 0): 0 / 1 else: 1 / 1
        reach_value = function k in Int: k / 1
        reach_admit = function k in Int: k >= 0 and k <= 3
        reach_moves = function k in Int: [0, 1, 2]
        fam_of = function k in Int: 0
        quota = function f in Int: 9
        witness_of = function k in Int: function cs in CaseSet: -1
        hard_ok = function k in Int: true
        goal_zero = function s in Rat: s == 0 / 1
        better_min = function a in Rat: function b in Rat: a < b
        keep_set = function k in Int: function cs in CaseSet: cs
        rs = research_seed(3, reach_value, CaseSet: {ids: []}, reach_score, witness_of, 6, 0, 1, 1)
        r1 = research_batch(rs, reach_value, reach_admit, reach_moves, fam_of, quota, reach_score, reach_score, witness_of, hard_ok, goal_zero, better_min, keep_set, 15)
        reach_winner = r1.archive[r1.incumbent].key
        reach_verdict = r1.verdict
        reach_witness_set = ws
        reach_forced_set = att
    tests:
        example <reachability_target_finds_counterexample>:
            given unused = 0
            expect reach_winner == 0
            expect reach_verdict == 1
            expect reach_witness_set == [0, 1, 2]
            expect reach_forced_set == [2]
