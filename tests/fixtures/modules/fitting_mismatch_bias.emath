# Module acceptance fixture: the integrator-mismatch control at full
# scale. Observations generated by exact RK4 at truth c = 1/2 (16 steps,
# h = 1/8) while the fit rolls Euler: the best grid coefficient is 5/8
# with a POSITIVE exact residual that strictly beats c = 1/2. Exact
# arithmetic did not remove the discretization bias — dropping this
# control would let the 5/8 result silently disappear.
# Expected outcome: passes (1 authored test).
# Run: emath test tests/fixtures/modules/fitting_mismatch_bias.emath

use analysis.evolution.one_step
use analysis.evolution.trajectories
use search.fitting

emath function MismatchBias:
    inputs:
        unused: Int
    outputs:
        best: Int
        positive: Bool
        beats_half: Bool
    definitions:
        fam = function c in Rat: function t in Rat: function s in SimState: SimState: {t: t, y: [s.y[1], 0 / 1 - s.y[0] - c * s.y[1]]}
        s0 = SimState: {t: 0 / 1, y: [1 / 1, 0 / 1]}
        rk_data = rollout_trace(fam(1 / 2), rk4_tableau(0), 4, 1 / 8, 16, s0)
        score = function k in Int: sse_eval(fam, 0, k / 8, rk_data, s0, 1 / 8, 16)
        best = argmin_first(domain_list(0, 16), score)
        positive = sse_eval(fam, 0, 5 / 8, rk_data, s0, 1 / 8, 16) > 0 / 1
        beats_half = sse_eval(fam, 0, 5 / 8, rk_data, s0, 1 / 8, 16) < sse_eval(fam, 0, 4 / 8, rk_data, s0, 1 / 8, 16)
    tests:
        example <five_eighths_positive_bias>:
            given unused = 0
            expect best == 5
            expect positive == true
            expect beats_half == true
