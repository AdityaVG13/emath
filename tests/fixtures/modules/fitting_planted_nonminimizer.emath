# Module acceptance fixture: a planted non-minimizer is rejected by the
# exhaustive verification. At E1 full scale (Euler observations, 16
# steps, h = 1/8, domain k = 0..16), claiming c = 3/8 as the minimizer
# fails: the scan finds c = 1/2. Removing the verification step would
# let this planted claim pass silently.
# Expected outcome: passes (1 authored test).
# Run: emath test tests/fixtures/modules/fitting_planted_nonminimizer.emath

use analysis.evolution.one_step
use analysis.evolution.trajectories
use search.fitting

emath function PlantedNonMinimizer:
    inputs:
        unused: Int
    outputs:
        planted: Bool
    definitions:
        fam = function c in Rat: function t in Rat: function s in SimState: SimState: {t: t, y: [s.y[1], 0 / 1 - s.y[0] - c * s.y[1]]}
        s0 = SimState: {t: 0 / 1, y: [1 / 1, 0 / 1]}
        data_rows = rollout_trace(fam(1 / 2), euler_tableau(0), 1, 1 / 8, 16, s0)
        score = function k in Int: sse_eval(fam, 0, k / 8, data_rows, s0, 1 / 8, 16)
        planted = verify_exhaustive(domain_list(0, 16), score, 3)
    tests:
        example <three_eighths_rejected>:
            given unused = 0
            expect planted == false
