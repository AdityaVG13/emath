# Module acceptance fixture: exhaustive 17-candidate verification of the
# The bounded inverse fit. c = 1/2 is the UNIQUE minimizer of the exact SSE over the whole
# domain c = k/8, k = 0..16 (Euler observations, 16 steps, h = 1/8).
# Expected outcome: passes (1 authored test).
# Run: emath test tests/fixtures/modules/fitting_unique_minimizer.emath

use analysis.evolution.one_step
use analysis.evolution.trajectories
use search.fitting

emath function UniqueMinimizer:
    inputs:
        unused: Int
    outputs:
        result: Bool
    definitions:
        fam = function c in Rat: function t in Rat: function s in SimState: SimState: {t: t, y: [s.y[1], 0 / 1 - s.y[0] - c * s.y[1]]}
        s0 = SimState: {t: 0 / 1, y: [1 / 1, 0 / 1]}
        data_rows = rollout_trace(fam(1 / 2), euler_tableau(0), 1, 1 / 8, 16, s0)
        score = function k in Int: sse_eval(fam, 0, k / 8, data_rows, s0, 1 / 8, 16)
        result = verify_exhaustive(domain_list(0, 16), score, 4)
    tests:
        example <half_unique>:
            given unused = 0
            expect result == true
