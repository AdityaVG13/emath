# Module acceptance fixture: the explicit chatter outcome. The reset
# moves the state BACK below the threshold every time, so every
# accepted segment re-crosses; the event budget terminates with
# outcome 2 (chatter) at the third firing.
# Expected outcome: passes (1 authored test).
# Run: emath test tests/fixtures/modules/events_chatter_budget.emath

use analysis.evolution.one_step
use analysis.evolution.events

emath function Chatter:
    inputs:
        unused: Int
    outputs:
        result: EventRun
    definitions:
        grow = function t in Rat: function s in SimState: SimState: {t: t, y: [1 / 1]}
        result = event_rollout(grow, cash_karp_pair(0), 4, 5, [1 / 4], [1 / 4], 3 / 4, 1 / 4, 3 / 4, 16, 3, [Event: {guard: function t in Rat: function s in SimState: s.y[0] - 3 / 4, direction: 1, terminal: false, priority: 0, reset: function s in SimState: SimState: {t: s.t, y: [0 / 1]}}], SimState: {t: 0 / 1, y: [0 / 1]}, 4 / 1)
    tests:
        example <budget_terminates_chatter>:
            given unused = 0
            expect result == EventRun: {t: 9 / 4, y: [0 / 1], complete: false, attempts_used: 3, rejections: 0, events_fired: 3, outcome: 2}
