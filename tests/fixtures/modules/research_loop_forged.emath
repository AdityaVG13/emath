# Module acceptance fixture: the E5c forged-acceptance control through
# the research loop.
# True scores: key 0 -> 5 (the seed), key 1 -> 0 (the honest best),
# key 2 -> 2, key 3 -> 0 but its hard condition fails (reduced
# coverage - the target refuses to promote it). A FORGED record for
# key 2 is injected into the archive claiming score 0 with no loop
# verification behind it. The loop never trusts the claim: the
# freshness law re-verifies the record (charging for it), the claimed
# score is overwritten by the recomputed exact 2, and acceptance
# recomputes every challenger - the honest key 1 wins, the reduced-
# coverage key 3 is rejected by the hard gate, and the forged record
# is never promoted.
# Expected outcome: passes (1 authored test).
# Run: emath test tests/fixtures/modules/research_loop_forged.emath

use search.archive
use search.research

emath function ForgedAcceptance:
    inputs:
        unused: Int
    outputs:
        winner_key: Int
        forged_final: Rat
        forged_tier: Int
        forged_accepted: Bool
        reduced_coverage_rejected: Bool
        charged: Int
    definitions:
        tscore = function k in Int: function cs in CaseSet: if k == 0: 5 / 1 else: if k == 1: 0 / 1 else: if k == 2: 2 / 1 else: 0 / 1
        seed_rec = ResearchCandidate: {key: 0, value: 0 / 1, parent: -1, move: -1, family: -1, target_id: 3, evaluator_id: 0, input_id: 1, tier: 0, score: 5 / 1, bound: 5 / 1, witness: -1, counterexample: -1, refusal: 0, accepted: true, retained: true}
        forged_rec = ResearchCandidate: {key: 2, value: 2 / 1, parent: -1, move: -1, family: -1, target_id: 3, evaluator_id: 0, input_id: 1, tier: 0, score: 0 / 1, bound: 0 / 1, witness: -1, counterexample: -1, refusal: 0, accepted: false, retained: true}
        st = LoopState: {archive: [seed_rec, forged_rec], incumbent: 0, case_set: CaseSet: {ids: []}, batch: 0, used: 1, verdict: 0, mode: 1}
        value_of = function k in Int: k / 1
        admit = function k in Int: k >= 0 and k <= 3
        moves = function k in Int: if k == 0: [1, 3] else: []
        family_of = function k in Int: 0
        quota = function f in Int: 9
        witness_of = function k in Int: function cs in CaseSet: -1
        hard_ok = function k in Int: k != 3
        goal_met = function s in Rat: s == 0 / 1
        better = function a in Rat: function b in Rat: a < b
        next_cases = function k in Int: function cs in CaseSet: cs
        b1 = research_batch(st, value_of, admit, moves, family_of, quota, tscore, tscore, witness_of, hard_ok, goal_met, better, next_cases, 20)
        winner_key = b1.archive[b1.incumbent].key
        forged_final = b1.archive[1].score
        forged_tier = b1.archive[1].tier
        forged_accepted = b1.archive[1].accepted
        reduced_coverage_rejected = not b1.archive[3].accepted
        charged = b1.used
    tests:
        example <forged_claim_recomputed_not_trusted>:
            given unused = 0
            expect winner_key == 1
            expect forged_final == 2 / 1
            expect forged_tier == 1
            expect forged_accepted == false
            expect reduced_coverage_rejected == true
            expect charged == 9
