# spatial-3d: rank-3 gradients, anisotropic Laplacian, and divergence.

emath function Spatial3d:
    inputs:
        line: Vector[3]
        plane_x: Matrix[3, 3]
        plane_y: Matrix[3, 3]
        u: Tensor[3, 3, 3]
        vx: Tensor[3, 3, 3]
        vy: Tensor[3, 3, 3]
        vz: Tensor[3, 3, 3]
    outputs:
        lap: Tensor[3, 3, 3]
        gx: Tensor[3, 3, 3]
        gy: Tensor[3, 3, 3]
        gz: Tensor[3, 3, 3]
        divergence_1d: Vector[3]
        divergence_2d: Matrix[3, 3]
        divergence_3d: Tensor[3, 3, 3]
    definitions:
        lap = laplacian_3d(u, 0.5, 1.0, 2.0)
        gx = gradient_3d_x(u, 0.5)
        gy = gradient_3d_y(u, 1.0)
        gz = gradient_3d_z(u, 2.0)
        divergence_1d = div_1d(line, 0.5)
        divergence_2d = div_2d(plane_x, plane_y, 0.5, 1.0)
        divergence_3d = div(vx, vy, vz, 0.5, 1.0, 2.0)
