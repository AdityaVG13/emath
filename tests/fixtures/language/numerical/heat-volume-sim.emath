# heat-volume-sim: anisotropic 3D heat equation.
#
# The rank-3 temperature tensor evolves under a 7-point Laplacian with
# unequal axis spacings. Clamp faces are insulated, so total heat is
# conserved while a hot center voxel diffuses to its six neighbors.

emath model HeatVolume:
    inputs:
        alpha: Float64
    state:
        u: Tensor[3, 3, 3]
    equations:
        der(u) = alpha * laplacian_3d(u, 0.5, 1.0, 2.0)
