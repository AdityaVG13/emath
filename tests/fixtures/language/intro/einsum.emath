# Einstein summation. `einsum("ik,kj->ij", a, b)` is matrix product;
# implicit `"ik,kj"` is the same (alphabetical free indices); `"i,i->"`
# is `dot`.
emath function EinsumIds:
    outputs:
        ab: Matrix[2, 2]
        ein: Matrix[2, 2]
        implicit: Matrix[2, 2]
        ddot: Float64
        ein_dot: Float64
    definitions:
        a = [[1.0, 2.0], [3.0, 4.0]]
        b = [[5.0, 6.0], [7.0, 8.0]]
        ab = a * b
        ein = einsum("ik,kj->ij", a, b)
        implicit = einsum("ik,kj", a, b)
        u = [1.0, 2.0, 3.0]
        v = [4.0, 5.0, 6.0]
        ddot = dot(u, v)
        ein_dot = einsum("i,i->", u, v)

    goals:
        evaluate <ein>:
            produce rust.library

    tests:
        example <ids>:
            expect ab == [[19.0, 22.0], [43.0, 50.0]]
            expect ein == ab
            expect implicit == ab
            expect ddot == 32.0
            expect ein_dot == 32.0
