# example: a field pack is exported artifact data.
#
# `emath field_pack` declares a pack of cells/theories/methods/worlds
# that compiles to a semantic image (.emlib) consumed by pack tooling —
# never a compiler rebuild, never runnable meaning. The package line
# names the pack's namespace; consumers import it with
# `use community.spectral_style` (the in-package/law import admission).

package community

emath field_pack spectral_style:
    exports:
        cell softmax
        theory spectral
    metadata:
        description reference spectral pack
