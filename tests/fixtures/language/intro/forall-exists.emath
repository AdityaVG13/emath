# Quantifier binders over vectors. Meaning comes from std.binder.forall
# and std.binder.exists (finite fold; combine and/true and or/false).
# Expected: all_positive = false, has_zero = true for [1.0, 0.0, 3.0].
emath function VectorQuantifiers:
    inputs:
        v: Vector[3]

    outputs:
        all_positive: Bool
        has_zero: Bool

    definitions:
        n = length(v)
        all_positive = forall i in 0..n: v[i] > 0
        has_zero = exists i in 0..n: v[i] == 0

    goals:
        evaluate <all_positive>:
            produce rust.library

    tests:
        example <mixed>:
            given v = [1.0, 0.0, 3.0]
            expect all_positive == false
            expect has_zero == true
