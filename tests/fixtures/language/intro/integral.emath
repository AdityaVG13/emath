# Numerical integration. The verb is std.binder.integral; the method is
# composite Simpson (std.capability.calculus.simpson-integral).
# Expected: area is 9 within 0.001 for x^2 on 0..3.
emath function NumericIntegration:
    inputs:
        a: Float64
        b: Float64

    outputs:
        area: Float64

    definitions:
        area = integral x in a..b: x * x

    tests:
        example <parabola>:
            given a = 0
            given b = 3
            expect abs(area - 9) < 0.001
