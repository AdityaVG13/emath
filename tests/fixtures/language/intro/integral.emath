# Numerical integration with composite Simpson's rule.
# `integral x in a..b: f(x)` evaluates the integrand at 1001 sample
# points and accumulates with alternating weights (1, 4, 2, 4, ..., 1).
# Simpson's rule is exact for polynomials of degree 3 or less.
emath function NumericIntegration:
    inputs:
        a: Float64
        b: Float64

    outputs:
        area: Float64

    definitions:
        area = integral x in a..b: x * x

    tests:
        example <parabola>:
            given a = 0
            given b = 3
            expect abs(area - 9) < 0.001
