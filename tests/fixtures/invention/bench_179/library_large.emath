# Kept library (large receipts) -- benchmark 179 (Barker sequences):
# the exhaustion claims for n = 15..20, kept as data for review. Their
# receipts (15-46 KB of quoted certificate) exceed emath verify's
# fixed 1000000-work claim budget, so this library is NOT
# verify-clean; the fixture's own rechecks accept all six at full
# --work. Generated by the discovery fixture
# ../bench_179_barker.emath (its bench179_kept_large, written by
# `emath keep`). Claims carry their receipts as data; the checkers
# defined here replay them without rerunning a search.
#
# Run: emath verify tests/fixtures/invention/bench_179/library_large.emath
exports: bench179_witness_checker, bench179_exhaustion_checker, bench179_claim_15, bench179_claim_16, bench179_claim_17, bench179_claim_18, bench179_claim_19, bench179_claim_20

use fold.reduce
use search.backtrack
use search.claim
use search.receipts

emath function bench179_abs_i:
    # |x| for an Int.
    inputs:
        x: Int
    outputs:
        result: Int
    definitions:
        result = if x < 0: 0 - x else: x

emath function bench179_corr_at:
    # The aperiodic autocorrelation C_k of a full +-1 sequence.
    inputs:
        s: sequence(Int)
        k: Int
    outputs:
        result: Int
    definitions:
        result = fold(function acc in Int: function i in Int: acc + s[i] * s[i + k], 0, range(0, length(s) - k))

emath function bench179_is_barker:
    # The exact property: every |C_k| <= 1 for 1 <= k < n.
    inputs:
        s: sequence(Int)
    outputs:
        result: Bool
    definitions:
        result = all(function k in Int: bench179_abs_i(bench179_corr_at(s, k)) <= 1, range(1, length(s) - 1))

emath function bench179_canonical:
    # The symmetry-reduced form: a_0 = a_1 = 1 (n >= 2). Negation,
    # reversal, and alternating negation preserve |C_k|, and every
    # Barker sequence has a canonical orbit member.
    inputs:
        s: sequence(Int)
    outputs:
        result: Bool
    definitions:
        result = length(s) >= 2 and s[0] == 1 and s[1] == 1

emath function bench179_pow3:
    # 3^i for 0 <= i <= 20 as a literal table (O(1) digit access: the
    # search state is a base-3 row -- digit 0 = unplaced, 1 = +1,
    # 2 = -1 -- so a kept receipt prints one small integer per node
    # instead of an n-int row, and the replay's per-node decode stays
    # linear).
    inputs:
        i: Int
    outputs:
        result: Int
    definitions:
        result = [1, 3, 9, 27, 81, 243, 729, 2187, 6561, 19683, 59049, 177147, 531441, 1594323, 4782969, 14348907, 43046721, 129140163, 387420489, 1162261467, 3486784401][i]

emath function bench179_digit:
    # The i-th base-3 digit of the state.
    inputs:
        state: Int
        i: Int
    outputs:
        result: Int
    definitions:
        result = int_rem(int_quot(state, bench179_pow3(i)), 3)

emath function bench179_placed:
    # How many positions of the state are placed (nonzero digit).
    inputs:
        state: Int
        n: Int
    outputs:
        result: Int
    definitions:
        result = fold(function acc in Int: function i in Int: acc + (if bench179_digit(state, i) == 0: 0 else: 1), 0, range(0, n))

emath function bench179_row:
    # The decoded +-1/0 row of the state.
    inputs:
        state: Int
        n: Int
    outputs:
        result: sequence(Int)
    definitions:
        result = tabulate(function i in Int: if bench179_digit(state, i) == 1: 1 else: if bench179_digit(state, i) == 2: 0 - 1 else: 0, n)

emath function bench179_pos_at:
    # The both-ends placement order: 0, n-1, 1, n-2, 2, n-3, ...
    inputs:
        p: Int
        n: Int
    outputs:
        result: Int
    definitions:
        result = if int_rem(p, 2) == 0: int_quot(p, 2) else: n - 1 - int_quot(p - 1, 2)

emath function bench179_next:
    # The candidate assignments at the next both-ends position, as
    # encoded child states: +-1, except the canonical slots
    # (placements 0 and 2, positions 0 and 1) take only +1.
    inputs:
        state: Int
        n: Int
    outputs:
        result: sequence(Int)
    definitions:
        placed = bench179_placed(state, n)
        p = bench179_pos_at(placed, n)
        digits = if placed == 0 or placed == 2: [1] else: [1, 2]
        result = tabulate(function j in Int: state + digits[j] * bench179_pow3(p), length(digits))

emath function bench179_corr_ok:
    # One k of the partial test: the partial C_k over placed pairs
    # plus the still-free unplaced pairs must be able to land within
    # |C_k| <= 1 at completion.
    inputs:
        s: sequence(Int)
        n: Int
        k: Int
    outputs:
        result: Bool
    definitions:
        partial = fold(function acc in Int: function i in Int: acc + (if s[i] == 0 or s[i + k] == 0: 0 else: s[i] * s[i + k]), 0, range(0, n - k))
        placed_pairs = fold(function acc in Int: function i in Int: acc + (if s[i] == 0 or s[i + k] == 0: 0 else: 1), 0, range(0, n - k))
        unplaced = n - k - placed_pairs
        result = bench179_abs_i(partial) <= 1 + unplaced

emath function bench179_prefix_ok:
    # The partial test: every k's partial correlation stays within
    # reach of the final |C_k| <= 1.
    inputs:
        s: sequence(Int)
        n: Int
    outputs:
        result: Bool
    definitions:
        result = all(function k in Int: bench179_corr_ok(s, n, k), range(1, n - 1))

emath function bench179_full_ok:
    # done: fully placed and exactly Barker.
    inputs:
        s: sequence(Int)
        n: Int
    outputs:
        result: Bool
    definitions:
        placed = fold(function acc in Int: function x in Int: acc + (if x == 0: 0 else: 1), 0, s)
        result = placed == n and bench179_is_barker(s)

emath function bench179_problem:
    # The both-ends backtrack problem for length n over encoded
    # states: done is a fully placed assignment whose row passes the
    # exact Barker check.
    inputs:
        n: Int
    outputs:
        result: Extend<Int>
    definitions:
        result = Extend: {start: 0, options: function state in Int: bench179_next(state, n), ok: function state in Int: bench179_prefix_ok(bench179_row(state, n), n), done: function state in Int: bench179_full_ok(bench179_row(state, n), n)}

emath function bench179_witness_checker:
    # The witness claim's checker: decode the certificate (a
    # Bench179Witness record) and compute the property of the witness.
    # The search that found it is never rerun.
    inputs:
        cert: Code
    outputs:
        result: Bool
    definitions:
        c = quote.evaluate(cert)
        result = c.n == length(c.sequence) and bench179_canonical(c.sequence) and bench179_is_barker(c.sequence)

emath function bench179_exhaustion_checker:
    # The exhaustion claim's checker: decode the certificate (a
    # Bench179Cert record: n, receipt), rebuild the both-ends problem,
    # and replay the receipt. A structurally malformed receipt rejects
    # (never faults); an incomplete one, a receipt from any other
    # length, or a forged one rejects with the replay's reason.
    inputs:
        cert: Code
    outputs:
        result: Bool
    definitions:
        c = quote.evaluate(cert)
        shaped = length(c.receipt.steps) > 0 and length(c.receipt.nodes_per_depth) == length(c.receipt.kept_per_depth) and all(function k in Int: k >= 0, c.receipt.nodes_per_depth) and all(function k in Int: k >= 0, c.receipt.kept_per_depth)
        sane = c.n >= 2 and c.n <= 20
        v = if shaped: recheck_receipt(bench179_problem(c.n), c.receipt) else: ReceiptVerdict: {ok: false, reason: 0 - 1, node_index: 0 - 1, depth: 0 - 1}
        result = sane and shaped and c.receipt.complete and v.ok and v.reason == receipt_ok(0)

emath function bench179_claim_17:
    # Kept from tests/fixtures/invention/bench_179_barker.emath bench179_kept_large(unused=0); content fnv1a64:19f7512b7aa2c2b5.
    inputs:
        unused: Int
    outputs:
        result: Claim
    definitions:
        result = make_claim(1, quote(function s in sequence(Int): not (length(s) == 17 and bench179_is_barker(s))), quote(Bench179Cert:{n: 17, receipt: Receipt:{complete: true, kept_per_depth: [1, 2, 2, 2, 4, 6, 8, 8, 14, 20, 28, 26, 38, 44, 33, 8, 0], nodes_per_depth: [1, 1, 2, 2, 2, 4, 6, 8, 8, 14, 20, 28, 26, 38, 44, 33, 8], steps: [Step:{depth: 0, kept: [1], node: 0, prunes: []}, Step:{depth: 1, kept: [43046722, 86093443], node: 1, prunes: []}, Step:{depth: 2, kept: [43046725], node: 43046722, prunes: []}, Step:{depth: 3, kept: [71744539], node: 43046725, prunes: [Prune:{child: 57395632, node_index: 3}]}, Step:{depth: 4, kept: [71744548, 71744557], node: 71744539, prunes: []}, Step:{depth: 5, kept: [76527517, 81310486], node: 71744548, prunes: []}, Step:{depth: 6, kept: [76527544, 76527571], node: 76527517, prunes: []}, Step:{depth: 7, kept: [79716190], node: 76527544, prunes: [Prune:{child: 78121867, node_index: 7}]}, Step:{depth: 8, kept: [79716271, 79716352], node: 79716190, prunes: []}, Step:{depth: 9, kept: [80247712, 80779153], node: 79716271, prunes: []}, Step:{depth: 10, kept: [80247955, 80248198], node: 80247712, prunes: []}, Step:{depth: 11, kept: [80602249], node: 80247955, prunes: [Prune:{child: 80425102, node_index: 11}]}, Step:{depth: 12, kept: [80603707], node: 80602249, prunes: [Prune:{child: 80602978, node_index: 12}]}, Step:{depth: 13, kept: [], node: 80603707, prunes: [Prune:{child: 80662756, node_index: 13}, Prune:{child: 80721805, node_index: 13}]}, Step:{depth: 11, kept: [80425345], node: 80248198, prunes: [Prune:{child: 80602492, node_index: 14}]}, Step:{depth: 12, kept: [80426803], node: 80425345, prunes: [Prune:{child: 80426074, node_index: 15}]}, Step:{depth: 13, kept: [80544901], node: 80426803, prunes: [Prune:{child: 80485852, node_index: 16}]}, Step:{depth: 14, kept: [80547088, 80549275], node: 80544901, prunes: []}, Step:{depth: 15, kept: [], node: 80547088, prunes: [Prune:{child: 80566771, node_index: 18}, Prune:{child: 80586454, n