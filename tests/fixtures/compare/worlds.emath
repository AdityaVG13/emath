# One file read under every carrier world by `emath compare`.

use numerics.rk4

# y' = y from t = 0 to 1 in `steps` classical RK4 steps (approximates e).
# The tableau and its exact order conditions are program constants, so
# the float64 world checks them exactly and integrates in binary64.
emath function grow:
    inputs:
        steps: Int
    outputs:
        result: Rat
    definitions:
        h = 1 / steps
        f = function t in Rat: function y in Rat: y
        walk = recur go in Int -> Rat -> Rat: function k in Int: function y in Rat: if k == 0: y else: go(k - 1, rk4_step(y, 0, h, f))
        result = walk(steps, 1)

emath function cancellation:
    inputs:
        x: Rat
    outputs:
        result: Rat
    definitions:
        result = (1 + x) - 1 - x

emath function crosses:
    inputs:
        x: Rat
    outputs:
        result: Bool
    definitions:
        result = x + 0.2 == 0.3

emath function thirds_add_up:
    inputs:
        n: Int
    outputs:
        result: Bool
    definitions:
        result = 1 / n + 1 / n + 1 / n == 3 / n

emath function tenth:
    inputs:
        n: Int
    outputs:
        result: Rat
    definitions:
        result = 1 / n

emath function square_plus_one:
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = n * n + 1

emath function denominator:
    inputs:
        x: Rat
    outputs:
        result: Int
    definitions:
        result = x.denom

emath function keep:
    inputs:
        x: Rat
    outputs:
        result: Rat
    definitions:
        result = x

emath function near_root:
    inputs:
        x: Rat
    outputs:
        result: Rat
    definitions:
        result = x * x - 2

# x(1 - x) and 1/x: an enclosure loses that both factors move with x;
# an affine form keeps it.
emath function logistic:
    inputs:
        x: Rat
    outputs:
        result: Rat
    definitions:
        result = x * (1 - x)

emath function invert:
    inputs:
        x: Rat
    outputs:
        result: Rat
    definitions:
        result = 1 / x

# quote.world runs a function value under another world from inside the
# language: a judge that sees where float64 and exact part ways.
emath function judge:
    inputs:
        n: Int
    outputs:
        result: Bool
    definitions:
        thirds = function k in Int: 1 / k + 1 / k + 1 / k == 3 / k
        exact = quote.world("exact", thirds, n, 100000)
        float = quote.world("float64", thirds, n, 100000)
        result = exact.value != float.value

# The argument is read as the inner world reads data, the answer comes
# back as that world produced it, and the outer world resumes after.
emath function inside_out:
    inputs:
        x: Rat
    outputs:
        result: (Float64, Rat)
    definitions:
        keep = function y in Rat: y
        inner = quote.world("float32", keep, x, 1000)
        result = (inner.value, x / 3)

# A refusal inside the inner world is an answer, not a crash.
emath function inner_refusal:
    inputs:
        x: Rat
    outputs:
        result: (Bool, Str)
    definitions:
        denom = function y in Rat: y.denom
        inner = quote.world("float64", denom, x, 1000)
        result = (inner.done, inner.fault)

# The host's configured world list (`--worlds`); every world when unset.
emath function configured:
    inputs:
        unused: Int
    outputs:
        result: sequence(Str)
    definitions:
        result = quote.worlds()

# A ratio whose numerator and denominator are far past binary64 range
# still widens to Float64 as its value: (3 * 10^n + 1) / 10^n is 3.
emath function huge_ratio:
    inputs:
        n: Int
    outputs:
        result: Float64
    definitions:
        big = int_pow(10, n)
        result = (3 * big + 1) / big * 1.0
