# Rediscovery benchmark for search.formulas: given only a certified
# bracket of a constant, the hunt must find the classical continued
# fractions for it before any claim about new ones.
#
#   Euler:     1 / (e - 2) = 1 + 1 / (2 + 2 / (3 + 3 / (4 + ...)))
#              a(n) = n + 1, b(n) = n, relation [0, 1, 1, -2]
#   Brouncker: 4 / pi = 1 + 1^2 / (3 + 2^2 / (5 + 3^2 / (7 + ...)))
#              a(n) = 2n + 1, b(n) = n^2, relation [0, 4, 1, 0]
#
# Apery's fractions have large coefficients no plain enumeration
# reaches (34 n^3 + 51 n^2 + 27 n + 5 alone is 103^4 cubics away), but
# they live in small families: a(n) = alpha (2n + 1) n (n + 1) +
# beta (2n + 1), b(n) = gamma n^6 is three integers. Searched as
# combinations of basis polynomials:
#
#   zeta(3):   6 / zeta(3) = 5 - 1^6 / (117 - 2^6 / (535 - ...))
#              a(n) = 34 n^3 + 51 n^2 + 27 n + 5, b(n) = -n^6
#   zeta(2):   5 / zeta(2) = 3 + 1^4 / (25 + 2^4 / (69 + ...))
#              a(n) = 11 n^2 + 11 n + 3, b(n) = n^4
#
# Catalan's fraction converges only at ratio 1/2, where the last
# difference between convergents underestimates the distance to G:
#
#   Catalan:   1 / (2G) = 1 - 2 / (7 - 32 / (19 - ...))
#              a(n) = 3 n^2 + 3 n + 1, b(n) = -2 n^4
#
# The zeta(3) bracket comes from the series
# zeta(3) = 5/2 sum (-1)^(k+1) / (k^3 C(2k, k)), whose partial sums
# alternate around it; zeta(2) = pi^2 / 6 from the pi bracket.

use analysis.series
use analysis.intervals
use search.formulas
use fold.reduce

emath function has:
    inputs:
        found: sequence(Formula)
        a: sequence(Int)
        b: sequence(Int)
        relation: sequence(Int)
    outputs:
        result: Bool
    definitions:
        result = any(function f in Formula: f.a == a and f.b == b and f.relation == relation, found)

emath function sound:
    # Every formula, run on to depth 80, lies within 10^-12 of its relation applied to c (c from a tighter bracket).
    inputs:
        found: sequence(Formula)
        c: Rat
    outputs:
        result: Bool
    definitions:
        close = function f in Formula: (cf_value(f.a, f.b, 80) - (f.relation[0] * c + f.relation[1]) / (f.relation[2] * c + f.relation[3])) * 1000000000000
        result = all(function f in Formula: close(f) < 1 / 1 and close(f) > 0 / 1 - 1 / 1, found)

emath function rediscovers_euler_e:
    inputs:
        unused: Int
    outputs:
        result: Hunt
    definitions:
        result = hunt(e_bracket(40), FormulaSearch: {a_basis: powers(1), b_basis: powers(1), bounds: [2, 2, 2, 2], relation_bound: 2, depth: 12, deep: 40, coarse: 1 / 1000, fine: 1 / 1000000000000, chunk: 625})
    tests:
        example <euler_continued_fraction>:
            given unused = 0
            expect has(result.found, [1, 1], [1, 0], [0, 1, 1, 0 - 2])
            expect sound(result.found, e_bracket(60).lo)

emath function rediscovers_brouncker_pi:
    inputs:
        unused: Int
    outputs:
        result: Hunt
    definitions:
        result = hunt(pi_bracket(40), FormulaSearch: {a_basis: powers(1), b_basis: powers(2), bounds: [2, 2, 2, 2, 2], relation_bound: 4, depth: 12, deep: 40, coarse: 1 / 1000, fine: 1 / 1000000000000, chunk: 3125})
    tests:
        example <brouncker_continued_fraction>:
            given unused = 0
            expect has(result.found, [2, 1], [1, 0, 0], [0, 4, 1, 0])
            expect sound(result.found, pi_bracket(60).lo)

emath function central:
    # C(2k, k).
    inputs:
        k: Int
    outputs:
        result: Int
    definitions:
        result = fold(function acc in Int: function i in Int: int_quot(acc * (k + i + 1), i + 1), 1, range(0, k))

emath function zeta3_bracket:
    # 5/2 times two consecutive partial sums of the alternating series: zeta(3) lies between them.
    inputs:
        terms: Int
    outputs:
        result: Itv
    definitions:
        partial = function m in Int: fold(function acc in Rat: function k in Int: acc + (if k - 2 * int_quot(k, 2) == 1: 1 / 1 else: 0 / 1 - 1 / 1) / (k * k * k * central(k)), 0 / 1, range(1, m + 1)) * 5 / 2
        x = partial(terms)
        y = partial(terms + 1)
        result = if x < y: Itv: {lo: x, hi: y} else: Itv: {lo: y, hi: x}

emath function rediscovers_apery:
    inputs:
        unused: Int
    outputs:
        zeta3: Hunt
        zeta2: Hunt
    definitions:
        pi = pi_bracket(40)
        zeta3 = hunt(zeta3_bracket(40), FormulaSearch: {a_basis: [[2, 3, 1, 0], [2, 1]], b_basis: [[1, 0, 0, 0, 0, 0, 0]], bounds: [20, 8, 1], relation_bound: 6, depth: 12, deep: 40, coarse: 1 / 1000, fine: 1 / 1000000000000, chunk: 2091})
        zeta2 = hunt(Itv: {lo: pi.lo * pi.lo / 6, hi: pi.hi * pi.hi / 6}, FormulaSearch: {a_basis: [[1, 1, 0], [1]], b_basis: [[1, 0, 0, 0, 0]], bounds: [12, 5, 1], relation_bound: 5, depth: 12, deep: 40, coarse: 1 / 1000, fine: 1 / 1000000000000, chunk: 825})
    tests:
        example <apery_continued_fractions>:
            given unused = 0
            expect has(zeta3.found, [34, 51, 27, 5], [0 - 1, 0, 0, 0, 0, 0, 0], [0, 6, 1, 0])
            expect sound(zeta3.found, zeta3_bracket(60).lo)
            expect has(zeta2.found, [11, 11, 3], [1, 0, 0, 0, 0], [0, 5, 1, 0])
            expect sound(zeta2.found, pi_bracket(60).lo * pi_bracket(60).lo / 6)

emath function catalan_bracket:
    # G = (pi / 8) ln(2 + sqrt 3) + (3 / 8) sum_{n >= 0} 1 / (C(2n, n) (2n + 1)^2), with ln(2 + sqrt 3) = (2 / sqrt 3) sum_{k >= 0} 3^-k / (2k + 1). Both series are positive with term ratios below 1/3 and 1/2, so each tail lies below 3/2 and 2 times its next term.
    inputs:
        m: Int
    outputs:
        result: Itv
    definitions:
        partial = function term in Int -> Rat: fold(function acc in Rat: function k in Int: acc + term(k), 0 / 1, range(0, m))
        three = function k in Int: fold(function acc in Int: function i in Int: acc * 3, 1, range(0, k))
        t = function k in Int: 1 / ((2 * k + 1) * three(k))
        s = function n in Int: 1 / (central(n) * (2 * n + 1) * (2 * n + 1))
        scale = fold(function acc in Int: function i in Int: acc * 10, 1, range(0, 40))
        r = root_enclosure(3 * scale * scale / 1, 2)
        root3 = Itv: {lo: r.lo / scale, hi: r.hi / scale}
        ln = itv_mul(itv_scale(root3, 2 / 3), Itv: {lo: partial(t), hi: partial(t) + 3 / 2 * t(m)})
        result = itv_add(itv_scale(itv_mul(pi_bracket(m), ln), 1 / 8), itv_scale(Itv: {lo: partial(s), hi: partial(s) + 2 * s(m)}, 3 / 8))

emath function rediscovers_catalan:
    # 1 / (2G) = 1 - 2 / (7 - 32 / (19 - ...)), a(n) = 3n^2 + 3n + 1, b(n) = -2n^4, converges only geometrically (ratio about 1/2): the last difference between convergents underestimates its distance to the limit.
    inputs:
        unused: Int
    outputs:
        result: Hunt
    definitions:
        result = hunt(catalan_bracket(80), FormulaSearch: {a_basis: [[1, 1, 0], [1]], b_basis: [[1, 0, 0, 0, 0]], bounds: [3, 1, 2], relation_bound: 2, depth: 12, deep: 80, coarse: 1 / 1000, fine: 1 / 1000000000000, chunk: 105})
    tests:
        example <catalan_continued_fraction>:
            given unused = 0
            expect has(result.found, [3, 3, 1], [0 - 2, 0, 0, 0, 0], [0, 1, 2, 0])
            expect sound(result.found, catalan_bracket(100).lo)
