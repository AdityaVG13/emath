emath function square_triangular:
    # Kept from explore.emath Explored(unused=0); content fnv1a64:5fe67286821abf0c.
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = triangular(n) * triangular(n)

emath function partial_sum_fibonacci:
    # Kept from explore.emath Explored(unused=0); content fnv1a64:692fdf6f72ec6b0e.
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = if n < 1: 0 else: (partial_sum_fibonacci(n - 1) + fibonacci(n))

emath function difference_fibonacci:
    # Kept from explore.emath Explored(unused=0); content fnv1a64:6856bd25f88b91fd.
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = if n < 1: 1 else: (if n < 2: 0 else: (difference_fibonacci(n - 1) + difference_fibonacci(n - 2)))

emath function bisect_fibonacci:
    # Kept from explore.emath Explored(unused=0); content fnv1a64:8f0b18118357db9e.
    inputs:
