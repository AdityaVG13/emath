# Kept definitions, written by `emath keep`.
exports: triangular, fibonacci, partial_sum_triangular, difference_triangular, bisect_triangular, square_triangular, partial_sum_fibonacci, difference_fibonacci, bisect_fibonacci, square_fibonacci

emath function triangular:
    # Kept from explore.emath Explored(unused=0); content fnv1a64:8cca22ca48eed255.
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = if n < 1: 0 else: (n + triangular(n - 1))

emath function fibonacci:
    # Kept from explore.emath Explored(unused=0); content fnv1a64:0cc5cbb4e1d1f8d3.
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = if n < 1: 0 else: (if n < 2: 1 else: (fibonacci(n - 1) + fibonacci(n - 2)))

emath function partial_sum_triangular:
    # Kept from explore.emath Explored(unused=0); content fnv1a64:f40fec4b7a80b155.
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = if n < 1: 0 else: (partial_sum_triangular(n - 1) + triangular(n))

emath function difference_triangular:
    # Kept from explore.emath Explored(unused=0); content fnv1a64:1dc0d3c0ae13ca02.
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
