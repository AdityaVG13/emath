# The loop speeds up a program by inventing closed forms for its slow
# parts. slow(n) adds three sums, each O(n). search.accelerate takes
# each call inside the body as a function of n, computes its first
# twelve values, and searches closed forms for them, round after round:
#
#   sum of 0..n-1          n * (n - 1) / 2, found from scratch
#   sum of cubes           T(n) * T(n), with T the closed form above
#                          (Nicomachus: the cubes sum to a square)
#   sum of min(i, 11)      looks like T(n) on every value it was shown,
#                          and fails at n = 20: refuted, never used
#
# The sums of sums are spots too: cubes plus 3 T(n) gets its own law,
# and the whole body, which holds the min(i, 11) sum, is refuted at
# the same far points.
#
# Each surviving closed form is a law, a rewrite from the call to the
# closed form, and the rewrite climb applies the laws where they lower
# the work on the checks. The min(i, 11) sum stays linear, so the whole
# program can get at most about three times cheaper; the check asks
# for two.
#
# Run: emath test accelerate.emath --work 60000000

use search.accelerate
use analysis.series
use search.optimize
use fold.reduce

emath function Accelerates:
    inputs:
        unused: Int
    outputs:
        triangular: Bool
        nicomachus: Bool
        refuted: Bool
        faster: Bool
    definitions:
        slow = quote(function n in Int: sum(tabulate(function i in Int: i * i * i, n)) + 3 * sum(tabulate(function i in Int: i, n)) + sum(tabulate(function i in Int: if i < 11: i else: 11, n)))
        run = accelerate(slow, [30, 60], Settings: {max_size: 7, far: [20, 33, 50], inputs: [], limit: 10000000})
        at = function f in ClosedForm: function k in Int: quote.evaluate(f.program)(k)
        held = filter(function f in ClosedForm: length(f.fails) == 0, run.forms)
        broken = filter(function f in ClosedForm: length(f.fails) > 0, run.forms)
        tri = filter(function f in ClosedForm: at(f)(100) == 4950, held)
        cubes = filter(function f in ClosedForm: at(f)(10) == 2025, held)
        triangular = length(tri) == 1 and tri[0].size == 7 and tri[0].tested == 3
        nicomachus = length(cubes) == 1 and cubes[0].size == 5 and cubes[0].work_after * 10 < cubes[0].work_before
        mimic = filter(function f in ClosedForm: at(f)(12) == 66, broken)
        refuted = length(mimic) == 1 and mimic[0].fails == [20, 33, 50]
        slow_at = function k in Int: quote.evaluate(slow)(k)
        fast_at = function k in Int: quote.evaluate(run.program)(k)
        faster = run.work_after * 2 < run.work_before and fast_at(200) == slow_at(200)
    tests:
        example <invents_its_speedup>:
            given unused = 0
            expect triangular == true
            expect nicomachus == true
            expect refuted == true
            expect faster == true

# Linear loops with no closed form. accelerate fits, for each call over
# n with integer values, laws f(2m), f(2m + 1), f(2m + 2) = a degree-two
# polynomial in f(m) and f(m + 1), from m = 0..7, checks them on
# m = 8..11, tests them at the far m, and turns the survivors into a
# halving program that needs about log n steps:
#
#   Fibonacci   F(2m) = 2 F(m) F(m+1) - F(m)^2, F(2m+1) = F(m)^2 + F(m+1)^2,
#               F(2m+2) = F(m+1)^2 + 2 F(m) F(m+1), found from the loop
#   the body    Fibonacci plus 1 past n = 30 fits the same laws on every
#               value it was shown and fails at m = 40 and 77: refuted
#   Pell        a(n) = 2 a(n-1) + a(n-2), a recurrence nobody told it:
#               its own doubling laws, and the same speedup
#   factorial   no degree-two law fits the values it was shown:
#               nothing is conjectured
emath function fib_loop:
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = fold(function p in sequence(Int): function k in Int: [p[1], p[0] + p[1]], [0, 1], range(0, n))[0]

emath function pell_loop:
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = fold(function p in sequence(Int): function k in Int: [p[1], 2 * p[1] + p[0]], [0, 1], range(0, n))[0]

emath function fact_loop:
    inputs:
        n: Int
    outputs:
        result: Int
    definitions:
        result = fold(function acc in Int: function k in Int: acc * (k + 1), 1, range(0, n))

emath function AcceleratesByDoubling:
    inputs:
        unused: Int
    outputs:
        fibonacci: Bool
        refuted: Bool
        unseen: Bool
        none: Bool
    definitions:
        settings = Settings: {max_size: 5, far: [40, 77], inputs: [], limit: 100000000}
        law = function d in DoublingLaw: function i in Int: quote.evaluate(d.laws[i])(3)(5)
        fib = quote(function n in Int: fib_loop(n) + (if n > 30: 1 else: 0))
        run = accelerate(fib, [500, 1000], settings)
        held = filter(function d in DoublingLaw: length(d.fails) == 0, run.doublings)
        broken = filter(function d in DoublingLaw: length(d.fails) > 0, run.doublings)
        fibonacci = length(held) == 1 and law(held[0])(0) == 21 and law(held[0])(1) == 34 and law(held[0])(2) == 55 and run.work_after * 10 < run.work_before and quote.evaluate(run.program)(1500) == quote.evaluate(fib)(1500)
        refuted = length(broken) == 1 and broken[0].fails == [40, 77]
        pell = quote(function n in Int: pell_loop(n))
        again = accelerate(pell, [500, 1000], settings)
        unseen = length(filter(function d in DoublingLaw: length(d.fails) == 0, again.doublings)) == 1 and again.work_after * 10 < again.work_before and quote.evaluate(again.program)(1500) == pell_loop(1500)
        fact = accelerate(quote(function n in Int: fact_loop(n)), [30, 60], settings)
        none = length(fact.doublings) == 0
    tests:
        example <invents_doubling_laws>:
            given unused = 0
            expect fibonacci == true
            expect refuted == true
            expect unseen == true
            expect none == true

# The shipped pi bracket (analysis.series, Machin) brackets each atan
# series by two partial sums, S(k) and S(k + 1), each computed from the
# first term. accelerate finds the pair, conjectures that the
# next partial sum is the last one plus one of the sum's own inner
# functions (at the next index, or at the same one), tests both at
# t = 1/3 and 2/7 for m = 5 and 12, keeps the one that holds, and
# rewrites S(k + 1) into S(k) plus one term: about 1.6x less work
# (10094 -> 6230 over k = 10, 20), the same bracket at k = 40.
emath function AcceleratesSeries:
    inputs:
        unused: Int
    outputs:
        step: Bool
        refuted: Bool
        faster: Bool
    definitions:
        pi = quote.body(quote(pi_bracket)).fragment
        run = accelerate(pi, [10, 20], Settings: {max_size: 7, far: [5, 12], inputs: [[quote(1 / 3)], [quote(2 / 7)]], limit: 100000000})
        held = filter(function r in StepLaw: length(r.fails) == 0, run.steps)
        broken = filter(function r in StepLaw: length(r.fails) > 0, run.steps)
        step = length(held) == 1 and held[0].offset == 1 and held[0].tested == 4 and quote.evaluate(quote.make(Call: {callee: held[0].step, args: [quote(1 / 3), quote(1)]})) == 0 - 1 / 81
        refuted = length(broken) == 1 and broken[0].offset == 0 and broken[0].fails == [5, 12]
        faster = run.work_after * 4 < run.work_before * 3 and quote.evaluate(run.program)(40) == pi_bracket(40)
    tests:
        example <invents_the_next_partial_sum>:
            given unused = 0
            expect step == true
            expect refuted == true
            expect faster == true
