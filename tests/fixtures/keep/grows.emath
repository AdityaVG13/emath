# Second tier: kept discoveries become building blocks. The library
# lib/seq.emath holds triangular, factorial, and fibonacci, found and
# kept from discover.emath. Each target below has no rule within five
# parts over the base blocks alone; with the kept functions added as
# blocks, a four- or five-part rule appears and survives the held-out
# terms. Catalan stays unsolved either way: its known forms need
# division and about twelve parts.
#
# Run: emath test grows.emath --work 50000000
# Keep a second-tier find into the same library (it calls fibonacci):
#   emath keep grows.emath --function FibonacciEven --name fibonacci_even --to lib/seq.emath --set unused=0 --work 50000000

use lib.seq
use search.synthesis

emath function kept_blocks:
    inputs:
        unused: Int
    outputs:
        result: sequence(Block)
    definitions:
        result = [Block: {code: quote(triangular(x)), apply: triangular, cap: 50}, Block: {code: quote(factorial(x)), apply: factorial, cap: 30}, Block: {code: quote(fibonacci(x)), apply: fibonacci, cap: 20}]

emath function FibonacciEven:
    inputs:
        unused: Int
    outputs:
        result: Code
    definitions:
        result = synthesize_with([0, 1, 3, 8, 21, 55, 144, 377, 987, 2584], [6765, 17711], 5, kept_blocks(0)).program

emath function Tier2:
    inputs:
        train: sequence(Int)
        held: sequence(Int)
        with_kept: Bool
    outputs:
        status: Int
        size: Int
        next: Int
    definitions:
        found = synthesize_with(train, held, 5, if with_kept: kept_blocks(0) else: [])
        g = quote.evaluate(found.program)
        status = found.status
        size = found.size
        next = if found.status == 1: g(length(train) + length(held)) else: -1
    tests:
        example <fibonacci_at_even_positions_needs_fibonacci>:
            given train = [0, 1, 3, 8, 21, 55, 144, 377, 987, 2584]
            given held = [6765, 17711]
            given with_kept = false
            expect status == 0
        example <fibonacci_at_even_positions>:
            given train = [0, 1, 3, 8, 21, 55, 144, 377, 987, 2584]
            given held = [6765, 17711]
            given with_kept = true
            expect status == 1
            expect size == 4
            expect next == 46368
        example <factorial_plus_one_needs_factorial>:
            given train = [2, 2, 3, 7, 25, 121, 721, 5041, 40321, 362881]
            given held = [3628801, 39916801]
            given with_kept = false
            expect status == 0
        example <factorial_plus_one>:
            given train = [2, 2, 3, 7, 25, 121, 721, 5041, 40321, 362881]
            given held = [3628801, 39916801]
            given with_kept = true
            expect status == 1
            expect size == 4
            expect next == 479001601
        example <sum_of_cubes_needs_triangular>:
            given train = [0, 1, 9, 36, 100, 225, 441, 784, 1296, 2025]
            given held = [3025, 4356]
            given with_kept = false
            expect status == 0
        example <sum_of_cubes>:
            given train = [0, 1, 9, 36, 100, 225, 441, 784, 1296, 2025]
            given held = [3025, 4356]
            given with_kept = true
            expect status == 1
            expect size == 5
            expect next == 6084
        example <catalan_still_unsolved>:
            given train = [1, 1, 2, 5, 14, 42, 132, 429, 1430, 4862]
            given held = [16796, 58786]
            given with_kept = true
            expect status == 0
