# User-shaped biology/chemistry/earth operations. Not a teaching example.

emath function BioFieldOps:
    inputs:
        unused: Int
    outputs:
        lotka: Int
        hw: Int
        flux: Int
        voxel: Int
        sir: Int
        rate: Int
        energy: Int
        hr: Int
    definitions:
        lotka = 2 * 3 + (-1) * 4
        hw = 1 * 1
        flux = 3 + (-3)
        voxel = 2 * 2 * 2
        sir = 3 + (-1)
        rate = 2 * 3
        energy = 4 + (-4)
        hr = 4 * 15
    tests:
        example <slice>:
            given unused = 0
            expect lotka == 2
            expect hw == 1
            expect flux == 0
            expect voxel == 8
            expect sir == 2
            expect rate == 6
            expect energy == 0
            expect hr == 60
