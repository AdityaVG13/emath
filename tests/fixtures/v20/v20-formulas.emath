# User-shaped V20 load-bearing formulas. Not leftover x = N.

emath function V20LoadBearingFormulas:
    inputs:
        unused: Int
    outputs:
        amdahl_four_thirds_num: Int
        amdahl_four_thirds_den: Int
        little: Int
        roof: Int
        frontier: Int
        kv: Int
        specu: Int
        multi: Int
        recovered: Int
        secret: Int
        advantage: Int
        hamming_radius: Int
    definitions:
        amdahl_four_thirds_num = 2 * 2
        amdahl_four_thirds_den = 1 + 2
        little = 3 * 4
        roof = 10 * 8
        frontier = (4 + 4) / (2 + 2)
        kv = 2 * 4 * 8
        specu = 6 * 1 / 2
        multi = 4 + 4
        recovered = (5 + 3) + (-3)
        secret = 7 + 10
        advantage = 1 + (-1)
        hamming_radius = 2 * 3 + 1
    tests:
        example <slice>:
            given unused = 0
            expect amdahl_four_thirds_num == 4
            expect amdahl_four_thirds_den == 3
            expect little == 12
            expect roof == 80
            expect frontier == 2
            expect kv == 64
            expect specu == 3
            expect multi == 8
            expect recovered == 5
            expect secret == 17
            expect advantage == 0
            expect hamming_radius == 7
