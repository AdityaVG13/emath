# User-shaped geometry and topology operations. Not a teaching example.

emath function GeometryFieldOps:
    inputs:
        unused: Int
    outputs:
        pythag: Int
        centroid: Int
        cross: Int
        excess: Int
        hyp: Int
        euler_c: Int
        tetra: Int
        bezout: Int
        mink: Int
        contact: Int
        triang: Int
        perim: Int
        chi_t2: Int
        trefoil: Int
        orb: Int
        ncg: Int
        ddg: Int
        mid: Int
        fisher: Int
        chi_s1: Int
    definitions:
        pythag = 3 * 3 + 4 * 4
        centroid = (1 + 3 + 5) / 3
        cross = (2 * 6) / (3 * 4)
        excess = 180 + (-90) + (-60) + (-30)
        hyp = 3 * 3 + (-2) * 4
        euler_c = 8 + (-12) + 6
        tetra = 4 + (-6) + 4
        bezout = 2 * 3
        mink = 1 + 1 + 1 + (-1)
        contact = 2 * 2 + 1
        triang = 2 * 3 + (-4)
        perim = 2 + 2 + 2 + 2
        chi_t2 = 1 + (-1)
        trefoil = 3 + 2
        orb = (3 + 2 + 1) / 6
        ncg = 1 + (-1)
        ddg = 1 + (-1) + 0
        mid = (1 + 5) / 2
        fisher = 2 * 2
        chi_s1 = 1 + (-1) + 1
    tests:
        example <slice>:
            given unused = 0
            expect pythag == 25
            expect centroid == 3
            expect cross == 1
            expect excess == 0
            expect hyp == 1
            expect euler_c == 2
            expect tetra == 2
            expect bezout == 6
            expect mink == 2
            expect contact == 5
            expect triang == 2
            expect perim == 8
            expect chi_t2 == 0
            expect trefoil == 5
            expect orb == 1
            expect ncg == 0
            expect ddg == 0
            expect mid == 3
            expect fisher == 4
            expect chi_s1 == 1
