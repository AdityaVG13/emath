# A user factors a cubic: every rational root is found exactly and each one
# really zeroes the polynomial.

use algebra.polynomials
use algebra.roots

emath function CubicRoots:
    inputs:
        p: sequence(Rat)
    outputs:
        roots: sequence(Rat)
        all_vanish: Bool
    definitions:
        roots = root_rational_roots(p)
        all_vanish = all(function r in Rat: poly_eval(p, r) == 0 / 1, roots)
    tests:
        example <two_x_cubed_factors_fully>:
            # 2x^3 - 3x^2 - 3x + 2 = (x - 2)(2x - 1)(x + 1)
            given p = [2 / 1, 0 - 3 / 1, 0 - 3 / 1, 2 / 1]
            expect length(roots) == 3
            expect all_vanish == true
        example <double_root_counts_twice>:
            # (x - 1)^2 (x + 3) = x^3 + x^2 - 5x + 3
            given p = [3 / 1, 0 - 5 / 1, 1 / 1, 1 / 1]
            expect length(roots) == 3
            expect all_vanish == true
        example <irreducible_quadratic_has_none>:
            given p = [0 - 2 / 1, 0 / 1, 1 / 1]
            expect roots == []
