# User-shaped foundation-model operations. Not a teaching example.

emath function FoundationModelsFieldOps:
    inputs:
        unused: Int
    outputs:
        attn: Int
        gqa: Int
        moe: Int
        nll: Int
        lora: Int
        quant: Int
        rag: Int
        tok: Int
    definitions:
        attn = 4 * 4
        gqa = 8 / 2
        moe = 2 + 6
        nll = 4 + (-4)
        lora = 2 * 8
        quant = 16 / 2
        rag = 3 + 2
        tok = 2 * 4
    tests:
        example <slice>:
            given unused = 0
            expect attn == 16
            expect gqa == 4
            expect moe == 8
            expect nll == 0
            expect lora == 16
            expect quant == 8
            expect rag == 5
            expect tok == 8
