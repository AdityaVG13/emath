# A user solves a small resistor network (mesh equations) exactly and checks
# the residual; a dependent mesh set refuses instead of guessing.

use algebra.linear.systems

emath function MeshCurrents:
    inputs:
        a: sequence(sequence(Rat))
        v: sequence(Rat)
    outputs:
        i: sequence(Rat)
        residual_zero: Bool
    definitions:
        i = solve_dense(a, v, 0 / 1)
        residual_zero = all(function r in Int: fold(function s in Rat: function c in Int: s + a[r][c] * i[c], 0 / 1, range(0, length(i))) == v[r], range(0, length(v)))
    tests:
        example <three_mesh_network>:
            given a = [[15 / 1, 0 - 5 / 1, 0 / 1], [0 - 5 / 1, 15 / 1, 0 - 5 / 1], [0 / 1, 0 - 5 / 1, 10 / 1]]
            given v = [10 / 1, 0 / 1, 0 - 5 / 1]
            expect i == [9 / 13, 1 / 13, 0 - 6 / 13]
            expect residual_zero == true
        example <dependent_meshes_refuse>:
            given a = [[1 / 1, 2 / 1], [2 / 1, 4 / 1]]
            given v = [3 / 1, 6 / 1]
            expect diagnostic.code == singular_matrix
