# A user models customers switching between two shops as a Markov chain and
# asks for the expected revenue over a few days.

use probability.markov

emath function ShopQueue:
    inputs:
        days: Int
    outputs:
        revenue: Rat
    definitions:
        revenue = markov_total_reward([1 / 1, 0 / 1], [[3 / 4, 1 / 4], [1 / 2, 1 / 2]], [10 / 1, 4 / 1], days)
    tests:
        example <two_days>:
            # day 1 at shop A: 10; day 2: 3/4 * 10 + 1/4 * 4 = 17/2
            given days = 2
            expect revenue == 37 / 2
        example <no_days_no_revenue>:
            given days = 0
            expect revenue == 0 / 1
