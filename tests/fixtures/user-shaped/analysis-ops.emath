# User-shaped analysis field operations. Not a teaching example.

emath function AnalysisFieldOps:
    inputs:
        unused: Int
    outputs:
        sum_rule: Int
        power_rule: Int
        modsq: Int
        prod_re: Int
        dc_sum: Int
        nyquist: Int
        rec: Int
        euler: Int
        heat: Int
        cons: Int
        riemann: Int
        jensen: Int
        gamma4: Int
        choose: Int
        frac: Int
        lip: Int
        ham: Int
        trap: Int
        arith: Int
        react: Int
    definitions:
        sum_rule = 2 + 3
        power_rule = 3 * 4
        modsq = 1 * 1 + 2 * 2
        prod_re = 1 * 3 - 2 * 4
        dc_sum = 1 + 2 + 3 + 4
        nyquist = 8 / 2
        rec = 2 * 3 + 1
        euler = 1 + 1 * 2
        heat = 15 + (-4)
        cons = 11 + (-4) + (-7)
        riemann = 2 * 3
        jensen = (2 + 8) / 2
        gamma4 = 4 * 3 * 2 * 1
        choose = 5 * 4 / 2
        frac = 2 * 1 / 2
        lip = (8 - 2) / (4 - 1)
        ham = 3 + 5
        trap = (1 + 3) * 2 / 2
        arith = 5 * (4 + 12) / 2
        react = 2 + 3 + (-5)
    tests:
        example <slice>:
            given unused = 0
            expect sum_rule == 5
            expect power_rule == 12
            expect modsq == 5
            expect prod_re == -5
            expect dc_sum == 10
            expect nyquist == 4
            expect rec == 7
            expect euler == 3
            expect heat == 11
            expect cons == 0
            expect riemann == 6
            expect jensen == 5
            expect gamma4 == 24
            expect choose == 10
            expect frac == 1
            expect lip == 2
            expect ham == 8
            expect trap == 4
            expect arith == 40
            expect react == 0
