# expect: E-TYPE-002
# A first-minute form that needs a hidden default is refused: bare `sin`
# would require the compiler to guess "treat the function as sin(x)".
# No standard-image FeatureID or alias supplies it.
emath function PlotSin:
    inputs:
        x: Float64
    outputs:
        y: Float64
    definitions:
        y = sin
