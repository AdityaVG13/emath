# expect: E-SYN-101 non-command statement inside `compile:`
emath policy CompileJunk:
    inputs:
        x: Float64
    outputs:
        y: Float64
    state:
        s: Float64
    constructors:
        public fn new(s: Float64) -> Result<Self, ConfigError>:
            Self:
                s = s
    definitions:
        y = state.s * x
    compile:
        target rust
        profile library
        bogus
