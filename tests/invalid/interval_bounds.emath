package r3_intervals_8pjn_invalid

emath function SeededZeroContainingDivisor:
    outputs:
        q: Interval<Float64>
        probe: Float64
    definitions:
        q = interval(6.0, 8.0) / interval(-1.0, 1.0)
        probe = 1.0
    tests:
        example <canonical>:
            expect probe == 1

emath function SeededIllFormedInterval:
    outputs:
        x: Interval<Float64>
        probe: Float64
    definitions:
        x = interval(2.0, 1.0)
        probe = 1.0
    tests:
        example <canonical>:
            expect probe == 1
