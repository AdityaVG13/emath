# expect: E-KIND-027 — an `assumptions:` entry must be a bare name
# Declared approximations hash into the
# artifact by name, so a call-shaped entry is not a declaration and
# refuses instead of being silently ignored.
emath reaction_network MalformedAssumption:
    species:
        S
        P
        E
        ES
    rate:
        v = michaelis_menten(Vmax, Km, [S])
    assumptions:
        quasi_steady_state()
    reactions:
        cat: ES -> E + P
