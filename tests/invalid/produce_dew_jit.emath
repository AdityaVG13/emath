# expect: E-GOAL-042 produce target outside the Phase 1 subset
emath policy ProduceDewJit:
    inputs:
        x: Float64
    outputs:
        y: Float64
    state:
        s: Float64
    constructors:
        public fn new(s: Float64) -> Result<Self, ConfigError>:
            Self:
                s = s
    definitions:
        y = state.s * x
    goals:
        evaluate <y>:
            produce dew.jit
