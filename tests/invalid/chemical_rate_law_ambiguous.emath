# expect: E-NOTATION-AMBIG — §3.4 context-scoped brackets
# Inside a `rate:` entry, `[Q]` is the
# concentration-of-Q reading, but Q is not a declared species, so the
# bracket has no resolvable reading and refuses instead of guessing.
emath reaction_network AmbiguousBracket:
    species:
        S
        P
        E
        ES
    rate:
        v = michaelis_menten(Vmax, Km, [Q])
    reactions:
        cat: ES -> E + P
