# Linear programming negative fixture (LP compute layer)
# The seed's silent-success shape: an LP whose right-side vector does
# not match the constraint matrix's row count must refuse typed at
# evaluation — E-LP-003 — never solve against garbage dimensions.
# expect: E-LP-003

emath function plan:
    inputs:
        A: Matrix<Float64>
        b: Vector<Float64>
        c: Vector<Float64>
    outputs:
        cost: Float64
    definitions:
        cost = dot(lp_minimize(A, b, c), c)
