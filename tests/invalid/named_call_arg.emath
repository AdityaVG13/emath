# expect: E-SYN-121 named call argument outside the Phase 1 subset
emath policy P:
    inputs:
        x: Float64
    outputs:
        y: Float64
    state:
        s: Float64
    constructors:
        public fn new(s: Float64) -> Result<Self, ConfigError>:
            Self:
                s = s
    definitions:
        y = probe(x, round = 2)
