# expect: E-CHEM-STOICH — the equilibrium row is the derived identity
# `initial + xi * change`; re-entering any other formula (here a made-up
# `2 * initial - xi`) is the classic transcription error the bead refuses
# (emath-r3-stoich-tables-pqs6).
emath reaction_network NonIdentity:
    species:
        A
        B
    reactions:
        r1: A -> B
    extents:
        xi: Real in mol
    ice_table r1:
        initial:
            A = 1.0
            B = 0.0
        change:
            A = -1
            B = 1
        equilibrium = 2 * initial - xi
