# expect: E-SYN-155 raise refused — this file freezes, and `--raise units`
# on a frozen meaning is refused. The unit test
# tests/emath-cli/tests/meaning_budget_display_unit.rs freezes a copy of
# this fixture and asserts the refusal.
emath function P:
    inputs:
        x: Float64
    outputs:
        y: Float64
    definitions:
        y = x * 1.5
