# NEGATIVE (emath-r3-units-ext-physics-8u7h.1): a "physics" pack that FORKS
# notation by injecting parser keywords refuses at admission (E-SYN-101,
# the closed field-pack section table) — a forked nabla never becomes
# installable data. Composition lists existing packages; it never forks.
# expect: E-SYN-101
package std

emath field_pack physics_fork:
    exports:
        cell nabla_stencil
    keywords:
        nabla div
