# expect: E-KIND-027 — a `rate:` entry value must be a numeric literal
# Rate constants feed the honesty
# gate and the seeded-determinism creed, so a bare path value is not a
# rate — admission refuses instead of guessing.
emath reaction_network NonNumericRate:
    species:
        S
        P
        E
        ES
    rate:
        kf = some_path
    reactions:
        cat: ES -> E + P
