# expect: E-CHEM-STOICH — an ICE table change entry for a species the
# reaction does not involve (`C` is not in `r1: A -> B`) is a
# transcription error, never silently ignored
# (emath-r3-stoich-tables-pqs6).
emath reaction_network Bystander:
    species:
        A
        B
        C
    reactions:
        r1: A -> B
    ice_table r1:
        initial:
            A = 1.0
            B = 0.0
        change:
            A = -1
            B = 1
            C = 1
