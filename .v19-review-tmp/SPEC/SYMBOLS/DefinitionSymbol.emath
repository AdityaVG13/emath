emath spec DefinitionSymbol:
    identity: "std.symbol.definition@1"
    class: "symbol"
    status: "proposed"
    edition: 1
    summary: "Defines a binding in definition contexts; proposition equality is separate."
    dependencies: ["std.syntax.expression.core@1"]
    surface: {"role":"operator","spellings":["="],"fixity":"contextual","precedence":10,"associativity":"contextual","confusable_class":"registry-required"}
    canonical: {"lower_to":"Definition","identity_fields":["resolved capability","operands"]}
    semantics: {"contract":"Defines a binding in definition contexts; proposition equality is separate."}
    exactness: {"policy":"inherited","implicit_demotion":false}
    effects: {"allowed":[]}
    worlds: {"applicability":"manifest-declared"}
    reference: {"mode":"schema-lowering","target":"Definition"}
    artifact: {"classes":["value","symbolic","diagnostic"]}
    projections: ["identity","surface","parse","lowering","static-semantics","reference","worlds","execution","artifact","diagnostics","documentation","tooling","conformance","migration","agent-view"]
    diagnostics: ["E-SYMBOL-UNRESOLVED","E-SYMBOL-AMBIGUOUS","E-SYMBOL-PRECEDENCE"]
    conformance: {"positive":["std.symbol.definition@1:positive"],"negative":["std.symbol.definition@1:negative"],"mutation":["std.symbol.definition@1:mutation"]}
    evolution: {"meaning_change":"new major or explicit migration"}
    agent: {"owner":"emath-syntax","read":["Feature Capsule","direct dependencies","conformance cases","current owner contract"],"edit":["normative capsule","owner implementation","targeted tests"],"hazards":["Unicode confusables","precedence drift","multi-role glyph"]}
