emath spec UseImport:
    identity: "std.syntax.use@1"
    class: "syntax"
    status: "accepted"
    edition: 1
    summary: "Imports names, packs, worlds, methods, and syntax under a lock."
    dependencies: ["std.syntax.source@1"]
    surface: {"role":"stage0","form":"use path","spellings":[]}
    canonical: {"lower_to":"Import","identity_fields":["edition","resolved features","canonical payload"]}
    semantics: {"contract":"Imports names, packs, worlds, methods, and syntax under a lock."}
    exactness: {"policy":"inherited","implicit_demotion":false}
    effects: {"allowed":[]}
    worlds: {"applicability":"manifest-declared"}
    reference: {"mode":"schema-lowering","target":"Import"}
    artifact: {"classes":["source","diagnostic"]}
    projections: ["identity","surface","parse","lowering","static-semantics","reference","worlds","execution","artifact","diagnostics","documentation","tooling","conformance","migration","agent-view"]
    diagnostics: ["E-SYNTAX","E-LAYOUT"]
    conformance: {"positive":["std.syntax.use@1:positive"],"negative":["std.syntax.use@1:negative"],"mutation":["std.syntax.use@1:mutation"]}
    evolution: {"meaning_change":"new major or explicit migration"}
    agent: {"owner":"emath-syntax","read":["Feature Capsule","direct dependencies","conformance cases","current owner contract"],"edit":["normative capsule","owner implementation","targeted tests"],"hazards":["panic-free UTF-8","exact spans","no domain keyword"]}
