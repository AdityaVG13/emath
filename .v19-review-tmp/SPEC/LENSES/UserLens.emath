emath spec UserLens:
    identity: "std.lens.user@1"
    class: "lens"
    status: "proposed"
    edition: 1
    summary: "Readable canonical source and concise results."
    dependencies: []
    surface: {"role":"none","spellings":[]}
    canonical: {"lower_to":"ViewProjection","identity_fields":["source MeaningID","lens FeatureID","version"]}
    semantics: {"contract":"Readable canonical source and concise results.","fidelity":"lossless where declared"}
    exactness: {"policy":"inherited","implicit_demotion":false}
    effects: {"allowed":[]}
    worlds: {"applicability":"manifest-declared"}
    reference: {"mode":"projection","target":"std.lens.user@1"}
    artifact: {"classes":["view"]}
    projections: ["identity","surface","parse","lowering","static-semantics","reference","worlds","execution","artifact","diagnostics","documentation","tooling","conformance","migration","agent-view"]
    diagnostics: ["E-LENS-LOSS","E-LENS-ROUNDTRIP"]
    conformance: {"positive":["std.lens.user@1:positive"],"negative":["std.lens.user@1:negative"],"mutation":["std.lens.user@1:mutation"]}
    evolution: {"meaning_change":"new major or explicit migration"}
    agent: {"owner":"emath-lsp","read":["Feature Capsule","direct dependencies","conformance cases","current owner contract"],"edit":["normative capsule","owner implementation","targeted tests"],"hazards":["loss disclosure","round-trip","hidden semantics"]}
