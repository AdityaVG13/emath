emath spec ProvenanceSection:
    identity: "std.section.provenance@1"
    class: "section"
    status: "proposed"
    edition: 1
    summary: "Source and derivation lineage."
    dependencies: ["std.syntax.section.generic@1"]
    surface: {"role":"section-head","form":"provenance: suite","spellings":["provenance"]}
    canonical: {"lower_to":"ProvenanceRecord","identity_fields":["owning kind","payload","multiplicity"]}
    semantics: {"contract":"Source and derivation lineage.","owner_policy":"kind-defined"}
    exactness: {"policy":"inherited","implicit_demotion":false}
    effects: {"allowed":[]}
    worlds: {"applicability":"manifest-declared"}
    reference: {"mode":"schema-lowering","target":"ProvenanceRecord"}
    artifact: {"classes":["not-applicable"]}
    projections: ["identity","surface","parse","lowering","static-semantics","reference","worlds","execution","artifact","diagnostics","documentation","tooling","conformance","migration","agent-view"]
    diagnostics: ["E-SECTION-INVALID","E-SECTION-DUPLICATE"]
    conformance: {"positive":["std.section.provenance@1:positive"],"negative":["std.section.provenance@1:negative"],"mutation":["std.section.provenance@1:mutation"]}
    evolution: {"meaning_change":"new major or explicit migration"}
    agent: {"owner":"emath-schema","read":["Feature Capsule","direct dependencies","conformance cases","current owner contract"],"edit":["normative capsule","owner implementation","targeted tests"],"hazards":["payload schema","order/multiplicity","owner restrictions"]}
