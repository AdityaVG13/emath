/target

# standalone test-crate build artifacts (not workspace members)
tests/*/target/

# zero tool caches and disposable agent scratch workspaces
.zerostack/
.scratch-*/

# skill-loop progress + module-coupling-topology campaign books
.skill-loop*
/.module-coupling-topology/

# bv (beads viewer) local config and caches
.bv/

# bead store is local-only (issue tracking; not part of the shipped repo)
/.beads/

# internal planning docs (not for public release)
/internal/

# docs queue: untracked until curated (user review in progress)
docs/

# agent contract is local-only
AGENTS.md

# legacy planning / reference material (kept locally, not shipped)
/architecture/
/bootstrap/
/forks/
!/forks/UPSTREAM_LOCK.json
/history/
/legal/
/licenses/
/methodology/
/phases/
/internal/
/implementation/*
# gauntlet-08 gate pins: CRATE_MAP and PUBLIC_API_INVENTORY are checked
# against HEAD by scripts/validate.sh and must never be covered by an
# ignore rule (policy lane: `git check-ignore` must be false).
!/implementation/CRATE_MAP.md
!/implementation/PUBLIC_API_INVENTORY.md
# gauntlet docs pinned by scripts/check_doc_pins.py (contract-pins.json);
# they must ship with the gate, not stay local-only.
!/implementation/ERROR_CODES.md
!/implementation/CLI_REFERENCE.md
!/implementation/contract-pins.json
# python bytecode from the gate scripts
__pycache__/

# papercuts tool session log (agent scratch, not repo material)
/.papercuts.jsonl
/validation/*
!/validation/.gitkeep

# legacy root planning docs (kept locally, not shipped)
00_MASTER_INDEX.md
BUILD_STATUS.md
BUNDLE_MANIFEST.json
CHANGELOG_SEMANTIC_GENESIS.md
commands.txt
