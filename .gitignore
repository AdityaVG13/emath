/target
/web/dist/

# standalone test-crate build artifacts (not workspace members)
tests/*/target/

# zero tool caches and disposable agent scratch workspaces
.zerostack/
.scratch-*/
# ubs/ast-grep scanner caches (created under crates/ when scanning)
**/.asgrep/

# skill-loop progress + module-coupling-topology campaign books
.skill-loop*
/.module-coupling-topology/

# bv (beads viewer) local config and caches
.bv/

# bead store is local-only (issue tracking; not part of the shipped repo)
/.beads/

# internal planning docs (not for public release)
/internal/
# agent ergonomics audit (local-only, not shipped)
/agent_ergonomics_audit/

# local working docs (product notes, curated queues); the shipped spec
# lives under language/ and the public contract docs under implementation/
docs/*
!docs/MANUAL.md
!docs/WHY_NOT_LEAN.md

# agent contract is local-only
AGENTS.md

# legacy planning / reference material (kept locally, not shipped)
/architecture/
/bootstrap/
# forks/ contents are gitignored (plans, integration docs, patch
# ledgers stay local-only) except the upstream lock, which is the one
# shipped fork artifact: `emath vendor` / `emath fork status|sync`
# read it at runtime (E-TLT-007 when missing), so fresh clones need it
# present. `/forks/*` (not `/forks/`) so the re-include below works.
/forks/*
# all forks/ material except the lock:
!/forks/UPSTREAM_LOCK.json
/history/
/legal/
/licenses/
/methodology/
/phases/
/internal/
/implementation/*
# gauntlet-08 gate pins: CRATE_MAP and PUBLIC_API_INVENTORY are checked
# against HEAD by scripts/validate.sh and must never be covered by an
# ignore rule (policy lane: `git check-ignore` must be false).
!/implementation/CRATE_MAP.md
!/implementation/PUBLIC_API_INVENTORY.md
# gauntlet docs pinned by scripts/check_doc_pins.py (contract-pins.json);
# they must ship with the gate, not stay local-only.
!/implementation/ERROR_CODES.md
!/implementation/CLI_REFERENCE.md
!/implementation/contract-pins.json
# bead-closure deliverables: positioning, constitution mapping, SG-00
# freeze, research-theorem evidence, and the genesis kernel contract
# must ship with the repo.
!/implementation/VISION.md
!/implementation/CONSTITUTION.md
!/implementation/SG00_STRICT_BASELINE.md
!/implementation/RESEARCH_THEOREMS.md
!/implementation/GENESIS_KERNEL.md
# python bytecode from the gate scripts
__pycache__/

# papercuts tool session log (agent scratch, not repo material)
/.papercuts.jsonl

# keep-gate measurement store (local machine evidence, regenerated by
# `cargo bench --profile release-perf --bench comprehensive_bench`).
# Ignore the directory contents, then re-include the gauntlet-06 committed
# baseline: real-run `*.latest.json` plus `guard.json`. Other files in this
# directory stay local-only. (`/.bench-history/` would hide the directory
# from git and make the negations below inert.)
/.bench-history/*
!/.bench-history/*.latest.json
!/.bench-history/guard.json
/validation/*
!/validation/.gitkeep

# legacy root planning docs (kept locally, not shipped)
00_MASTER_INDEX.md
BUILD_STATUS.md
BUNDLE_MANIFEST.json
CHANGELOG_SEMANTIC_GENESIS.md
commands.txt
DECISION_LOG.md
env.json
HANDOFF.md
MASTER_IMPLEMENTATION_SPEC.md
MASTER_STRATEGY.md
MIGRATION_RECEIPT.json
NOTICE
PUBLISHING.md
RELEASE_NOTES.md
ROADMAP.md
SOURCE_HASHES.sha256
START_HERE.md
TASK_CLOSURE.json
TREE.txt
beads_compliance_audit/

# Beads compliance audit dir (managed by /beads-compliance-and-completion-verification skill)
/beads_compliance_audit/

# Scar-archaeology dig books (local campaign artifacts; do not commit)
.scar/
