/-
Generated by `emath export lean`; the next export overwrites it.

emath library functions and builtins as Lean definitions. Each computes
what the emath function of the same name computes wherever emath
computes it. Where emath refuses (an index outside the sequence, a zero
divisor, a negative exponent) a Lean function, being total, returns
some value instead, so a fact emath computes holds here; a statement
over every input needs its own hypotheses. Emath/Checks.lean re-checks
the library's authored examples against these definitions.
-/
namespace Emath

/-- fold.reduce `range`: lo, lo + 1, ..., lo + n - 1; empty when n <= 0. -/
def range (lo n : Int) : List Int := (List.range n.toNat).map fun (i : Nat) => lo + (i : Int)

/-- fold.reduce `tabulate`: f 0, f 1, ..., f (n - 1). -/
def tabulate {α : Type} (f : Int → α) (n : Int) : List α :=
  (List.range n.toNat).map fun (i : Nat) => f (i : Int)

/-- fold.reduce `fold`: f (... f (f acc x0) x1 ...) x(n-1). -/
def fold {α β : Type} (f : β → α → β) (acc : β) (xs : List α) : β := xs.foldl f acc

/-- fold.reduce `sum` and the builtin `int_sum`. -/
def int_sum (xs : List Int) : Int := xs.foldl (· + ·) 0
def sum (xs : List Int) : Int := int_sum xs

/-- fold.reduce `product` and the builtin `int_prod`. -/
def int_prod (xs : List Int) : Int := xs.foldl (· * ·) 1
def product (xs : List Int) : Int := int_prod xs

/-- Builtin `length`. -/
def length {α : Type} (xs : List α) : Int := xs.length

/-- `xs[i]`; emath refuses i outside 0 .. length - 1. -/
def index {α : Type} [Inhabited α] (xs : List α) (i : Int) : α := xs.getD i.toNat default

/-- Builtin `int_quot`: the Euclidean quotient (the remainder is never
negative), which is Lean's `Int` division. emath refuses b = 0. -/
def int_quot (a b : Int) : Int := a / b

/-- Builtin `int_rem`: the Euclidean remainder, in 0 .. |b| - 1. -/
def int_rem (a b : Int) : Int := a % b

/-- Builtin `int_pow` and analysis.powers `pow_int`; emath refuses b < 0. -/
def int_pow (a b : Int) : Int := a ^ b.toNat
def pow_int (a b : Int) : Int := int_pow a b

/-- analysis.powers `rat_pow`: p ^ n, inverting p first when n < 0
(0 when p = 0 and n < 0). -/
def rat_pow (p : Rat) (n : Int) : Rat :=
  if n < 0 then (if p = 0 then 0 else p⁻¹ ^ (-n).toNat) else p ^ n.toNat

/-- `p.numer` and `p.denom` of a rational in lowest terms. -/
def numer (p : Rat) : Int := p.num
def denom (p : Rat) : Int := p.den

end Emath
