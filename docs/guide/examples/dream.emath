# Search n * (n + shift) / 2 for a formula matching triangular numbers.
# Matching these samples is evidence, not a proof for every n.
use fold.reduce

emath object FormulaState:
    representation:
        batch: Int
        verdict: Int
        used: Int
        next: Int
        program: Code

emath object KeptFormula:
    representation:
        name: Code
        program: Code

emath function SeedFormula:
    inputs:
        unused: Int
    outputs:
        result: FormulaState
    definitions:
        result = FormulaState: {batch: 0, verdict: 0, used: 0, next: 0, program: quote(recur f in Int -> Rat: function n in Int: n * n / 2)}

emath function StepFormula:
    # Try one shift per batch, stopping on a match or after shifts 0..3.
    inputs:
        state: FormulaState
        budget: Int
    outputs:
        result: FormulaState
    definitions:
        template = quote(recur f in Int -> Rat: function n in Int: n * (n + shift) / 2)
        program = quote.substitute(template, shift, state.next)
        candidate = quote.evaluate(program)
        train = [0 / 1, 1 / 1, 3 / 1, 6 / 1]
        held = [10 / 1, 15 / 1]
        matches = all(function i in Int: candidate(i) == train[i], range(0, 4)) and all(function i in Int: candidate(i + 4) == held[i], range(0, 2))
        verdict = if matches: 1 else: if state.next >= 3: 2 else: 0
        result = if state.used >= budget: FormulaState: {batch: state.batch + 1, verdict: 4, used: state.used, next: state.next, program: state.program} else: FormulaState: {batch: state.batch + 1, verdict: verdict, used: state.used + 1, next: state.next + 1, program: program}
    tests:
        example <first_candidate_rejected>:
            given state = SeedFormula(0)
            given budget = 4
            expect result.verdict == 0
            expect result.next == 1
        example <second_candidate_matches>:
            given state = StepFormula(SeedFormula(0), 4)
            given budget = 4
            expect result.verdict == 1
            expect result.batch == 2
            expect quote.evaluate(result.program)(10) == 55 / 1
        example <no_budget_no_candidate>:
            given state = SeedFormula(0)
            given budget = 0
            expect result.verdict == 4
            expect result.used == 0

emath function dream_keep:
    # The driver writes this closed program into world/kept.emath.
    inputs:
        state: FormulaState
    outputs:
        result: sequence(KeptFormula)
    definitions:
        result = if state.verdict == 1: [KeptFormula: {name: quote(triangular), program: state.program}] else: []
